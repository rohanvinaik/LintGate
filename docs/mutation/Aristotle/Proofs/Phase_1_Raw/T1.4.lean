/-
The union of two test suites kills exactly the union of their killed sets.
-/
variable {D R : Type}

structure Program (D R : Type) where
  run : D → R

abbrev Test (D R : Type) := D

def passes (P : Program D R) (t : Test D R) : R := P.run t

abbrev TestSuite (D R : Type) := Set (Test D R)

structure MutationSystem (D R : Type) where
  mutants : Program D R → Set (Program D R)

def killedSet (MS : MutationSystem D R) (P : Program D R) (T : TestSuite D R) : Set (Program D R) :=
  { m | m ∈ MS.mutants P ∧ ∃ t ∈ T, passes P t ≠ passes m t }

theorem T1_4_killedSet_union
    (MS : MutationSystem D R) (P : Program D R)
    (T₁ T₂ : TestSuite D R)
    [∀ (p : Program D R) (t : Test D R), Decidable (passes P t ≠ passes p t)] :
    killedSet MS P (T₁ ∪ T₂) = killedSet MS P T₁ ∪ killedSet MS P T₂ := by
  -- By definition of union, a mutant m is in the union of the killed sets if and only if it is in at least one of the individual killed sets.
  ext m
  simp [killedSet];
  grind +ring