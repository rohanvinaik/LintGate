theorem specification_free_energy_bound
  {Mutant : Type}
  (s_current s_next : Finset Mutant)
  (tests_remaining : ℕ)
  (killed κ : ℕ)
  (h_κ_gt_1 : 1 < κ)
  (h_before_nonempty : s_current.Nonempty)
  (h_after_nonempty : s_next.Nonempty)
  (h_tests_pos : 0 < tests_remaining)
  (h_card_eq : s_next.card = s_current.card - killed)
  (h_greedy : (killed : ℝ) ≥ (s_current.card : ℝ) / (κ : ℝ)) :
  specification_free_energy s_next (tests_remaining - 1) κ ≤ specification_free_energy s_current tests_remaining κ - Real.logb 2 ((κ : ℝ) / ((κ : ℝ) - 1)) := by
    -- By definition of $information\_content$, we know that $information\_content s\_current.card s\_next.card \geq \log_2(\kappa / (\kappa - 1))$.
    have h_INFORMATION_CONTENT : information_content s_current.card s_next.card ≥ Real.logb 2 (κ / (κ - 1)) := by
      convert greedy_information_gain_lower_bound_final s_current s_next killed κ h_κ_gt_1 h_before_nonempty h_after_nonempty h_card_eq h_greedy using 1;
    unfold specification_free_energy;
    unfold information_content at *;
    rw [ Real.logb_div ] at h_INFORMATION_CONTENT <;> norm_num at *;
    · rw [ Nat.cast_sub ] <;> push_cast <;> linarith;
    · aesop;
    · aesop

