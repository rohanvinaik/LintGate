def Harmonic_P5 (n : ℕ) : ℚ := harmonic n

/-
Define a Set Cover instance as a list of subsets of a finite universe that covers the universe.
-/
structure SetCoverInstance (α : Type) [Fintype α] [DecidableEq α] where
  S : List (Finset α)
  covers : (⋃ s ∈ S, (s : Set α)) = Set.univ

/-
Define the greedy choice function which selects the set from the instance that covers the maximum number of currently uncovered elements.
-/
def greedy_choice {α : Type} [Fintype α] [DecidableEq α] (I : SetCoverInstance α) (uncovered : Finset α) : Finset α :=
  let candidates := I.S.filter (λ s => (s ∩ uncovered).card > 0)
  if h : candidates = [] then ∅
  else
    let best := candidates.argmax (λ s => (s ∩ uncovered).card)
    best.getD ∅

/-
Define the greedy cover algorithm which repeatedly applies the greedy choice until all elements are covered.
-/
def greedy_cover {α : Type} [Fintype α] [DecidableEq α] (I : SetCoverInstance α) : List (Finset α) :=
  let rec loop (uncovered : Finset α) (acc : List (Finset α)) : List (Finset α) :=
    if h : uncovered.card = 0 then acc
    else
      let choice := greedy_choice I uncovered
      if choice = ∅ then acc
      else loop (uncovered \ choice) (choice :: acc)
    termination_by uncovered.card
    decreasing_by all_goals
    -- Since the greedy choice is not empty, there must be at least one element in it. Therefore, removing that element will reduce the number of elements in the uncovered set.
    have h_nonempty : ∃ x ∈ uncovered, x ∈ greedy_choice I uncovered := by
      have h_inter : (greedy_choice I uncovered ∩ uncovered).card > 0 := by
        unfold greedy_choice;
        cases h : List.argmax ( fun s => ( s ∩ uncovered ).card ) ( List.filter ( fun s => Decidable.decide ( 0 < ( s ∩ uncovered ).card ) ) I.S ) <;> simp_all +decide;
        · simp +zetaDelta at *;
          unfold greedy_choice at *; simp_all +decide [ Finset.ext_iff ] ;
        · have := List.argmax_mem h; aesop;
      exact Exists.elim ( Finset.card_pos.mp h_inter ) fun x hx => ⟨ x, Finset.mem_of_mem_inter_right hx, Finset.mem_of_mem_inter_left hx ⟩;
    refine' Finset.card_lt_card _;
    simp_all +decide [ Finset.ssubset_def, Finset.subset_iff ]
  loop Finset.univ []

/-
Define the size of the optimal set cover.
-/
