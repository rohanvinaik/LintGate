        have := List.argmax_mem h; aesop;);
      · aesop ( simp_config := { singlePass := true } ) ;
    have h_step : ((s ∩ new_covered).card : ℚ) / k ≤ Harmonic_P5 ((s ∩ uncovered).card) - Harmonic_P5 ((s ∩ uncovered).card - (s ∩ new_covered).card) := by
      have h_step : k ≥ (s ∩ uncovered).card := by
        have := greedy_choice_ge_any I uncovered s hs; aesop;
      by_cases h_card_pos : (s ∩ new_covered).card > 0 <;> simp_all +decide [ div_eq_mul_inv ];
      have := step_cost_le_harmonic_diff ( show ( ( greedy_choice I uncovered ∩ uncovered ).card : ℕ ) ≥ ( s ∩ uncovered ).card from h_step ) ( show ( s ∩ ( greedy_choice I uncovered ∩ uncovered ) ).card ≤ ( s ∩ uncovered ).card from Finset.card_mono <| by aesop_cat ) ( show ( s ∩ ( greedy_choice I uncovered ∩ uncovered ) ).card > 0 from Finset.card_pos.mpr h_card_pos ) ; aesop;
    linarith [h_induction, h_step]

/-
The sum of greedy costs for elements in a subset `s` is bounded by the harmonic number of the size of `s`.
-/
lemma sum_greedy_costs_loop_le_harmonic_v2 {α : Type} [Fintype α] [DecidableEq α] (I : SetCoverInstance α)
  (s : Finset α) (hs : s ∈ I.S) (uncovered : Finset α) (costs : α → ℚ)
  (h_costs_zero : ∀ x ∈ uncovered, costs x = 0) :
  ∑ x ∈ s ∩ uncovered, greedy_costs.loop I uncovered costs x ≤ Harmonic_P5 (s ∩ uncovered).card := by
  convert sum_greedy_costs_loop_le_harmonic I s hs uncovered costs h_costs_zero using 1

/-
The sum of greedy costs for elements in a subset `s` is bounded by the harmonic number of the size of `s`.
-/
lemma sum_greedy_costs_loop_le_harmonic_v3 {α : Type} [Fintype α] [DecidableEq α] (I : SetCoverInstance α)
  (s : Finset α) (hs : s ∈ I.S) (uncovered : Finset α) (costs : α → ℚ)
  (h_costs_zero : ∀ x ∈ uncovered, costs x = 0) :
  ∑ x ∈ s ∩ uncovered, greedy_costs.loop I uncovered costs x ≤ Harmonic_P5 (s ∩ uncovered).card := by
  apply sum_greedy_costs_loop_le_harmonic_v2 I s hs uncovered costs h_costs_zero

/-
The inductive step for bounding the sum of greedy costs.
-/
lemma sum_greedy_costs_inductive_step {α : Type} [Fintype α] [DecidableEq α] (I : SetCoverInstance α)
  (s : Finset α) (hs : s ∈ I.S) (uncovered : Finset α) (costs : α → ℚ)
  (h_uncovered_nonempty : uncovered.card > 0)
  (choice : Finset α) (h_choice : choice = greedy_choice I uncovered)
  (h_choice_nonempty : choice ≠ ∅)
  (new_covered : Finset α) (h_new_covered : new_covered = choice ∩ uncovered)
  (k : ℕ) (h_k : k = new_covered.card)
  (new_costs : α → ℚ) (h_new_costs : new_costs = λ x => if x ∈ new_covered then (1 : ℚ) / k else costs x)
  (remaining : Finset α) (h_remaining : remaining = uncovered \ choice)
  (h_ih : ∑ x ∈ s ∩ remaining, greedy_costs.loop I remaining new_costs x ≤ Harmonic_P5 (s ∩ remaining).card) :
  ∑ x ∈ s ∩ uncovered, greedy_costs.loop I uncovered costs x ≤ Harmonic_P5 (s ∩ uncovered).card := by
  by_contra h_contra;
  -- Apply the recurrence relation to split the sum into the cost of the new covered elements and the sum of the remaining elements.
  have h_recurrence : ∑ x ∈ s ∩ uncovered, greedy_costs.loop I uncovered costs x = ((s ∩ new_covered).card : ℚ) / k + ∑ x ∈ s ∩ remaining, greedy_costs.loop I remaining new_costs x := by
    convert greedy_costs_recurrence I s uncovered costs h_uncovered_nonempty choice h_choice h_choice_nonempty using 1;
    aesop;
  -- Apply the inequality `step_cost_le_harmonic_diff` to bound the cost of the new covered elements.
  have h_step_cost : ((s ∩ new_covered).card : ℚ) / k ≤ Harmonic_P5 (s ∩ uncovered).card - Harmonic_P5 (s ∩ remaining).card := by
    convert step_cost_le_harmonic_diff _ _ _ using 1;
    congr! 1;
    · rw [ show s ∩ remaining = ( s ∩ uncovered ) \ ( s ∩ new_covered ) from ?_, Finset.card_sdiff ];
      · rw [ show s ∩ new_covered ∩ ( s ∩ uncovered ) = s ∩ new_covered from ?_ ];
        grind;
      · grind;
    · have := greedy_choice_ge_any I uncovered s hs; aesop;
    · exact Finset.card_mono fun x hx => by aesop;
    · contrapose! h_contra; simp_all +decide [ Finset.ext_iff ] ;
      convert h_ih using 1;
      · rw [ Finset.card_eq_zero.mpr ] <;> aesop;
      · congr! 2;
        grind;
  grind

/-
The sum of greedy costs for elements in a subset `s` is bounded by the harmonic number of the size of `s`.
-/
lemma sum_greedy_costs_loop_le_harmonic_main {α : Type} [Fintype α] [DecidableEq α] (I : SetCoverInstance α)
  (s : Finset α) (hs : s ∈ I.S) (uncovered : Finset α) (costs : α → ℚ)
  (h_costs_zero : ∀ x ∈ uncovered, costs x = 0) :
  ∑ x ∈ s ∩ uncovered, greedy_costs.loop I uncovered costs x ≤ Harmonic_P5 (s ∩ uncovered).card := by
    convert sum_greedy_costs_loop_le_harmonic I s hs uncovered costs h_costs_zero using 1

/-
The sum of greedy costs for elements in a subset `s` is bounded by the harmonic number of the size of `s`.
-/
lemma sum_greedy_costs_subset_le_harmonic {α : Type} [Fintype α] [DecidableEq α] (I : SetCoverInstance α) (s : Finset α) (hs : s ∈ I.S) :
  ∑ x ∈ s, greedy_costs I x ≤ Harmonic_P5 s.card := by
    convert sum_greedy_costs_loop_le_harmonic_main I s hs Finset.univ ( fun _ => 0 ) ( fun _ _ => rfl ) using 1;
    · unfold greedy_costs; aesop;
    · rw [ Finset.inter_univ ]

/-
The greedy costs are non-negative.
-/
lemma greedy_costs_nonneg {α : Type} [Fintype α] [DecidableEq α] (I : SetCoverInstance α) (x : α) :
  greedy_costs I x ≥ 0 := by
  have h_nonneg : ∀ (uncovered : Finset α) (costs : α → ℚ), (∀ x, costs x ≥ 0) → ∀ x, greedy_costs.loop I uncovered costs x ≥ 0 := by
    intros uncovered costs h_nonneg x
    induction' uncovered using Finset.strongInduction with uncovered ih generalizing costs x
    generalize_proofs at *; (
    unfold greedy_costs.loop;
    split_ifs <;> simp_all +decide [ Finset.subset_iff ];
    split_ifs <;> [ exact h_nonneg x; exact ih _ ( by
      simp_all +decide [ Finset.ssubset_def, Finset.subset_iff ];
      unfold greedy_choice; simp_all +decide [ Finset.ext_iff ] ;
      split_ifs <;> simp_all +decide [ Finset.Nonempty ];
      · unfold greedy_choice at *; simp_all +decide [ Finset.Nonempty ] ;
        grind;
      · unfold greedy_choice at *; simp_all +decide [ Finset.ext_iff ] ;
        cases h : List.argmax ( fun s => ( s ∩ uncovered ).card ) ( List.filter ( fun s => Decidable.decide ( ∃ x ∈ s, x ∈ uncovered ) ) I.S ) <;> simp_all +decide [ Finset.Nonempty ] ;
        have := List.argmax_mem h; aesop; ) _ ( by
      intro x; split_ifs <;> simp_all +decide [ Finset.subset_iff ] ; ) x ]);
  exact h_nonneg _ _ ( fun _ => by norm_num ) _

/-
The sum of greedy costs for elements in a subset `s` is bounded by the harmonic number of the size of `s`.
-/
lemma sum_greedy_costs_loop_le_harmonic_final {α : Type} [Fintype α] [DecidableEq α] (I : SetCoverInstance α)
  (s : Finset α) (hs : s ∈ I.S) (uncovered : Finset α) (costs : α → ℚ)
  (h_costs_zero : ∀ x ∈ uncovered, costs x = 0) :
  ∑ x ∈ s ∩ uncovered, greedy_costs.loop I uncovered costs x ≤ Harmonic_P5 (s ∩ uncovered).card := by
  convert sum_greedy_costs_loop_le_harmonic_main I s hs uncovered costs h_costs_zero using 1

/-
Harmonic numbers are monotone increasing.
-/
lemma Harmonic_P5_mono {n m : ℕ} (h : n ≤ m) : Harmonic_P5 n ≤ Harmonic_P5 m := by
  unfold Harmonic_P5;
  induction h <;> simp +decide [ *, harmonic ];
  exact Finset.sum_le_sum_of_subset_of_nonneg ( Finset.range_mono ( Nat.le_succ_of_le ‹_› ) ) fun _ _ _ => by positivity;

/-
The greedy set cover algorithm achieves an approximation ratio of H(n).
-/
theorem greedy_approximation_ratio {α : Type} [Fintype α] [DecidableEq α] (I : SetCoverInstance α) :
  ((greedy_cover I).length : ℝ) ≤ (opt_cover_size I : ℝ) * (Harmonic_P5 (Finset.univ : Finset α).card : ℝ) := by
  obtain ⟨ C, hC₁, hC₂, hC₃ ⟩ := exists_opt_cover I;
  have h_sum_le : ∑ x, greedy_costs I x ≤ ∑ s ∈ C, ∑ x ∈ s, greedy_costs I x := by
    have h_sum_le : ∀ x : α, ∃ s ∈ C, x ∈ s := by
      exact fun x => by simpa using Set.ext_iff.mp hC₂ x;
    have h_sum_le : ∑ x, greedy_costs I x ≤ ∑ x, ∑ s ∈ C, (if x ∈ s then greedy_costs I x else 0) := by
      exact Finset.sum_le_sum fun x _ => by obtain ⟨ s, hs₁, hs₂ ⟩ := h_sum_le x; exact le_trans ( by aesop ) ( Finset.single_le_sum ( fun s _ => by split_ifs <;> linarith [ greedy_costs_nonneg I x ] ) hs₁ ) ;
    rw [ Finset.sum_comm ] at h_sum_le;
    simp_all +decide [ Finset.sum_ite ];
  have h_sum_le : ∑ s ∈ C, ∑ x ∈ s, greedy_costs I x ≤ ∑ s ∈ C, Harmonic_P5 s.card := by
    exact Finset.sum_le_sum fun s hs => sum_greedy_costs_subset_le_harmonic I s ( by simpa using hC₁ hs );
  have h_sum_le : ∑ s ∈ C, Harmonic_P5 s.card ≤ ∑ s ∈ C, Harmonic_P5 (Finset.univ : Finset α).card := by
    exact Finset.sum_le_sum fun s hs => Harmonic_P5_mono <| Finset.card_le_univ _;
  have h_sum_le : ∑ x, greedy_costs I x = (greedy_cover I).length := by
    convert sum_greedy_costs_eq_length I using 1;
  norm_cast at *;
  simp_all +decide [ Finset.sum_const, nsmul_eq_mul ];
  linarith

/-
Check if the bound for harmonic numbers by log n + 1 is available.
-/
#check harmonic_le_one_add_log

/-
The greedy set cover algorithm achieves an approximation ratio of ln n + 1.
-/
theorem greedy_approximation_ratio_log {α : Type} [Fintype α] [DecidableEq α] (I : SetCoverInstance α) :
  ((greedy_cover I).length : ℝ) ≤ (opt_cover_size I : ℝ) * (Real.log (Finset.univ : Finset α).card + 1) := by
    convert greedy_approximation_ratio I |> le_trans <| mul_le_mul_of_nonneg_left _ <| Nat.cast_nonneg _ using 1;
    have h_harmonic : ∀ n : ℕ, Harmonic_P5 n ≤ Real.log n + 1 := by
      intro n;
      convert harmonic_le_one_add_log n using 1;
      ring;
    exact h_harmonic _