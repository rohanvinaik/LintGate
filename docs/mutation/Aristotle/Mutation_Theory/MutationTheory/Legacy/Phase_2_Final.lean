/-
We define `trueEquiv` relative to an evaluation function `eval`. Then we define `T2_10_equiv_decidable_finite_domain` which constructs a `Decidable` instance for `trueEquiv` when the domain is finite and the range has decidable equality. This unifies the structural definition of `Program` with its semantic evaluation.
-/
def trueEquiv {D R : Type} (eval : Program D R → D → R) (P m : Program D R) : Prop :=
  ∀ x, eval P x = eval m x

def T2_10_equiv_decidable_finite_domain
    {D R : Type} [DecidableEq R] [Fintype D]
    (eval : Program D R → D → R) (P m : Program D R) :
    Decidable (trueEquiv eval P m) := by
  unfold trueEquiv
  exact Fintype.decidableForallFintype
