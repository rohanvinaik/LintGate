    · exact (hNo n (by simpa [c] using hn) (by simpa [S] using heq.symm)).elim
  have hBound : ∀ n ≤ c, (S n).ncard ≤ c - n := by
    intro n hn
    induction' n with n ih
    · simp [S, c, iterSynth]
    · have hn' : n ≤ c := Nat.le_of_succ_le hn
      have hlt : (S (n + 1)).ncard < (S n).ncard := Set.ncard_lt_ncard (hStrict n hn') (hSfinite n)
