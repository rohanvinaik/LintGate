    simpa [c] using hBound c (le_rfl : c ≤ c)
  have hZero : (S c).ncard = 0 := Nat.le_zero.mp hZeroLe
  have hlt0 : (S (c + 1)).ncard < (S c).ncard := Set.ncard_lt_ncard (hStrict c (le_rfl : c ≤ c)) (hSfinite c)
  rw [hZero] at hlt0
  exact (Nat.not_lt_zero _ hlt0)

/-
We prove the Union Detection Formula (T2.4), which states that if we have n independent detectors with probabilities p_i, the combined probability is 1 - product(1 - p_i). We show this is between 0 and 1 given that each p_i is between 0 and 1.
-/
theorem T2_4_union_detection_formula
    (n : ℕ) (p : Fin n → ℚ)
    (h_bounds : ∀ i, 0 ≤ p i ∧ p i ≤ 1) :
    let combined := 1 - Finset.univ.prod (fun i => 1 - p i)
    0 ≤ combined ∧ combined ≤ 1 := by
      exact ⟨ sub_nonneg.2 <| Finset.prod_le_one ( fun _ _ => sub_nonneg.2 <| h_bounds _ |>.2 ) fun _ _ => sub_le_self _ <| h_bounds _ |>.1, sub_le_self _ <| Finset.prod_nonneg fun _ _ => sub_nonneg.2 <| h_bounds _ |>.2 ⟩

/-
We prove T2.5 (adding a signal improves detection) and T2.6 (Monty Hall Recall Guarantee). T2.5 shows that multiplying by (1 - p_new) where p_new > 0 strictly decreases the failure probability. T2.6 bounds the sum of miss probabilities by k * ε.
-/
theorem T2_5_more_signals_better
    (n : ℕ) (p : Fin n → ℚ) (p_new : ℚ)
    (h_bounds : ∀ i, 0 ≤ p i ∧ p i < 1)
    (h_new_pos : 0 < p_new)
  (_h_new_le : p_new ≤ 1) :
    Finset.univ.prod (fun i => 1 - p i) * (1 - p_new) <
    Finset.univ.prod (fun i => 1 - p i) := by
  exact mul_lt_of_lt_one_right ( Finset.prod_pos fun i _ => sub_pos.mpr ( h_bounds i |>.2 ) ) ( sub_lt_self _ h_new_pos )

theorem T2_6_monty_hall_recall
    (k : ℕ) (ε : ℚ)
  (_h_ε_pos : 0 < ε) (_h_ε_le : ε ≤ 1)
    (miss_prob : Fin k → ℚ)
    (h_calibrated : ∀ i, miss_prob i ≤ ε) :
    Finset.univ.sum miss_prob ≤ k * ε := by
  simpa using Finset.sum_le_sum fun i ( hi : i ∈ Finset.univ ) => h_calibrated i

/-
We define `OracleLevel` as an enum with a linear order. Then we prove `T2_7`, which states that the minimum of two levels is less than or equal to each level. This is a direct consequence of the definition of `min`.
-/
inductive OracleLevel
  | CRASH
  | TYPE
  | STRUCTURAL
  | SHAPE
  | VALUE
  | PROPERTY
  deriving DecidableEq, Repr, Ord

instance : LinearOrder OracleLevel :=
  LinearOrder.lift'
    (fun l => match l with
      | .CRASH => 0
      | .TYPE => 1
      | .STRUCTURAL => 2
      | .SHAPE => 3
      | .VALUE => 4
      | .PROPERTY => 5)
    (by
      intros x y h
      cases x <;> cases y <;> simp_all
    )

theorem T2_7_composition_strength_bound
    (level_g level_h : OracleLevel) :
    min level_g level_h ≤ level_g ∧ min level_g level_h ≤ level_h := by
  apply And.intro (min_le_left level_g level_h) (min_le_right level_g level_h)

/-
We define a typeclass `GreedySetCoverTheory` to encapsulate the properties of the Set Cover problem and the greedy algorithm. We then state the classical bound: the greedy algorithm achieves an approximation ratio of H(n) ≤ ln(n) + 1.
-/
class GreedySetCoverTheory where
  ValidInstance : ℕ → ℕ → ℕ → Prop
  bound : ∀ (n opt greedy : ℕ), ValidInstance n opt greedy → 0 < opt → (greedy : ℝ) ≤ (opt : ℝ) * (Real.log n + 1)

theorem greedy_set_cover_bound [T : GreedySetCoverTheory] (n opt greedy : ℕ)
    (h_inst : T.ValidInstance n opt greedy)
    (h_opt : 0 < opt) :
    (greedy : ℝ) ≤ (opt : ℝ) * (Real.log n + 1) := by
  apply T.bound n opt greedy h_inst h_opt

