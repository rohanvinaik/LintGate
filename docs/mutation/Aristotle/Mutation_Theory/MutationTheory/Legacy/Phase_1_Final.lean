/-
This module unifies and formalizes 14 theorems related to mutation testing, specification completeness, and oracle levels.
It defines core concepts such as `Program`, `Test`, `TestSuite`, `MutationSystem`, `killedSet`, `mutationScore`, `SpecificationLevel`, `OracleLevel`, and `OptimizationType`.
It proves theorems regarding the relationships between these concepts, including:
- T1.1: Complementarity of killed and survivor mutants.
- T1.2: Equivalence relation properties of test equivalence.
- T1.3: Reflexivity and transitivity of refinement.
- T1.4: Additivity of killed sets under test suite union.
- T1.5: Monotonicity of mutation score.
- T1.6: Monotonicity of specification level classification.
- T1.7: Additivity of survival for disjoint categories.
- T1.8: True equivalence implies test equivalence.
- T1.9: Non-equivalence implies distinguishability by a test.
- T1.10: Verified gate status implies low survival rate.
- T1.11: Conservatism of the cross-channel gate.
- T1.12: Antitone property of the gate with respect to survival rate.
- T1.13: Total ordering of oracle levels.
- T1.14: Monotonicity of optimization safety with respect to oracle levels.
-/

import Mathlib

set_option linter.mathlibStandardSet false

open scoped BigOperators
open scoped Real
open scoped Nat
open scoped Classical
open scoped Pointwise

set_option synthInstance.maxHeartbeats 20000
set_option synthInstance.maxSize 128

set_option relaxedAutoImplicit false
set_option autoImplicit false

noncomputable section

/-
Unified definitions for Program, Test, and TestSuite using IDs to allow DecidableEq. Semantics and Oracles are parameterized. Theorem 1.1 proved.
-/
/-- Programs are abstract IDs interpreted by an external semantics function. -/
structure Program (D R : Type) where
  id : Nat
deriving DecidableEq

structure Test (D R : Type) where
  id : Nat
  input : D
deriving DecidableEq

abbrev TestSuite (D R : Type) := Finset (Test D R)

variable {D R : Type}
variable (sem : Program D R → D → R)
variable (oracle : Test D R → R → Bool)

def passes (P : Program D R) (t : Test D R) : Bool :=
  oracle t (sem P t.input)

def isSurvivor (P : Program D R) (T : TestSuite D R) (m : Program D R) : Prop :=
  ∀ t ∈ T, passes sem oracle P t = passes sem oracle m t

def isKilled (P : Program D R) (T : TestSuite D R) (m : Program D R) : Prop :=
  ∃ t ∈ T, passes sem oracle P t ≠ passes sem oracle m t

theorem T1_1_killed_surv_complement
    (P : Program D R) (T : TestSuite D R) (m : Program D R) :
    isKilled sem oracle P T m ↔ ¬ isSurvivor sem oracle P T m := by
  unfold isKilled isSurvivor
  push_neg
  rfl

/-
Definition of testEquiv and proofs that it is reflexive, symmetric, and transitive (Theorems 1.2a, 1.2b, 1.2c).
-/
def testEquiv (T : TestSuite D R) (P₁ P₂ : Program D R) : Prop :=
  ∀ t ∈ T, passes sem oracle P₁ t = passes sem oracle P₂ t

theorem T1_2a_testEquiv_refl (T : TestSuite D R) (P : Program D R) :
    testEquiv sem oracle T P P := by
  intros t ht
  rfl

theorem T1_2b_testEquiv_symm (T : TestSuite D R) (P₁ P₂ : Program D R) :
    testEquiv sem oracle T P₁ P₂ → testEquiv sem oracle T P₂ P₁ := by
  intros h t ht
  symm
  exact h t ht

theorem T1_2c_testEquiv_trans (T : TestSuite D R) (P₁ P₂ P₃ : Program D R) :
    testEquiv sem oracle T P₁ P₂ → testEquiv sem oracle T P₂ P₃ → testEquiv sem oracle T P₁ P₃ := by
  intros h1 h2 t ht
  rw [h1 t ht, h2 t ht]

/-
Definition of MutationSystem, killedSet, and refines. Proofs that refines is reflexive and transitive (Theorems 1.3a, 1.3b).
-/
structure MutationSystem (D R : Type) where
  mutants : Program D R → Finset (Program D R)

def killedSet (MS : MutationSystem D R) (P : Program D R) (T : TestSuite D R) : Finset (Program D R) :=
  (MS.mutants P).filter (fun m => ∃ t ∈ T, passes sem oracle P t ≠ passes sem oracle m t)

def refines (MS : MutationSystem D R) (P : Program D R) (T₁ T₂ : TestSuite D R) : Prop :=
  killedSet sem oracle MS P T₁ ⊆ killedSet sem oracle MS P T₂

theorem T1_3a_refines_refl (MS : MutationSystem D R) (P : Program D R) (T : TestSuite D R) :
    refines sem oracle MS P T T := by
  intro m hm
  exact hm

theorem T1_3b_refines_trans (MS : MutationSystem D R) (P : Program D R) (T₁ T₂ T₃ : TestSuite D R) :
    refines sem oracle MS P T₁ T₂ → refines sem oracle MS P T₂ T₃ → refines sem oracle MS P T₁ T₃ := by
  intros h1 h2 m hm
  exact h2 (h1 hm)

/-
Theorem 1.4: The set of mutants killed by the union of two test suites is the union of the sets of mutants killed by each test suite individually.
-/
theorem T1_4_killedSet_union
    (MS : MutationSystem D R) (P : Program D R)
    (T₁ T₂ : TestSuite D R) :
    killedSet sem oracle MS P (T₁ ∪ T₂) = killedSet sem oracle MS P T₁ ∪ killedSet sem oracle MS P T₂ := by
      -- By definition of killedSet, we need to show that the sets of mutants killed by T₁ ∪ T₂ and by T₁ and T₂ individually are equal.
      ext m
      simp [killedSet];
      grind +ring

/-
Definition of mutationScore and proof of monotonicity (Theorem 1.5).
-/
def mutationScore (killed total : ℕ) : ℚ := (killed : ℚ) / (total : ℚ)

theorem T1_5_SC_monotone
    (killed₁ killed₂ total : ℕ)
    (h_le : killed₁ ≤ killed₂)
    (h_bound₁ : killed₁ ≤ total)
    (h_bound₂ : killed₂ ≤ total)
    (h_pos : 0 < total) :
    mutationScore killed₁ total ≤ mutationScore killed₂ total := by
      unfold mutationScore; gcongr;

/-
Definition of SpecificationLevel, classifyLevel, and proof of monotonicity (Theorem 1.6).
-/
inductive SpecificationLevel
  | L0 -- UNSPECIFIED
  | L1 -- WEAKLY_SPECIFIED
  | L2 -- PARTIALLY_SPECIFIED
  | L3 -- MODERATELY_SPECIFIED
  | L4 -- SPECIFIED
  deriving Repr, DecidableEq

def SpecificationLevel.toNat : SpecificationLevel → Nat
  | L0 => 0
  | L1 => 1
  | L2 => 2
  | L3 => 3
  | L4 => 4

theorem SpecificationLevel.toNat_inj : Function.Injective SpecificationLevel.toNat := by
  -- We can prove injectivity by cases on the constructors of `SpecificationLevel`.
  intro l1 l2 h
  cases l1 <;> cases l2 <;> cases h <;> trivial

instance : LinearOrder SpecificationLevel :=
  LinearOrder.lift' SpecificationLevel.toNat SpecificationLevel.toNat_inj

def classifyLevel (sc : ℚ) : SpecificationLevel :=
  if sc < 0.1 then SpecificationLevel.L0
  else if sc < 0.3 then SpecificationLevel.L1
  else if sc < 0.5 then SpecificationLevel.L2
  else if sc < 0.8 then SpecificationLevel.L3
  else SpecificationLevel.L4

theorem T1_6_classifyLevel_monotone
    (sc₁ sc₂ : ℚ)
    (h_le : sc₁ ≤ sc₂) :
    classifyLevel sc₁ ≤ classifyLevel sc₂ := by
      unfold classifyLevel;
      norm_num [ SpecificationLevel ] at * ; split_ifs <;> norm_cast at * <;> linarith

/-
Theorem 1.7: Category Survival is Additive. The cardinality of a disjoint union of finsets is the sum of their cardinalities.
-/
theorem T1_7_additive_survival
    {α : Type} [DecidableEq α] {k : ℕ}
    (parts : Fin k → Finset α)
    (whole : Finset α)
    (h_union : whole = Finset.univ.biUnion parts)
    (h_disjoint : ∀ i j, i ≠ j → Disjoint (parts i) (parts j)) :
    whole.card = Finset.univ.sum (fun i => (parts i).card) := by
  rw [h_union]
  rw [Finset.card_biUnion]
  intro i _ j _ hij
  exact h_disjoint i j hij

/-
Definition of trueEquiv and proof of Theorem 1.8: True Equivalence Implies Test Equivalence. If two programs have the same semantics on all inputs, they are test equivalent on any test suite.
-/
def trueEquiv (P₁ P₂ : Program D R) : Prop :=
  ∀ x : D, sem P₁ x = sem P₂ x

theorem T1_8_true_implies_test_equiv
    (T : TestSuite D R) (P₁ P₂ : Program D R) :
    trueEquiv sem P₁ P₂ → testEquiv sem oracle T P₁ P₂ := by
  intros h t ht
  unfold passes
  rw [h t.input]

/-
Theorem 1.9: If two programs are not truly equivalent, there exists a test case (input and oracle) that distinguishes them.
-/
theorem T1_9_nonequiv_is_distinguishable
    (P₁ P₂ : Program D R)
    (h_neq : ¬ trueEquiv sem P₁ P₂) :
    ∃ (t : Test D R) (oracle : Test D R → R → Bool), passes sem oracle P₁ t ≠ passes sem oracle P₂ t := by
  unfold trueEquiv at h_neq
  push_neg at h_neq
  obtain ⟨x, hx⟩ := h_neq
  let t : Test D R := { id := 0, input := x }
  let oracle : Test D R → R → Bool := fun _ r => r = sem P₁ x
  use t, oracle
  unfold passes
  simp only [beq_iff_eq, beq_eq_false_iff_ne, ne_eq]
  -- We need to show (sem P₁ x = sem P₁ x) ≠ (sem P₂ x = sem P₁ x)
  -- LHS is true. RHS is false because sem P₂ x ≠ sem P₁ x.
  have h1 : oracle t (sem P₁ t.input) = true := by
    simp [oracle, t]
  have h2 : oracle t (sem P₂ t.input) = false := by
    simp [oracle, t]
    intro h
    apply hx
    rw [h]
  rw [h1, h2]
  decide

/-
Definition of AlgebraResult, MutationState, GateStatus, GatedResult, and crossChannelGate. Proof of Theorem 1.11: The gate is conservative, meaning the gated confidence is less than or equal to the original confidence.
-/
structure AlgebraResult where
  property : String
  confidence : Real

structure MutationState where
  survival : Real
  depth : Nat

inductive GateStatus
  | VERIFIED
  | PENALIZED
  | GATED
  deriving DecidableEq, Repr

structure GatedResult where
  property : String
  confidence : Real
  status : GateStatus

def crossChannelGate (α : AlgebraResult) (μ : MutationState) : GatedResult :=
  if μ.survival < 0.30 then
    { property := α.property, confidence := min α.confidence 0.90, status := GateStatus.VERIFIED }
  else if μ.survival < 0.60 then
    { property := α.property, confidence := α.confidence * 0.50, status := GateStatus.PENALIZED }
  else
    { property := α.property, confidence := α.confidence * 0.10, status := GateStatus.GATED }

theorem T1_11_gate_conservative
    (α : AlgebraResult) (μ : MutationState)
    (h_conf : 0 ≤ α.confidence ∧ α.confidence ≤ 1) :
    (crossChannelGate α μ).confidence ≤ α.confidence := by
  unfold crossChannelGate
  split_ifs
  · exact min_le_left _ _
  · nlinarith
  · nlinarith

/-
Theorem 1.12: The gate is antitone in survival rate. If survival rate increases (worse specification), the gated confidence does not increase (more conservative gate).
-/
theorem T1_12_gate_antitone_in_survival
    (α : AlgebraResult) (μ₁ μ₂ : MutationState)
    (h_conf : 0 ≤ α.confidence ∧ α.confidence ≤ 1)
    (h_le : μ₁.survival ≤ μ₂.survival) :
    (crossChannelGate α μ₂).confidence ≤ (crossChannelGate α μ₁).confidence := by
      unfold crossChannelGate;
      split_ifs <;> norm_num at * <;> try linarith;
      · constructor <;> linarith;
      · constructor <;> linarith

/-
Definition of OracleLevel, LinearOrder instance, and proof of Theorem 1.13 (total order).
-/
inductive OracleLevel
| CRASH
| TYPE
| STRUCTURAL
| SHAPE
| VALUE
| PROPERTY
deriving Repr, DecidableEq

def OracleLevel.toNat : OracleLevel → Nat
| CRASH => 0
| TYPE => 1
| STRUCTURAL => 2
| SHAPE => 3
| VALUE => 4
| PROPERTY => 5

theorem OracleLevel.toNat_inj : Function.Injective OracleLevel.toNat := by
  intro x y h
  cases x <;> cases y <;> simp_all [OracleLevel.toNat]

instance : LinearOrder OracleLevel :=
  LinearOrder.lift' OracleLevel.toNat OracleLevel.toNat_inj

theorem T1_13_oracleLevel_total (a b : OracleLevel) : a ≤ b ∨ b ≤ a :=
  le_total a b

/-
Definition of OptimizationType and optRequiredLevel. Proof of Theorem 1.14: Optimization Safety is Monotone. If O₁ requires a lower level than O₂, and the achieved level meets O₂'s requirement, then it also meets O₁'s requirement.
-/
structure OptimizationType where
  requiredLevel : OracleLevel

def optRequiredLevel (O : OptimizationType) : OracleLevel := O.requiredLevel

theorem T1_14_opt_safety_monotone
    (O₁ O₂ : OptimizationType)
    (achievedLevel : OracleLevel)
    (h_req : optRequiredLevel O₁ ≤ optRequiredLevel O₂)
    (h_met : optRequiredLevel O₂ ≤ achievedLevel) :
    optRequiredLevel O₁ ≤ achievedLevel := by
  exact le_trans h_req h_met

/-
Theorem 1.10: Gate Verified Implies Low Survival. If the cross-channel gate returns VERIFIED status, then the mutation survival rate is strictly less than 30%.
-/
theorem T1_10_gate_verified_implies_low_survival
    (α : AlgebraResult) (μ : MutationState)
    (h : (crossChannelGate α μ).status = GateStatus.VERIFIED) :
    μ.survival < 0.30 := by
      unfold crossChannelGate at h; aesop;
