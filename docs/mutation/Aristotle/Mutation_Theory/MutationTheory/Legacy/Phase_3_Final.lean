/-
This module formalizes Theorem T3.1 from the Specification Completeness Theory.
It defines a `Program` structure and proves that for a separable function
f(x₁, x₂) = h(g₁(x₁), g₂(x₂)), if h is injective in its first argument,
then mutations in g₁ can be detected independently of the value of g₂.
-/

import Mathlib

set_option linter.mathlibStandardSet false

open scoped BigOperators
open scoped Real
open scoped Nat
open scoped Classical
open scoped Pointwise

set_option synthInstance.maxHeartbeats 20000
set_option synthInstance.maxSize 128

set_option relaxedAutoImplicit false
set_option autoImplicit false

noncomputable section

/-
A Program is a wrapper around a function from input domain D to output range R.
-/
/-- In this phase we use an explicit functional representation for programs to
state decomposition theorems directly over semantic functions. -/
structure Program (D R : Type*) where
  eval : D → R

/-
If a function factors through a product, mutations in one factor can be detected by tests on that factor alone.
-/
theorem T3_1_separable_independent_testing
    {D₁ D₂ R₁ R₂ R : Type*}
    [DecidableEq R₁] [DecidableEq R₂] [DecidableEq R]
    (g₁ g₁' : Program D₁ R₁)
    (g₂ : Program D₂ R₂)
    (h : R₁ → R₂ → R)
    (h_injective_left : ∀ r₂, Function.Injective (fun r₁ => h r₁ r₂))
    /- g₁' differs from g₁ on some input -/
    (x_star : D₁) (h_diff : g₁.eval x_star ≠ g₁'.eval x_star)
    /- Then for ANY x₂, the composed outputs differ -/
    (x₂ : D₂) :
    h (g₁.eval x_star) (g₂.eval x₂) ≠ h (g₁'.eval x_star) (g₂.eval x₂) := by
  exact fun h' => h_diff ( h_injective_left _ h' )

  /-
When a function mixes two independent concerns (categories Cᵢ and Cⱼ), the number of tests needed to fully specify the function grows as the PRODUCT of the per-category surviving mutant counts, not their sum. (Note: for the minimal case of 2 mutants each, the product equals the sum; otherwise it is strictly greater).
-/
theorem T3_2_product_vs_sum
    (a b : ℕ) (ha : 1 < a) (hb : 1 < b) :
    a + b ≤ a * b := by
  nlinarith

  /-
If interaction > 0, then survA + survB < survA + survB + interaction.
-/
theorem T3_3_decomposition_reduces_burden
    (survA survB interaction : ℕ)
    (h_interaction_pos : 0 < interaction)
    /- Before decomposition: total tests needed includes interaction -/
    /- After decomposition: interaction term vanishes -/
    : survA + survB < survA + survB + interaction := by
  linarith

/-
XOR factors through non-identity components (specifically `not`).
-/
def XOR (x y : Bool) : Bool := x ≠ y

theorem T3_4_XOR_factors_through_not :
    ∃ (h : Bool → Bool → Bool) (g₁ g₂ : Bool → Bool),
      (∀ x y, XOR x y = h (g₁ x) (g₂ y)) ∧ g₁ ≠ id ∧ g₂ ≠ id := by
  exists fun x y => x ≠ y, fun x => !x, fun x => !x

/-
If a property P holds on a finite set S but is not universally true, there exists a counterexample outside S.
-/
theorem T3_5_universal_stronger_than_finite
    {α : Type} [Infinite α]
    (S : Finset α)
    (P : α → Prop)
    (h_holds_on_S : ∀ x ∈ S, P x)
    (h_not_universal : ¬ ∀ x, P x)
    : ∃ x, x ∉ S ∧ ¬ P x := by
  grind +ring

/-
Definition of OracleLevel and its LinearOrder instance using lift'.
-/
inductive OracleLevel
  | CRASH
  | TYPE
  | STRUCTURAL
  | SHAPE
  | VALUE
  | PROPERTY
  deriving Repr, DecidableEq, Inhabited

def OracleLevel.toNat : OracleLevel → Nat
  | CRASH => 0
  | TYPE => 1
  | STRUCTURAL => 2
  | SHAPE => 3
  | VALUE => 4
  | PROPERTY => 5

theorem OracleLevel.toNat_injective : Function.Injective OracleLevel.toNat := by
  intro a b h
  cases a <;> cases b <;> simp [OracleLevel.toNat] at h ⊢

instance : LinearOrder OracleLevel := LinearOrder.lift' OracleLevel.toNat OracleLevel.toNat_injective

/-
If a weighting function is strictly monotone with respect to oracle levels, then a higher oracle level yields a strictly higher weighted score for the same number of kills (assuming kills > 0).
-/
theorem T3_6_weighted_distinguishes
    (kills : ℕ)
    (level₁ level₂ : OracleLevel)
    (w : OracleLevel → ℚ)
    (h_monotone : ∀ l₁ l₂, l₁ < l₂ → w l₁ < w l₂)
    (h_kills_pos : 0 < kills)
    (h_level_lt : level₁ < level₂)
    : (kills : ℚ) * w level₁ < (kills : ℚ) * w level₂ := by
  exact mul_lt_mul_of_pos_left ( h_monotone _ _ h_level_lt ) ( Nat.cast_pos.mpr h_kills_pos )

/-
There exist functions (like XOR or Equality) that cannot be decomposed into independent components without at least one component being an isomorphism (i.e., no information loss). This captures the idea of 'irreducible' functions where the interaction is essential. Note: The original condition 'g ≠ id' is insufficient for Bool as 'not' is a non-identity isomorphism; we use '¬ Injective' to represent lossy decomposition.
-/
theorem T3_4_irreducible_functions_exist :
    ∃ (f : Bool × Bool → Bool),
      ¬ ∃ (g₁ : Bool → Bool) (g₂ : Bool → Bool) (h : Bool → Bool → Bool),
        (∀ x y, f (x, y) = h (g₁ x) (g₂ y)) ∧
        (¬ Function.Injective g₁ ∨ ¬ Function.Injective g₂) := by
  simp_all +decide
