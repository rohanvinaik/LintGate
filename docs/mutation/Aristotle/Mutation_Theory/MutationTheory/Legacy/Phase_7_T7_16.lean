theorem composition_gap {α β γ : Type} (P_A : Program β γ) (P_B : Program α β) (extra_mutants : Set (α → γ))
    (h_surj : Function.Surjective P_B.f) (h_inj : Function.Injective P_A.f) :
    kappa (Program.comp P_A P_B extra_mutants) ≤ kappa P_A + kappa P_B + gamma P_A P_B extra_mutants := by
      -- Apply the kappa_union lemma to the composition of programs.
      have h_union : kappa (Program.comp P_A P_B extra_mutants) ≤ kappa { f := P_A.f ∘ P_B.f, mutants := ((fun m => m ∘ P_B.f) '' P_A.mutants) ∪ ((fun m => P_A.f ∘ m) '' P_B.mutants) } + gamma P_A P_B extra_mutants := by
                                                                            convert kappa_union _ _ _ _ using 2;
                                                                            exact rfl;
      refine' le_trans h_union ( add_le_add_right _ _ );
      refine le_trans ( kappa_union _ _ _ rfl ) ?_;
      refine' add_le_add _ _;
      · convert kappa_comp_right_of_surjective _ _ _ h_surj using 1;
      · convert kappa_comp_left_of_injective _ _ _ h_inj using 1

/-
The kappa complexity of a program is bounded by the number of its mutants.
-/
