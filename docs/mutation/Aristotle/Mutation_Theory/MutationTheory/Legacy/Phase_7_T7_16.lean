lemma kappa_subset {α β : Type} (P : Program α β) (M : Set (α → β)) (h : M ⊆ P.mutants) :
    kappa { P with mutants := M } ≤ kappa P := by
  refine' le_csInf _ _;
  · -- Let's choose any test suite T for P.
    obtain ⟨T, hT⟩ : ∃ T : Set α, is_test_suite P T := by
      use Set.univ; intro m hm hne; simp [kills] at *; (
      exact Function.ne_iff.mp ( Ne.symm hne ) |> Exists.imp fun x hx => by tauto;);
    use T.ncard
    aesop;
  · rintro n ⟨ T, hT₁, rfl ⟩;
    refine' Nat.sInf_le ⟨ T, _, rfl ⟩;
    intro m hm; specialize hT₁ m; aesop;

