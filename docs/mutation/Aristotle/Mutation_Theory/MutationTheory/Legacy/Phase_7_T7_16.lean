                                                                                                                                                          simp_all +decide [ Program.mutants ];
                                                                                                                                                          refine' le_trans ( csInf_le _ ⟨ ∅, _, _ ⟩ ) _ <;> norm_num;
                                                                                                                                                          exact 0;
                                                                                                                                                          · exact fun m hm hm' => False.elim <| hm' <| contra m hm;
                                                                                                                                                          · rfl;
                                                                                                                                                          · exact Nat.zero_le _ ) ) ( Classical.choose_spec ( show ∃ m ∈ P.mutants, m ≠ P.f from not_forall_not.mp fun contra => h_contra <| by
                                                                                                                                                                                                                                                                                simp_all +decide [ Program.mutants ];
                                                                                                                                                                                                                                                                                refine' le_trans ( csInf_le _ ⟨ ∅, _, _ ⟩ ) _ <;> norm_num;
                                                                                                                                                                                                                                                                                exact 0;
                                                                                                                                                                                                                                                                                · exact fun m hm hm' => False.elim <| hm' <| contra m hm;
