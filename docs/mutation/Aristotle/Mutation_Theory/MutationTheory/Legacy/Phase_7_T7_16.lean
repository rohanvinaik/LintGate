    intro m hm hne; contrapose! h_contra; simp_all +decide [ kills ] ;
    exact False.elim <| hne <| funext fun x => h_contra x ▸ rfl;
  -- Let $T = \{ t_m \mid m \in P.mutants \}$ be the set of test cases.
