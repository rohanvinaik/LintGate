/-
An interface mutant is a mutant of the composed program that is not equivalent to any mutant of A alone or B alone.
-/
def InterfaceMutants {α β γ : Type} (P_A : Program β γ) (P_B : Program α β) (extra_mutants : Set (α → γ)) : Set (α → γ) :=
  { m ∈ (P_A.comp P_B extra_mutants).mutants |
    (∀ m_A ∈ P_A.mutants, m ≠ m_A ∘ P_B.f) ∧
    (∀ m_B ∈ P_B.mutants, m ≠ P_A.f ∘ m_B) }

/-
The composition gap is bounded by the number of interface mutants.
-/
theorem gamma_le_interface_mutants_card {α β γ : Type} (P_A : Program β γ) (P_B : Program α β) (extra_mutants : Set (α → γ))
  (h_finite : (InterfaceMutants P_A P_B extra_mutants).Finite) :
  gamma P_A P_B (InterfaceMutants P_A P_B extra_mutants) ≤ (InterfaceMutants P_A P_B extra_mutants).ncard := by
  apply kappa_le_card
  exact h_finite

