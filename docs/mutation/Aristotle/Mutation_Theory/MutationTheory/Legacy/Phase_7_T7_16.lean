structure Program (α β : Type) where
  f : α → β
  mutants : Set (α → β)

def kills {α β : Type} (f m : α → β) (t : α) : Prop := f t ≠ m t

def is_test_suite {α β : Type} (P : Program α β) (T : Set α) : Prop :=
  ∀ m ∈ P.mutants, m ≠ P.f → ∃ t ∈ T, kills P.f m t

noncomputable def kappa {α β : Type} (P : Program α β) : ℕ :=
  sInf { n | ∃ T, is_test_suite P T ∧ T.ncard = n }

def Program.comp {α β γ : Type} (P_A : Program β γ) (P_B : Program α β) (extra_mutants : Set (α → γ)) : Program α γ :=
  { f := P_A.f ∘ P_B.f
    mutants := ((fun m => m ∘ P_B.f) '' P_A.mutants) ∪ ((fun m => P_A.f ∘ m) '' P_B.mutants) ∪ extra_mutants }

noncomputable def gamma {α β γ : Type} (P_A : Program β γ) (P_B : Program α β) (extra_mutants : Set (α → γ)) : ℕ :=
  kappa { f := P_A.f ∘ P_B.f, mutants := extra_mutants }

