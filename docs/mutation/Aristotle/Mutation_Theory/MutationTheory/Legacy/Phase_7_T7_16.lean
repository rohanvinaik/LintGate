theorem gamma_le_total {α β γ : Type} (P_A : Program β γ) (P_B : Program α β) (extra_mutants : Set (α → γ)) :
    gamma P_A P_B extra_mutants ≤ kappa (Program.comp P_A P_B extra_mutants) := by
      -- By definition of composition, the mutants of the composition include the extra mutants.
      have h_mutants : (P_A.comp P_B extra_mutants).mutants ⊇ extra_mutants := by
        exact fun x hx => Set.mem_union_right _ hx;
      convert kappa_subset _ _ h_mutants using 1

