/-
Definitions of MutationContext, killed, survivors, and achievesFullSC'.
Theorem lyapunov_monotonicity:
1. killed set increases with test suite.
2. survivors count decreases with test suite.
3. 0 survivors iff full SC.
-/
structure MutationContext (D R : Type) where
  P : D → R
  MS : Set (D → R)
  oracle : D → R

def killed {D R : Type} (ctx : MutationContext D R) (T : Set D) : Set (D → R) :=
  { m ∈ ctx.MS | ∃ t ∈ T, m t ≠ ctx.oracle t }

def survivors {D R : Type} (ctx : MutationContext D R) (T : Set D) : Set (D → R) :=
  ctx.MS \ killed ctx T

def achievesFullSC' {D R : Type} (ctx : MutationContext D R) (T : Set D) : Prop :=
  survivors ctx T = ∅

theorem lyapunov_monotonicity {D R : Type} (ctx : MutationContext D R) (T₁ T₂ : Set D)
    (h_subset : T₁ ⊆ T₂) (h_finite : ctx.MS.Finite) :
    (killed ctx T₁ ⊆ killed ctx T₂) ∧
    (Set.ncard (survivors ctx T₂) ≤ Set.ncard (survivors ctx T₁)) ∧
    (Set.ncard (survivors ctx T₁) = 0 ↔ achievesFullSC' ctx T₁) := by
      have h_subset : survivors ctx T₂ ⊆ survivors ctx T₁ := by
        -- To prove the subset relationship, we show that if an element is in survivors ctx T₂, then it must also be in survivors ctx T₁.
        intro m hm
        simp [survivors] at hm ⊢;
        unfold killed at *; aesop;
      refine' ⟨ _, _, _ ⟩;
      · exact fun x hx => Set.mem_setOf.mpr <| by rcases Set.mem_setOf.mp hx with ⟨ hx₁, hx₂, hx₃ ⟩ ; exact ⟨ hx₁, by aesop ⟩ ;
      · apply_rules [ Set.ncard_le_ncard ];
        exact h_finite.subset fun x hx => hx.1;
      · unfold achievesFullSC';
        rw [ @Set.ncard_eq_zero ];
        exact Set.Finite.subset h_finite fun x hx => by cases hx; aesop;

/-
Definition of disagreement probability: sum of ρ(d) for all d where oracle(d) ≠ m(d).
-/
/-- The disagreement probability of a mutant m with respect to the oracle
    under input distribution ρ: the probability that a random input
    distinguishes the oracle from m. -/
def disagreementProb {D R : Type} [Fintype D] [DecidableEq R]
    (oracle : D → R) (ρ : D → ℝ) (m : D → R) : ℝ :=
  (Finset.univ.filter (fun d => oracle d ≠ m d)).sum ρ

/-
Definition of local disagreement spectrum.
Theorem: The size of the local disagreement spectrum monotonically decreases as the test suite grows.
-/
def localDisagreementSpectrum {D R : Type} [Fintype D] [DecidableEq R]
    (ctx : MutationContext D R) (T : Set D) (ρ : D → ℝ)
    (h_finite : ctx.MS.Finite) : Multiset ℝ :=
  let survivors_set := survivors ctx T
  have h_subset : survivors_set ⊆ ctx.MS := Set.diff_subset
  let survivors_finite : survivors_set.Finite := h_finite.subset h_subset
  (survivors_finite.toFinset).val.map (disagreementProb ctx.oracle ρ)

theorem spectrum_size_antitone {D R : Type} [Fintype D] [DecidableEq R]
    (ctx : MutationContext D R) (T₁ T₂ : Set D) (ρ : D → ℝ)
    (h_finite : ctx.MS.Finite) (h_subset : T₁ ⊆ T₂) :
    Multiset.card (localDisagreementSpectrum ctx T₂ ρ h_finite) ≤
    Multiset.card (localDisagreementSpectrum ctx T₁ ρ h_finite) := by
  unfold localDisagreementSpectrum
  simp only [Multiset.card_map, Finset.card_val]
  apply Finset.card_le_card
  intro m hm
  rw [Set.Finite.mem_toFinset] at hm ⊢
  have h_killed_mono := (lyapunov_monotonicity ctx T₁ T₂ h_subset h_finite).1
  exact Set.diff_subset_diff_right h_killed_mono hm

/-
Definition of spectrumMax.
Theorem: spectrumMax is non-increasing as the test suite grows.
-/
def spectrumMax {D R : Type} [Fintype D] [DecidableEq R]
    (ctx : MutationContext D R) (T : Set D) (ρ : D → ℝ)
    (h_finite : ctx.MS.Finite) : WithBot ℝ :=
  (localDisagreementSpectrum ctx T ρ h_finite).toFinset.max

theorem spectrum_max_antitone {D R : Type} [Fintype D] [DecidableEq R]
    (ctx : MutationContext D R) (T₁ T₂ : Set D) (ρ : D → ℝ)
    (h_finite : ctx.MS.Finite) (h_subset : T₁ ⊆ T₂) :
    spectrumMax ctx T₂ ρ h_finite ≤ spectrumMax ctx T₁ ρ h_finite := by
  unfold spectrumMax
  apply Finset.max_mono
  intro x hx
  rw [Multiset.mem_toFinset] at hx ⊢
  unfold localDisagreementSpectrum at hx ⊢
  rw [Multiset.mem_map] at hx ⊢
  rcases hx with ⟨m, hm, h_eq⟩
  use m
  constructor
  · rw [Finset.mem_val, Set.Finite.mem_toFinset] at hm ⊢
    have h_killed_mono := (lyapunov_monotonicity ctx T₁ T₂ h_subset h_finite).1
    exact Set.diff_subset_diff_right h_killed_mono hm
  · exact h_eq

/-
Definition of spectrumMin.
Theorem: spectrumMin is non-decreasing as the test suite grows.
-/
def spectrumMin {D R : Type} [Fintype D] [DecidableEq R]
    (ctx : MutationContext D R) (T : Set D) (ρ : D → ℝ)
    (h_finite : ctx.MS.Finite) : WithTop ℝ :=
  (localDisagreementSpectrum ctx T ρ h_finite).toFinset.min

theorem spectrum_min_monotone {D R : Type} [Fintype D] [DecidableEq R]
    (ctx : MutationContext D R) (T₁ T₂ : Set D) (ρ : D → ℝ)
    (h_finite : ctx.MS.Finite) (h_subset : T₁ ⊆ T₂) :
    spectrumMin ctx T₁ ρ h_finite ≤ spectrumMin ctx T₂ ρ h_finite := by
  unfold spectrumMin
  apply Finset.min_mono
  intro x hx
  rw [Multiset.mem_toFinset] at hx ⊢
  unfold localDisagreementSpectrum at hx ⊢
  rw [Multiset.mem_map] at hx ⊢
  rcases hx with ⟨m, hm, h_eq⟩
  use m
  constructor
  · rw [Finset.mem_val, Set.Finite.mem_toFinset] at hm ⊢
    have h_killed_mono := (lyapunov_monotonicity ctx T₁ T₂ h_subset h_finite).1
    exact Set.diff_subset_diff_right h_killed_mono hm
  · exact h_eq

/-
Definition of spectrumMean: the average disagreement probability of survivors.
-/
def spectrumMean {D R : Type} [Fintype D] [DecidableEq R]
    (ctx : MutationContext D R) (T : Set D) (ρ : D → ℝ)
    (h_finite : ctx.MS.Finite) : ℝ :=
  let s := localDisagreementSpectrum ctx T ρ h_finite
  if s.card = 0 then 0 else s.sum / (s.card : ℝ)

