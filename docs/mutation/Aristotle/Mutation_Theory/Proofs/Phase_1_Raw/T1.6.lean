inductive SpecificationLevel
  | L0 -- UNSPECIFIED
  | L1 -- WEAKLY_SPECIFIED
  | L2 -- PARTIALLY_SPECIFIED
  | L3 -- MODERATELY_SPECIFIED
  | L4 -- SPECIFIED
  deriving Repr, DecidableEq

def SpecificationLevel.toNat : SpecificationLevel → Nat
  | L0 => 0
  | L1 => 1
  | L2 => 2
  | L3 => 3
  | L4 => 4

instance : LinearOrder SpecificationLevel :=
  LinearOrder.lift' SpecificationLevel.toNat (by
    intro x y h
    cases x <;> cases y
    all_goals try (simp only [SpecificationLevel.toNat] at h; contradiction)
    all_goals rfl)

def classifyLevel (sc : ℚ) : SpecificationLevel :=
  if sc < 0.1 then SpecificationLevel.L0
  else if sc < 0.3 then SpecificationLevel.L1
  else if sc < 0.5 then SpecificationLevel.L2
  else if sc < 0.8 then SpecificationLevel.L3
  else SpecificationLevel.L4

theorem T1_6_classifyLevel_monotone
    (sc₁ sc₂ : ℚ)
    (h_le : sc₁ ≤ sc₂)
    (h_bounds₁ : 0 ≤ sc₁)
    (h_bounds₂ : sc₂ ≤ 1) :
    classifyLevel sc₁ ≤ classifyLevel sc₂ := by
  -- Since the classification levels are ordered in the same way as the scores, the function classifyLevel is monotonic.
  have h_monotone : ∀ (sc₁ sc₂ : ℚ), 0 ≤ sc₁ → sc₁ ≤ sc₂ → sc₂ ≤ 1 → sc₁ ≤ sc₂ → classifyLevel sc₁ ≤ classifyLevel sc₂ := by
    intros sc₁ sc₂ h_bounds₁ h_le h_bounds₂ h_le'
    simp [classifyLevel];
    split_ifs <;> norm_num at * <;> try linarith;
    all_goals trivial;
  exact h_monotone sc₁ sc₂ h_bounds₁ h_le h_bounds₂ h_le