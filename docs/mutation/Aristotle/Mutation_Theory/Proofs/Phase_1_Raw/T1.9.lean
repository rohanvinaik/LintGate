/-
Formalization of T1.9 (Convergence of Test-Approximate Equivalence) and T1.10 (Gate Verified → Low Survival).

Definitions:
- `Program D R`: A function from domain D to range R.
- `Test D R`: A pair of an input and an oracle (R → Bool).
- `passes`: A program passes a test if the oracle returns true on the program's output.
- `trueEquiv`: Two programs are truly equivalent if they produce the same output for all inputs.
- `Status`: An enum with values `.verified` and `.rejected`.
- `crossChannelGate`: A function that determines the status based on a survival rate.

Theorems:
- `T1_9_nonequiv_is_distinguishable`: If two programs are not truly equivalent, there exists a test that distinguishes them.
- `T1_10_gate_verified_implies_low_survival`: If the cross-channel gate returns `.verified`, the survival rate is less than 3/10.
-/

import Mathlib

set_option linter.mathlibStandardSet false

open scoped BigOperators
open scoped Real
open scoped Nat
open scoped Classical
open scoped Pointwise

set_option maxHeartbeats 0
set_option maxRecDepth 4000
set_option synthInstance.maxHeartbeats 20000
set_option synthInstance.maxSize 128

set_option relaxedAutoImplicit false
set_option autoImplicit false

noncomputable section

/-
Definitions of Program, Test, passes, and trueEquiv based on the provided markdown.
-/
def Program (D R : Type) := D → R

def Test (D R : Type) := D × (R → Bool)

def passes {D R : Type} (P : Program D R) (t : Test D R) : Bool :=
  t.2 (P t.1)

def trueEquiv {D R : Type} [DecidableEq R] (P₁ P₂ : Program D R) : Prop :=
  ∀ x, P₁ x = P₂ x

/-
If two programs are NOT truly equivalent, there exists a finite test suite that distinguishes them.
-/
theorem T1_9_nonequiv_is_distinguishable
    {D R : Type} [DecidableEq R]
    (P₁ P₂ : Program D R)
    (h_neq : ¬ trueEquiv P₁ P₂) :
    ∃ (t : Test D R), passes P₁ t ≠ passes P₂ t := by
  -- Since P₁ and P₂ are not truly equivalent, there exists some x such that P₁ x ≠ P₂ x.
  obtain ⟨x, hx⟩ : ∃ x, P₁ x ≠ P₂ x := by
    contrapose! h_neq; aesop;
  -- Define a Test that uses x as input and a check function that is true if the result is P₁ x.
  use (x, fun r => r = P₁ x);
  unfold passes; aesop;

/-
Definition of Status and crossChannelGate. The gate is an if-then-else chain where .verified is only reached if survival < 3/10.
-/
inductive Status
| verified
| rejected
deriving DecidableEq, Repr

def crossChannelGate (survival : Rat) : Status :=
  if survival >= 8/10 then .rejected
  else if survival >= 3/10 then .rejected
  else .verified

/-
If the gate status is verified, then the survival rate is less than 3/10.
-/
theorem T1_10_gate_verified_implies_low_survival
    (survival : Rat)
    (h_verified : crossChannelGate survival = .verified) :
    survival < 3/10 := by
  unfold crossChannelGate at h_verified; aesop;