/-
Formalization of T1.11: Gate Conservatism.
Defines AlgebraResult, MutationState, GateStatus, GatedResult, and crossChannelGate.
Proves that the cross-channel gate never increases confidence above the input confidence.
-/

import Mathlib

set_option linter.mathlibStandardSet false

open scoped BigOperators
open scoped Real
open scoped Nat
open scoped Classical
open scoped Pointwise

set_option maxHeartbeats 0
set_option maxRecDepth 4000
set_option synthInstance.maxHeartbeats 20000
set_option synthInstance.maxSize 128

set_option relaxedAutoImplicit false
set_option autoImplicit false

noncomputable section

/-
Definitions of AlgebraResult, MutationState, GateStatus, and GatedResult based on the project documentation.
-/
structure AlgebraResult where
  property : String
  confidence : Real

structure MutationState where
  survival : Real
  depth : Nat

inductive GateStatus
  | VERIFIED
  | PENALIZED
  | GATED
  deriving DecidableEq, Repr

structure GatedResult where
  property : String
  confidence : Real
  status : GateStatus

/-
Definition of the crossChannelGate function which adjusts confidence based on mutation survival rate.
-/
def crossChannelGate (α : AlgebraResult) (μ : MutationState) : GatedResult :=
  if μ.survival < 0.30 then
    { property := α.property, confidence := min α.confidence 0.90, status := GateStatus.VERIFIED }
  else if μ.survival < 0.60 then
    { property := α.property, confidence := α.confidence * 0.50, status := GateStatus.PENALIZED }
  else
    { property := α.property, confidence := α.confidence * 0.10, status := GateStatus.GATED }

/-
The gate never increases confidence above the algebra pipeline's estimate. That is, gated confidence ≤ original confidence (and ≤ 0.9 in all cases).
-/
theorem T1_11_gate_conservative
    (α : AlgebraResult) (μ : MutationState)
    (h_conf : 0 ≤ α.confidence ∧ α.confidence ≤ 1) :
    (crossChannelGate α μ).confidence ≤ α.confidence := by
  unfold crossChannelGate; split_ifs;
  · exact min_le_left _ _;
  · exact mul_le_of_le_one_right h_conf.1 ( by norm_num );
  · norm_num; linarith;