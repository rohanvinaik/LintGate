/-
This module defines a mutation testing framework with Programs, TestSuites, and MutationSystems.
It defines the `killedSet` of a test suite as the set of mutants killed by at least one test in the suite.
It defines `refines` as the inclusion of killed sets.
It proves that the refinement relation is reflexive (`T1_3a_refines_refl`) and transitive (`T1_3b_refines_trans`).
-/

import Mathlib

set_option linter.mathlibStandardSet false

open scoped BigOperators
open scoped Real
open scoped Nat
open scoped Classical
open scoped Pointwise

set_option maxHeartbeats 0
set_option maxRecDepth 4000
set_option synthInstance.maxHeartbeats 20000
set_option synthInstance.maxSize 128

set_option relaxedAutoImplicit false
set_option autoImplicit false

noncomputable section

/-
Definitions of Program, Test, passes, TestSuite, and MutationSystem.
-/
structure Program (D R : Type) where
  id : Nat
  sem : D → R

abbrev Test (D R : Type) := D

def passes {D R : Type} (p : Program D R) (t : Test D R) : R := p.sem t

abbrev TestSuite (D R : Type) := Finset (Test D R)

structure MutationSystem (D R : Type) where
  mutants : Program D R → Finset (Program D R)

/-
Definitions of killedSet and refines.
-/
def killedSet {D R : Type} (MS : MutationSystem D R) (P : Program D R) (T : TestSuite D R)
    [∀ (p : Program D R) (t : Test D R), Decidable (passes P t ≠ passes p t)] : Finset (Program D R) :=
  (MS.mutants P).filter (fun m => ∃ t ∈ T, passes P t ≠ passes m t)

def refines {D R : Type} (MS : MutationSystem D R) (P : Program D R) (T₁ T₂ : TestSuite D R)
    [∀ (p : Program D R) (t : Test D R), Decidable (passes P t ≠ passes p t)] : Prop :=
  killedSet MS P T₁ ⊆ killedSet MS P T₂

/-
Theorem stating that refinement is reflexive.
-/
theorem T1_3a_refines_refl
    {D R : Type}
    (MS : MutationSystem D R) (P : Program D R)
    (T : TestSuite D R)
    [∀ (p : Program D R) (t : Test D R), Decidable (passes P t ≠ passes p t)] :
    refines MS P T T := by
  exact fun x hx => hx

/-
Theorem stating that refinement is transitive.
-/
theorem T1_3b_refines_trans
    {D R : Type}
    (MS : MutationSystem D R) (P : Program D R)
    (T₁ T₂ T₃ : TestSuite D R)
    [∀ (p : Program D R) (t : Test D R), Decidable (passes P t ≠ passes p t)] :
    refines MS P T₁ T₂ → refines MS P T₂ T₃ → refines MS P T₁ T₃ := by
  exact fun h₁ h₂ m hm => h₂ <| h₁ hm;