/-
This module defines the core concepts of mutation testing: Programs, Tests, TestSuites, and the notions of passing a test, surviving a test suite, and being killed by a test suite. It then proves Theorem 1.1, which states that for any program, test suite, and mutant, the mutant is either killed or survives, and these conditions are complementary.
-/

import Mathlib

set_option linter.mathlibStandardSet false

open scoped BigOperators
open scoped Real
open scoped Nat
open scoped Classical
open scoped Pointwise

set_option maxHeartbeats 0
set_option maxRecDepth 4000
set_option synthInstance.maxHeartbeats 20000
set_option synthInstance.maxSize 128

set_option relaxedAutoImplicit false
set_option autoImplicit false

noncomputable section

/-
Definitions of Program, Test, and TestSuite based on the provided markdown.
-/
def Program (D R : Type) := D → R

structure Test (D R : Type) where
  input : D
  oracle : R → Bool

def TestSuite (D R : Type) := Finset (Test D R)

/-
Definitions of passes, isSurvivor, isKilled, and the statement of Theorem 1.1. I am using a let binding to cast TestSuite to Finset to avoid type inference issues.
-/
def passes {D R : Type} (P : Program D R) (t : Test D R) : Bool := t.oracle (P t.input)

def isSurvivor {D R : Type} (P : Program D R) (T : TestSuite D R) (m : Program D R) : Prop :=
  let T_fin : Finset (Test D R) := T
  ∀ t ∈ T_fin, passes P t = passes m t

def isKilled {D R : Type} (P : Program D R) (T : TestSuite D R) (m : Program D R) : Prop :=
  let T_fin : Finset (Test D R) := T
  ∃ t ∈ T_fin, passes P t ≠ passes m t

theorem T1_1_killed_surv_complement {D R : Type}
    (P : Program D R) (T : TestSuite D R) (m : Program D R) :
    isKilled P T m ↔ ¬ isSurvivor P T m := by
  unfold isKilled isSurvivor; aesop;