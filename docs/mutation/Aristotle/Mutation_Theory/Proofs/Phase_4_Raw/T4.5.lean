/-
Formalized Theorem 4.5 showing that algebraic properties (Idempotency, Commutativity, Identity, Constant) act as top-level oracles. Specifically, proved that if a reference implementation satisfies a property and a mutant does not, they are distinguishable by a test case. Also proved that Identity and Constant properties are preserved under composition.
-/

import Mathlib

set_option linter.mathlibStandardSet false

open scoped BigOperators
open scoped Real
open scoped Nat
open scoped Classical
open scoped Pointwise

set_option maxHeartbeats 0
set_option maxRecDepth 4000
set_option synthInstance.maxHeartbeats 20000
set_option synthInstance.maxSize 128

set_option relaxedAutoImplicit false
set_option autoImplicit false

noncomputable section

def IsIdempotent {D : Type} (f : D → D) : Prop :=
  ∀ x, f (f x) = f x

def IsCommutative {D R : Type} (f : D × D → R) : Prop :=
  ∀ x y, f (x, y) = f (y, x)

structure Program (D R : Type) where
  id : Nat
deriving DecidableEq

structure Test (D R : Type) where
  id : Nat
  input : D
deriving DecidableEq

abbrev TestSuite (D R : Type) := Finset (Test D R)

/-
Theorem 4.5 (Idempotency): If a function f is idempotent and a mutant m is not, then there exists a test case that distinguishes f and m.
-/
theorem T4_5_idempotency_test
    {D : Type}
    (sem : Program D D → D → D)
    (f : Program D D) (m : Program D D)
    (h_f : IsIdempotent (sem f))
    (h_m : ¬ IsIdempotent (sem m)) :
    ∃ t : Test D D, sem f t.input ≠ sem m t.input := by
      -- By assumption, $f$ and $m$ are not equivalent, so there exists some $x$ such that $sem f x ≠ sem m x$.
      by_contra h_contra
      push_neg at h_contra
      have h_eq : ∀ x, sem f x = sem m x := by
        intros x
        specialize h_contra ⟨0, x⟩
        exact h_contra;
      exact h_m fun x => by simpa [ h_eq ] using h_f x;

/-
Theorem 4.5 (Commutativity): If a function f is commutative and a mutant m is not, then there exists a test case that distinguishes f and m.
-/
theorem T4_5_commutativity_test
    {D R : Type}
    (sem : Program (D × D) R → (D × D) → R)
    (f : Program (D × D) R) (m : Program (D × D) R)
    (h_f : IsCommutative (sem f))
    (h_m : ¬ IsCommutative (sem m)) :
    ∃ t : Test (D × D) R, sem f t.input ≠ sem m t.input := by
      by_contra! h';
      exact h_m fun x y => h' ⟨ 0, ( x, y ) ⟩ ▸ h' ⟨ 0, ( y, x ) ⟩ ▸ h_f x y ▸ rfl

/-
Theorem 4.5 (Identity): If a function f is identity and a mutant m is not, then there exists a test case that distinguishes f and m.
-/
def IsIdentity {D : Type} (f : D → D) : Prop :=
  ∀ x, f x = x

theorem T4_5_identity_test
    {D : Type}
    (sem : Program D D → D → D)
    (f : Program D D) (m : Program D D)
    (h_f : IsIdentity (sem f))
    (h_m : ¬ IsIdentity (sem m)) :
    ∃ t : Test D D, sem f t.input ≠ sem m t.input := by
      simp_all +decide [ IsIdentity ];
      cases' h_m with x hx; use ⟨ 0, x ⟩ ; tauto;

/-
Theorem 4.5 (Composition): The Identity property is closed under composition.
-/
theorem T4_5_identity_comp
    {D : Type}
    (f g : D → D)
    (hf : IsIdentity f)
    (hg : IsIdentity g) :
    IsIdentity (f ∘ g) := by
      exact fun x => by rw [ Function.comp_apply, hg, hf ] ;

/-
Theorem 4.5 (Constant): If a function f is constant and a mutant m is not, then there exists a test case that distinguishes f and m.
-/
def IsConstant {D R : Type} (f : D → R) : Prop :=
  ∀ x y, f x = f y

theorem T4_5_constant_test
    {D R : Type}
    (sem : Program D R → D → R)
    (f : Program D R) (m : Program D R)
    (h_f : IsConstant (sem f))
    (h_m : ¬ IsConstant (sem m)) :
    ∃ t : Test D R, sem f t.input ≠ sem m t.input := by
      contrapose! h_m;
      convert h_f using 1;
      ext x; exact Eq.symm ( h_m ⟨ 0, x ⟩ ) ;

/-
Theorem 4.5 (Constant Composition): If f is constant, then f ∘ g is constant.
-/
theorem T4_5_constant_comp
    {D R E : Type}
    (f : R → E) (g : D → R)
    (hf : IsConstant f) :
    IsConstant (f ∘ g) := by
      exact fun x y => hf _ _