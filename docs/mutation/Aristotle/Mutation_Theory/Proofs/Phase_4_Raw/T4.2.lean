/-
Definitions for Synthesis Test, State, and Operator from Stage 2.
-/
structure SynthTest (D R : Type) where
  input : D
  oracle : R → Bool

structure SynthState (D R : Type) where
  tests : Set (SynthTest D R)
  survivors : Set (Program D R)

structure SynthOperator (D R : Type) where
  step : SynthState D R → SynthState D R
  tests_monotone : ∀ s, s.tests ⊆ (step s).tests
  surv_antitone : ∀ s, (step s).survivors ⊆ s.survivors

def iterSynth (op : SynthOperator D R) (s : SynthState D R) (n : ℕ) : SynthState D R :=
  match n with
  | 0 => s
  | k + 1 => op.step (iterSynth op s k)

/-
Theorem 4.2: The fixed point of the synthesis operator partitions MS.mutants P into three sets: killed mutants, equivalent mutants, and distinguishable survivors.
-/
def isFixedPoint (op : SynthOperator D R) (s : SynthState D R) : Prop :=
  op.step s = s

variable (MS : MutationSystem D R) (P : Program D R) (s : SynthState D R)

def KilledMutants : Set (Program D R) :=
  {m | m ∈ MS.mutants P ∧ m ∉ s.survivors}

def EquivalentMutants : Set (Program D R) :=
  {m | m ∈ MS.mutants P ∧ m ∈ s.survivors ∧ trueEquiv sem P m}

def DistinguishableSurvivors : Set (Program D R) :=
  {m | m ∈ MS.mutants P ∧ m ∈ s.survivors ∧ ¬ trueEquiv sem P m}

theorem T4_2_fixed_point_partition :
    (KilledMutants MS P s ∪ EquivalentMutants sem MS P s ∪ DistinguishableSurvivors sem MS P s = {m | m ∈ MS.mutants P}) ∧
    Disjoint (KilledMutants MS P s) (EquivalentMutants sem MS P s) ∧
    Disjoint (KilledMutants MS P s) (DistinguishableSurvivors sem MS P s) ∧
    Disjoint (EquivalentMutants sem MS P s) (DistinguishableSurvivors sem MS P s) := by
  unfold KilledMutants EquivalentMutants DistinguishableSurvivors; simp +decide [ *, Set.ext_iff ] ;
  simp +contextual [ Set.disjoint_left ];
  grind +ring