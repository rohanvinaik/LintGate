theorem T1_9_nonequiv_is_distinguishable
    (P₁ P₂ : Program D R)
    (h_neq : ¬ trueEquiv sem P₁ P₂) :
    ∃ (t : Test D R) (oracle' : Test D R → R → Bool),
      passes sem oracle' P₁ t ≠ passes sem oracle' P₂ t := by
  unfold trueEquiv at h_neq
  push_neg at h_neq
