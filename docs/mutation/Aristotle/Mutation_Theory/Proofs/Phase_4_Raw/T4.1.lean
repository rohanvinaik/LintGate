noncomputable section

structure Program (D R : Type) where
  id : Nat
deriving DecidableEq

structure Test (D R : Type) where
  id : Nat
  input : D
deriving DecidableEq

abbrev TestSuite (D R : Type) := Finset (Test D R)

def passes {D R : Type} (sem : Program D R → D → R) (oracle : Test D R → R → Bool) (P : Program D R) (t : Test D R) : Bool :=
  oracle t (sem P t.input)

def isSurvivor {D R : Type} (sem : Program D R → D → R) (oracle : Test D R → R → Bool) (P : Program D R) (T : TestSuite D R) (m : Program D R) : Prop :=
  ∀ t ∈ T, passes sem oracle P t = passes sem oracle m t

def isKilled {D R : Type} (sem : Program D R → D → R) (oracle : Test D R → R → Bool) (P : Program D R) (T : TestSuite D R) (m : Program D R) : Prop :=
  ∃ t ∈ T, passes sem oracle P t ≠ passes sem oracle m t

def testEquiv {D R : Type} (sem : Program D R → D → R) (oracle : Test D R → R → Bool) (T : TestSuite D R) (P₁ P₂ : Program D R) : Prop :=
  ∀ t ∈ T, passes sem oracle P₁ t = passes sem oracle P₂ t

structure MutationSystem (D R : Type) where
  mutants : Program D R → Finset (Program D R)

def killedSet {D R : Type} (sem : Program D R → D → R) (oracle : Test D R → R → Bool) (MS : MutationSystem D R) (P : Program D R) (T : TestSuite D R) : Finset (Program D R) :=
  (MS.mutants P).filter (fun m => ∃ t ∈ T, passes sem oracle P t ≠ passes sem oracle m t)

/-
If the killed set equals the set of all mutants, then no mutant is test-equivalent to the original program.
-/
theorem T4_1_rewrite_license'
    {D R : Type}
    (sem : Program D R → D → R)
    (oracle : Test D R → R → Bool)
    (MS : MutationSystem D R) (P : Program D R) (T : TestSuite D R) :
    killedSet sem oracle MS P T = MS.mutants P →
    ∀ m ∈ MS.mutants P, ¬ testEquiv sem oracle T P m := by
      unfold testEquiv killedSet; aesop;

def ProgramsEquivalent (p1 p2 : Nat.Partrec.Code) : Prop :=
  ∀ x, p1.eval x = p2.eval x

