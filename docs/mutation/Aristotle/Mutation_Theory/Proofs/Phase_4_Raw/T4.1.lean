/-
True equivalence means the programs have identical behavior on all inputs.
-/
def trueEquiv {D R : Type} (sem : Program D R → D → R) (P m : Program D R) : Prop :=
  ∀ x, sem P x = sem m x

/-
When the input domain is finite, it is decidable whether two programs are equivalent.
-/
def T2_10_equiv_decidable_finite_domain
    {D R : Type} [DecidableEq R] [Fintype D]
    (sem : Program D R → D → R)
    (P m : Program D R) :
    Decidable (trueEquiv sem P m) := by
  unfold trueEquiv
  exact Fintype.decidableForallFintype

/-
If the killed set is not equal to the set of all mutants, then there exists a mutant that survives the test suite.
-/
theorem T4_1_converse_survivor_existence
    {D R : Type}
    (sem : Program D R → D → R)
    (oracle : Test D R → R → Bool)
    (MS : MutationSystem D R) (P : Program D R) (T : TestSuite D R) :
    killedSet sem oracle MS P T ≠ MS.mutants P →
    ∃ m ∈ MS.mutants P, isSurvivor sem oracle P T m := by
      unfold isSurvivor killedSet; aesop;