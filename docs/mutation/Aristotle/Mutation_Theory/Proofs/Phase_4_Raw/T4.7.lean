structure Program (D R : Type) where
  id : Nat
deriving DecidableEq

structure Test (D R : Type) where
  id : Nat
  input : D
deriving DecidableEq

abbrev TestSuite (D R : Type) := Finset (Test D R)

variable {D R : Type}
variable (sem : Program D R → D → R)
variable (oracle : Test D R → R → Bool)

def passes (P : Program D R) (t : Test D R) : Bool :=
  oracle t (sem P t.input)

def isSurvivor (P : Program D R) (T : TestSuite D R) (m : Program D R) : Prop :=
  ∀ t ∈ T, passes sem oracle P t = passes sem oracle m t

def isKilled (P : Program D R) (T : TestSuite D R) (m : Program D R) : Prop :=
  ∃ t ∈ T, passes sem oracle P t ≠ passes sem oracle m t

theorem T1_1_killed_surv_complement
    (P : Program D R) (T : TestSuite D R) (m : Program D R) :
    isKilled sem oracle P T m ↔ ¬ isSurvivor sem oracle P T m := by
  unfold isKilled isSurvivor
  push_neg
  rfl

def testEquiv (T : TestSuite D R) (P₁ P₂ : Program D R) : Prop :=
  ∀ t ∈ T, passes sem oracle P₁ t = passes sem oracle P₂ t

theorem T1_2a_testEquiv_refl (T : TestSuite D R) (P : Program D R) :
    testEquiv sem oracle T P P := by
  intro t ht
  rfl

theorem T1_2b_testEquiv_symm (T : TestSuite D R) (P₁ P₂ : Program D R) :
    testEquiv sem oracle T P₁ P₂ → testEquiv sem oracle T P₂ P₁ := by
  intro h t ht
  symm
  exact h t ht

theorem T1_2c_testEquiv_trans (T : TestSuite D R) (P₁ P₂ P₃ : Program D R) :
    testEquiv sem oracle T P₁ P₂ → testEquiv sem oracle T P₂ P₃ → testEquiv sem oracle T P₁ P₃ := by
  intro h1 h2 t ht
  rw [h1 t ht, h2 t ht]

structure MutationSystem (D R : Type) where
  mutants : Program D R → Finset (Program D R)

def killedSet (MS : MutationSystem D R) (P : Program D R) (T : TestSuite D R) : Finset (Program D R) :=
  (MS.mutants P).filter (fun m => ∃ t ∈ T, passes sem oracle P t ≠ passes sem oracle m t)

def refines (MS : MutationSystem D R) (P : Program D R) (T₁ T₂ : TestSuite D R) : Prop :=
  killedSet sem oracle MS P T₁ ⊆ killedSet sem oracle MS P T₂

theorem T1_3a_refines_refl (MS : MutationSystem D R) (P : Program D R) (T : TestSuite D R) :
    refines sem oracle MS P T T := by
  intro m hm
  exact hm

theorem T1_3b_refines_trans (MS : MutationSystem D R) (P : Program D R) (T₁ T₂ T₃ : TestSuite D R) :
    refines sem oracle MS P T₁ T₂ → refines sem oracle MS P T₂ T₃ → refines sem oracle MS P T₁ T₃ := by
  intro h1 h2 m hm
  exact h2 (h1 hm)

theorem T1_4_killedSet_union
    (MS : MutationSystem D R) (P : Program D R)
    (T₁ T₂ : TestSuite D R) :
    killedSet sem oracle MS P (T₁ ∪ T₂) = killedSet sem oracle MS P T₁ ∪ killedSet sem oracle MS P T₂ := by
  ext m
  simp [killedSet]
  grind +ring

def mutationScore (killed total : ℕ) : ℚ := (killed : ℚ) / (total : ℚ)

theorem T1_5_SC_monotone
    (killed₁ killed₂ total : ℕ)
    (h_le : killed₁ ≤ killed₂)
  (_h_bound₁ : killed₁ ≤ total)
  (_h_bound₂ : killed₂ ≤ total)
    (h_pos : 0 < total) :
    mutationScore killed₁ total ≤ mutationScore killed₂ total := by
  unfold mutationScore
  gcongr

inductive SpecificationLevel
  | L0
  | L1
  | L2
  | L3
  | L4
  deriving Repr, DecidableEq

def SpecificationLevel.toNat : SpecificationLevel → Nat
  | L0 => 0
  | L1 => 1
  | L2 => 2
  | L3 => 3
  | L4 => 4

theorem SpecificationLevel.toNat_inj : Function.Injective SpecificationLevel.toNat := by
  intro l1 l2 h
  cases l1 <;> cases l2 <;> cases h <;> trivial

instance : LinearOrder SpecificationLevel :=
  LinearOrder.lift' SpecificationLevel.toNat SpecificationLevel.toNat_inj

/-
Under greedy synthesis, the specification completeness (SC) after k steps is at least 1 - (1 - 1/n)^k, where n is the number of distinct kill-sets. This is the convergence rate theorem.
-/
def distinctKillSets (MS : MutationSystem D R) (P : Program D R) (T_univ : TestSuite D R) : Finset (Finset (Program D R)) :=
  (T_univ.image (fun t => killedSet sem oracle MS P {t})).filter (fun s => s.Nonempty)

def IsGreedySequence (MS : MutationSystem D R) (P : Program D R) (T_univ : TestSuite D R) (seq : ℕ → Test D R) : Prop :=
  ∀ k,
    let covered := (Finset.range k).biUnion (fun i => killedSet sem oracle MS P {seq i})
    let candidate := seq k
    candidate ∈ T_univ ∧
    ∀ t ∈ T_univ,
      let new_covered := killedSet sem oracle MS P {t} \ covered
      let current_gain := (killedSet sem oracle MS P {candidate} \ covered).card
      new_covered.card ≤ current_gain

theorem T4_7_convergence_rate
    (MS : MutationSystem D R) (P : Program D R) (T_univ : TestSuite D R)
    (seq : ℕ → Test D R)
    (h_greedy : IsGreedySequence sem oracle MS P T_univ seq)
    (n : ℕ)
    (h_n : n = (distinctKillSets sem oracle MS P T_univ).card)
    (h_n_pos : n > 0) :
    let covered_k (k : ℕ) := (Finset.range k).biUnion (fun i => killedSet sem oracle MS P {seq i})
    let total_killable := (distinctKillSets sem oracle MS P T_univ).biUnion id
    ∀ k, ((covered_k k).card : ℝ) ≥ (total_killable.card : ℝ) * (1 - (1 - 1 / (n : ℝ))^k) := by
  field_simp;
  intro k;
  induction' k with k ih <;> norm_num [ Finset.range_add_one ] at *;
  -- By definition of `IsGreedySequence`, we know that `killedSet sem oracle MS P {seq k}` is a subset of `total_killable` and maximizes the number of new mutants killed.
  have h_max_killed : ∀ t ∈ T_univ, (killedSet sem oracle MS P {seq k} \ (Finset.range k).biUnion (fun i => killedSet sem oracle MS P {seq i})).card ≥ (killedSet sem oracle MS P {t} \ (Finset.range k).biUnion (fun i => killedSet sem oracle MS P {seq i})).card := by
    intro t ht; have := h_greedy k; aesop;
  -- By definition of `distinctKillSets`, we know that every mutant in `total_killable` is covered by at least one test in `T_univ`.
  have h_covered : (Finset.biUnion (distinctKillSets sem oracle MS P T_univ) id \ (Finset.range k).biUnion (fun i => killedSet sem oracle MS P {seq i})).card ≤ (n : ℝ) * (killedSet sem oracle MS P {seq k} \ (Finset.range k).biUnion (fun i => killedSet sem oracle MS P {seq i})).card := by
    have h_covered : ∀ s ∈ distinctKillSets sem oracle MS P T_univ, (s \ (Finset.range k).biUnion (fun i => killedSet sem oracle MS P {seq i})).card ≤ (killedSet sem oracle MS P {seq k} \ (Finset.range k).biUnion (fun i => killedSet sem oracle MS P {seq i})).card := by
      unfold distinctKillSets; aesop;
    have h_covered : (Finset.biUnion (distinctKillSets sem oracle MS P T_univ) id \ (Finset.range k).biUnion (fun i => killedSet sem oracle MS P {seq i})).card ≤ Finset.sum (distinctKillSets sem oracle MS P T_univ) (fun s => (s \ (Finset.range k).biUnion (fun i => killedSet sem oracle MS P {seq i})).card) := by
      have h_covered : (Finset.biUnion (distinctKillSets sem oracle MS P T_univ) id \ (Finset.range k).biUnion (fun i => killedSet sem oracle MS P {seq i})).card ≤ Finset.card (Finset.biUnion (distinctKillSets sem oracle MS P T_univ) (fun s => s \ (Finset.range k).biUnion (fun i => killedSet sem oracle MS P {seq i}))) := by
        exact Finset.card_le_card fun x hx => by aesop;
      exact h_covered.trans ( Finset.card_biUnion_le );
    exact_mod_cast h_covered.trans ( le_trans ( Finset.sum_le_sum ‹_› ) ( by norm_num [ h_n ] ) );
  -- By combining the induction hypothesis and the covering property, we can conclude the proof.
  have h_combined : (Finset.card (Finset.biUnion (distinctKillSets sem oracle MS P T_univ) id)) * (1 - ((n - 1) / n : ℝ) ^ (k + 1)) ≤ (Finset.card (Finset.biUnion (Finset.range k) (fun i => killedSet sem oracle MS P {seq i}))) + (Finset.card (killedSet sem oracle MS P {seq k} \ (Finset.range k).biUnion (fun i => killedSet sem oracle MS P {seq i}))) := by
    have h_combined : (Finset.card (Finset.biUnion (distinctKillSets sem oracle MS P T_univ) id \ (Finset.range k).biUnion (fun i => killedSet sem oracle MS P {seq i}))) ≥ (Finset.card (Finset.biUnion (distinctKillSets sem oracle MS P T_univ) id)) - (Finset.card (Finset.biUnion (Finset.range k) (fun i => killedSet sem oracle MS P {seq i}))) := by
      exact?;
    rw [ pow_succ' ];
    rw [ div_mul_eq_mul_div, one_sub_div ] <;> norm_num [ h_n_pos.ne' ] at *;
    rw [ mul_div, div_le_iff₀ ] <;> try positivity;
    rw [ ← @Nat.cast_le ℝ ] at * ; push_cast at * ; nlinarith [ show ( n : ℝ ) ≥ 1 by norm_cast, show ( ( n - 1 : ℝ ) / n ) ^ k ≥ 0 by exact pow_nonneg ( div_nonneg ( sub_nonneg.mpr <| Nat.one_le_cast.mpr h_n_pos ) <| Nat.cast_nonneg _ ) _ ] ;
  convert h_combined using 1;
  rw_mod_cast [ ← Finset.card_union_add_card_inter ];
  simp +decide [ Finset.union_comm, Finset.inter_comm ]

/-
At each step of the greedy algorithm, the number of uncovered mutants decreases by a factor of at least (1 - 1/n).
-/
def covered (MS : MutationSystem D R) (P : Program D R) (seq : ℕ → Test D R) (k : ℕ) : Finset (Program D R) :=
  (Finset.range k).biUnion (fun i => killedSet sem oracle MS P {seq i})

def uncovered (MS : MutationSystem D R) (P : Program D R) (T_univ : TestSuite D R) (seq : ℕ → Test D R) (k : ℕ) : Finset (Program D R) :=
  (distinctKillSets sem oracle MS P T_univ).biUnion id \ covered sem oracle MS P seq k

lemma greedy_step_bound
    (MS : MutationSystem D R) (P : Program D R) (T_univ : TestSuite D R)
    (seq : ℕ → Test D R)
    (h_greedy : IsGreedySequence sem oracle MS P T_univ seq)
    (n : ℕ)
    (h_n : n = (distinctKillSets sem oracle MS P T_univ).card)
    (h_n_pos : n > 0)
    (k : ℕ) :
    ((uncovered sem oracle MS P T_univ seq (k + 1)).card : ℝ) ≤ ((uncovered sem oracle MS P T_univ seq k).card : ℝ) * (1 - 1 / (n : ℝ)) := by
  -- By the convergence rate theorem, the increase in SC after each step is at least (1 - SC_k)/n.
  have h_rate : ∀ k, ((Finset.range (k + 1)).biUnion (fun i => killedSet sem oracle MS P {seq i})).card - ((Finset.range k).biUnion (fun i => killedSet sem oracle MS P {seq i})).card ≥ ( ((distinctKillSets sem oracle MS P T_univ).biUnion id).card - ((Finset.range k).biUnion (fun i => killedSet sem oracle MS P {seq i})).card ) / (n : ℝ) := by
    intro k
    set U_k := (distinctKillSets sem oracle MS P T_univ).biUnion id \ (Finset.range k).biUnion (fun i => killedSet sem oracle MS P {seq i})
    have h_card_U_k : U_k.card ≤ (n : ℝ) * ((Finset.range (k + 1)).biUnion (fun i => killedSet sem oracle MS P {seq i})).card - (n : ℝ) * ((Finset.range k).biUnion (fun i => killedSet sem oracle MS P {seq i})).card := by
      -- By the properties of the greedy algorithm, there exists a test $t \in T_univ$ such that $|killedSet(t) \cap U_k| \ge |U_k| / n$.
      obtain ⟨t, ht⟩ : ∃ t ∈ T_univ, ((killedSet sem oracle MS P {t}) ∩ U_k).card ≥ U_k.card / (n : ℝ) := by
        -- By the pigeonhole principle, since there are $n$ distinct kill-sets and $U_k$ is a subset of their union, at least one of these kill-sets must intersect $U_k$ in at least $|U_k| / n$ elements.
        have h_pigeonhole : ∃ S ∈ (distinctKillSets sem oracle MS P T_univ), (S ∩ U_k).card ≥ U_k.card / (n : ℝ) := by
          have h_pigeonhole : ∑ S ∈ distinctKillSets sem oracle MS P T_univ, (S ∩ U_k).card ≥ U_k.card := by
            have h_pigeonhole : U_k ⊆ Finset.biUnion (distinctKillSets sem oracle MS P T_univ) (fun S => S ∩ U_k) := by
              intro x hx; aesop;
            exact le_trans ( Finset.card_le_card h_pigeonhole ) ( Finset.card_biUnion_le );
          contrapose! h_pigeonhole;
          have := Finset.sum_lt_sum_of_nonempty ( Finset.card_pos.mp ( by aesop ) ) h_pigeonhole; simp_all +decide [ mul_div_cancel₀, ne_of_gt ] ;
          exact_mod_cast this;
        obtain ⟨ S, hS₁, hS₂ ⟩ := h_pigeonhole; simp_all +decide [ distinctKillSets ] ;
        rcases hS₁.1 with ⟨ t, ht₁, rfl ⟩ ; exact ⟨ t, ht₁, hS₂ ⟩ ;
      -- By the properties of the greedy algorithm, the number of newly covered mutants is at least $|killedSet(t) \cap U_k|$.
      have h_new_covered : ((Finset.range (k + 1)).biUnion (fun i => killedSet sem oracle MS P {seq i})).card - ((Finset.range k).biUnion (fun i => killedSet sem oracle MS P {seq i})).card ≥ ((killedSet sem oracle MS P {t}) ∩ U_k).card := by
        have h_new_covered : ((killedSet sem oracle MS P {seq k}) \ (Finset.range k).biUnion (fun i => killedSet sem oracle MS P {seq i})).card ≥ ((killedSet sem oracle MS P {t}) ∩ U_k).card := by
          have := h_greedy k;
          refine' le_trans _ ( this.2 t ht.1 );
          refine Finset.card_le_card ?_;
          grind;
        rw [ Finset.range_add_one, Finset.biUnion_insert ];
        grind;
      rw [ ← mul_sub ];
      rw [ ge_iff_le, div_le_iff₀ ] at ht <;> norm_cast at *;
      rw [ Int.subNatNat_of_le ] <;> norm_cast;
      · nlinarith;
      · exact Finset.card_mono <| Finset.biUnion_subset_biUnion_of_subset_left _ <| Finset.range_mono <| Nat.le_succ _;
    field_simp;
    rw [ Finset.card_sdiff ] at h_card_U_k;
    rw [ Nat.cast_sub ] at h_card_U_k <;> norm_num at *;
    · exact h_card_U_k.trans ( by rw [ mul_sub ] ; exact add_le_add_left ( mod_cast Finset.card_mono <| Finset.inter_subset_left ) _ );
    · exact Finset.card_le_card fun x hx => by aesop;
  -- By definition of uncovered mutants, we have |uncovered_k| = |total_killable| - |covered_k|.
  have h_uncovered_def : ∀ k, ((uncovered sem oracle MS P T_univ seq k).card : ℝ) = ((distinctKillSets sem oracle MS P T_univ).biUnion id).card - ((Finset.range k).biUnion (fun i => killedSet sem oracle MS P {seq i})).card := by
    intros k
    simp [uncovered];
    rw [ Finset.card_sdiff ];
    rw [ Nat.cast_sub ];
    · congr! 2;
      refine' congr_arg Finset.card _;
      ext; simp [covered, distinctKillSets];
      exact fun x hx hx' => ⟨ _, ⟨ ⟨ seq x, h_greedy x |>.1, rfl ⟩, ⟨ _, hx' ⟩ ⟩, hx' ⟩;
    · exact Finset.card_le_card fun x hx => by aesop;
  simp_all +decide [ mul_sub, sub_mul ];
  have := h_rate k; rw [ div_le_iff₀ ] at this <;> nlinarith [ show ( Finset.card ( distinctKillSets sem oracle MS P T_univ ) : ℝ ) > 0 from Nat.cast_pos.mpr ( Finset.card_pos.mpr h_n_pos ), mul_inv_cancel₀ ( show ( Finset.card ( distinctKillSets sem oracle MS P T_univ ) : ℝ ) ≠ 0 from Nat.cast_ne_zero.mpr <| ne_of_gt <| Finset.card_pos.mpr h_n_pos ) ] ;

def SC (MS : MutationSystem D R) (P : Program D R) (T_univ : TestSuite D R) (seq : ℕ → Test D R) (k : ℕ) : ℝ :=
  let covered := (Finset.range k).biUnion (fun i => killedSet sem oracle MS P {seq i})
  let total_killable := (distinctKillSets sem oracle MS P T_univ).biUnion id
  if total_killable.card = 0 then 1 else (covered.card : ℝ) / (total_killable.card : ℝ)

theorem T4_7_convergence_rate_SC
    (MS : MutationSystem D R) (P : Program D R) (T_univ : TestSuite D R)
    (seq : ℕ → Test D R)
    (h_greedy : IsGreedySequence sem oracle MS P T_univ seq)
    (n : ℕ)
    (h_n : n = (distinctKillSets sem oracle MS P T_univ).card)
    (h_n_pos : n > 0) :
    ∀ k, SC sem oracle MS P T_univ seq k ≥ 1 - (1 - 1 / (n : ℝ))^k := by
      intro k
      have h_base : ((covered sem oracle MS P seq k).card : ℝ) ≥ ((distinctKillSets sem oracle MS P T_univ).biUnion id).card * (1 - (1 - 1 / (n : ℝ))^k) := by
        convert T4_7_convergence_rate sem oracle MS P T_univ seq h_greedy n h_n h_n_pos k using 1
      have h_div : SC sem oracle MS P T_univ seq k = (covered sem oracle MS P seq k).card / ((distinctKillSets sem oracle MS P T_univ).biUnion id).card := by
        -- By definition of SC, we know that SC is the ratio of the number of mutants covered by k tests to the total number of killable mutants.
        simp [SC];
        split_ifs <;> simp_all +decide [ Finset.ext_iff ];
        · obtain ⟨ x, hx ⟩ := h_n_pos; specialize ‹∀ a : Program D R, ∀ x ∈ distinctKillSets sem oracle MS P T_univ, a∉x› ( Classical.choose ( Finset.nonempty_of_ne_empty ( show x ≠ ∅ from by
                                                                                                                                                                              unfold distinctKillSets at hx; aesop; ) ) ) x hx; have := Classical.choose_spec ( Finset.nonempty_of_ne_empty ( show x ≠ ∅ from by
                                                                                                                                                                                                                                                                                  all_goals generalize_proofs at *;
                                                                                                                                                                                                                                                                                  exact Finset.Nonempty.ne_empty ‹_› ) ) ; aesop;
        · rfl
      rw [h_div]
      exact (by
      refine' le_div_iff₀' _ |>.2 _;
      · norm_num +zetaDelta at *;
        exact Exists.elim ( Finset.card_pos.mp ( by linarith ) ) fun x hx => ⟨ x, hx, Finset.mem_filter.mp hx |>.2 ⟩;
      · exact h_base)

