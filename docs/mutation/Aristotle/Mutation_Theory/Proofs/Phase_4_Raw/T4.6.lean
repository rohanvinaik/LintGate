/-
The KL divergence between two probability distributions is non-negative.
-/
theorem klDivergence_nonneg {α : Type*} [Fintype α] [DecidableEq α]
    (P Q : α → ℝ)
    (hP_nonneg : ∀ x, 0 ≤ P x)
    (hQ_pos : ∀ x, 0 < Q x)
    (hP_sum : ∑ x, P x = 1)
    (hQ_sum : ∑ x, Q x = 1) :
    0 ≤ klDivergence P Q := by
  have h_lower_bound := pinsker_sum_inequality P Q hP_nonneg hQ_pos hP_sum hQ_sum
  have h_sum_nonneg : 0 ≤ ∑ x, (P x - Q x)^2 / (P x + 2 * Q x) := by
    apply Finset.sum_nonneg
    intro x _
    apply div_nonneg (sq_nonneg _)
    apply add_nonneg (hP_nonneg x) (mul_nonneg (by norm_num) (le_of_lt (hQ_pos x)))
  linarith

