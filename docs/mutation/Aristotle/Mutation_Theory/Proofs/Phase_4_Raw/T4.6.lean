-/
def xlogx (x : ℝ) : ℝ :=
  if x = 0 then 0 else x * Real.log x

def klDivergence {α : Type*} [Fintype α] (p q : α → ℝ) : ℝ :=
  ∑ x, if p x = 0 then 0 else p x * Real.log (p x / q x)

def marginal (n : ℕ) (P : (Fin n → Bool) → ℝ) (i : Fin n) (b : Bool) : ℝ :=
  ∑ x : Fin n → Bool, if x i = b then P x else 0

def productDistribution (n : ℕ) (P : (Fin n → Bool) → ℝ) (x : Fin n → Bool) : ℝ :=
  ∏ i, marginal n P i (x i)

def mutualInformation (n : ℕ) (P : (Fin n → Bool) → ℝ) : ℝ :=
  klDivergence P (productDistribution n P)

