/-
The KL divergence is lower-bounded by a weighted sum of squared differences.
-/
theorem pinsker_sum_inequality {α : Type*} [Fintype α] [DecidableEq α]
    (P Q : α → ℝ)
    (hP_nonneg : ∀ x, 0 ≤ P x)
    (hQ_pos : ∀ x, 0 < Q x)
    (hP_sum : ∑ x, P x = 1)
    (hQ_sum : ∑ x, Q x = 1) :
    (3/2) * ∑ x, (P x - Q x)^2 / (P x + 2 * Q x) ≤ klDivergence P Q := by
      -- Applying the scalar inequality to each term in the sum, we get:
      have h_scalar : ∀ x, (P x - Q x)^2 / (P x + 2 * Q x) * (3 / 2) ≤ (if P x = 0 then 0 else P x * Real.log (P x / Q x)) - P x + Q x := by
        intro x
        by_cases hx : P x = 0;
        · simp +decide [ hx, hQ_pos x |> ne_of_gt ];
          rw [ div_mul_eq_mul_div, div_le_iff₀ ] <;> nlinarith only [ hQ_pos x ];
        · have := pinsker_scalar_inequality ( P x / Q x ) ( div_pos ( lt_of_le_of_ne ( hP_nonneg x ) ( Ne.symm hx ) ) ( hQ_pos x ) );
          field_simp at this;
          convert mul_le_mul_of_nonneg_right this ( show 0 ≤ Q x / 2 by linarith [ hQ_pos x ] ) using 1 <;> ring;
          · grind;
          · simp +decide [ hx, ne_of_gt ( hQ_pos x ) ] ; ring;
      simpa [ Finset.mul_sum _ _ _, mul_comm, Finset.sum_add_distrib, hP_sum, hQ_sum ] using Finset.sum_le_sum fun x ( hx : x ∈ Finset.univ ) => h_scalar x

/-
The square of the L1 distance is bounded by 3 times a weighted sum of squared differences.
-/
theorem pinsker_cauchy_schwarz {α : Type*} [Fintype α] [DecidableEq α]
    (P Q : α → ℝ)
    (hP_nonneg : ∀ x, 0 ≤ P x)
    (hQ_pos : ∀ x, 0 < Q x)
    (hP_sum : ∑ x, P x = 1)
    (hQ_sum : ∑ x, Q x = 1) :
