/-
Theorem 4.6: The combined detection probability is lower-bounded by the independent detection probability minus an error term bounded by the mutual information.
-/
theorem T4_6_cross_channel_independence_v15
    (n : ℕ)
    (P : (Fin n → Bool) → ℝ)
    (h_nonneg : ∀ x, 0 ≤ P x)
    (h_sum : ∑ x, P x = 1)
    (h_pos_marginal : ∀ i b, 0 < marginal n P i b) :
    combined_detection n P ≥ independent_detection n P - error_bound n P := by
  -- Let Q be the product distribution.
  let Q := productDistribution n P
  -- We establish properties of Q.
  have hQ_sum : ∑ x, Q x = 1 := productDistribution_sum_one n P h_sum h_pos_marginal
  have hQ_pos : ∀ x, 0 < Q x := by
    intro x
    simp [Q, productDistribution]
    apply Finset.prod_pos
    intro i _
    apply h_pos_marginal
  -- Let E be the failure event.
  let x_fail := system_failure n
  let E : Finset (Fin n → Bool) := {x_fail}
  -- Probability of failure under P and Q.
  have hP_fail : P x_fail = ∑ x ∈ E, P x := by simp [E]
  have hQ_fail : Q x_fail = ∑ x ∈ E, Q x := by simp [E]
  -- Bound the difference using L1 distance.
  have h_diff_l1 : |P x_fail - Q x_fail| ≤ (1/2) * ∑ x, |P x - Q x| := by
    rw [hP_fail, hQ_fail]
    exact prob_diff_le_half_l1 P Q h_sum hQ_sum E
  -- Bound L1 distance using Pinsker's inequality.
  have h_pinsker : ∑ x, |P x - Q x| ≤ Real.sqrt (2 * klDivergence P Q) :=
    pinsker_inequality P Q h_nonneg hQ_pos h_sum hQ_sum
  -- Combine bounds.
  have h_bound : |P x_fail - Q x_fail| ≤ (1/2) * Real.sqrt (2 * klDivergence P Q) := by
    apply le_trans h_diff_l1
    apply mul_le_mul_of_nonneg_left h_pinsker (by norm_num)
  -- Simplify the bound.
  have h_step : (1/2) * Real.sqrt (2 * klDivergence P Q) ≤ Real.sqrt (2 * klDivergence P Q) := by
    nth_rewrite 2 [← one_mul (Real.sqrt (2 * klDivergence P Q))]
    apply mul_le_mul_of_nonneg_right
    · norm_num
    · apply Real.sqrt_nonneg
  have h_final_bound_kl : |P x_fail - Q x_fail| ≤ Real.sqrt (2 * klDivergence P Q) :=
    le_trans h_bound h_step
  -- Convert to mutual information.
  have h_final_bound : |P x_fail - Q x_fail| ≤ error_bound n P := by
    unfold error_bound mutualInformation
    exact h_final_bound_kl
  -- Final inequality.
  unfold combined_detection independent_detection
  have h_Q_val : Q x_fail = ∏ i, marginal n P i false := by
    simp [Q, productDistribution, x_fail, system_failure]
  rw [← h_Q_val]
  simp [system_failure]
  -- P - Q <= |P - Q| <= ε
  have h_alg : P x_fail - Q x_fail ≤ |P x_fail - Q x_fail| := le_abs_self _
  have h_res : P x_fail - Q x_fail ≤ error_bound n P :=
    le_trans h_alg h_final_bound
  -- 1 - P ≥ 1 - Q - ε
  linarith

