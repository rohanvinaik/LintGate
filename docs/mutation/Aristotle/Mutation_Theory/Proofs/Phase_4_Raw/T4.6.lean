      simp_all +decide [ Finset.sum_add_distrib, ← Finset.mul_sum _ _ _ ] ; nlinarith

/-
Pinsker's inequality: the L1 distance between two probability distributions is bounded by the square root of twice their KL divergence.
-/
theorem pinsker_inequality {α : Type*} [Fintype α] [DecidableEq α]
    (P Q : α → ℝ)
    (hP_nonneg : ∀ x, 0 ≤ P x)
    (hQ_pos : ∀ x, 0 < Q x)
    (hP_sum : ∑ x, P x = 1)
    (hQ_sum : ∑ x, Q x = 1) :
    ∑ x, |P x - Q x| ≤ Real.sqrt (2 * klDivergence P Q) := by
      -- We have established two inequalities:
      -- 1. (3/2) * ∑ x, (P x - Q x)^2 / (P x + 2 * Q x) ≤ klDivergence P Q
      -- 2. (∑ x, |P x - Q x|)^2 ≤ 3 * ∑ x, (P x - Q x)^2 / (P x + 2 * Q x)
      have h1 := pinsker_sum_inequality P Q hP_nonneg hQ_pos hP_sum hQ_sum
      have h2 := pinsker_cauchy_schwarz P Q hP_nonneg hQ_pos hP_sum hQ_sum
      -- Combining these, we get (∑ x, |P x - Q x|)^2 ≤ 2 * klDivergence P Q
      have h_combined : (∑ x, |P x - Q x|)^2 ≤ 2 * klDivergence P Q := by
        linarith
      -- Taking the square root of both sides gives the result.
      exact Real.le_sqrt_of_sq_le h_combined

/-
Definitions for system failure, combined detection, independent detection, and the error bound.
-/
def system_failure (n : ℕ) : Fin n → Bool := fun _ => false

def combined_detection (n : ℕ) (P : (Fin n → Bool) → ℝ) : ℝ := 1 - P (system_failure n)

def independent_detection (n : ℕ) (P : (Fin n → Bool) → ℝ) : ℝ := 1 - ∏ i, marginal n P i false

def error_bound (n : ℕ) (P : (Fin n → Bool) → ℝ) : ℝ := Real.sqrt (2 * mutualInformation n P)

/-
Theorem 4.6 The cross-channel independence conditions. T2.4 assumes independent detection probabilities. Your ControlPlane runs 6 channels on the same codebase, so they're not independent in the probability-theory sense. But their failure modes are structurally uncorrelated — a type error doesn't predict a security vulnerability. Formalize: define a notion of "error-mode independence" weaker than probabilistic independence but strong enough for the union formula to hold approximately. The bound would look like: combined detection ≥ 1 - ∏(1 - pᵢ) - ε(correlation), where ε is bounded by the mutual information between channel outputs.
-/
theorem T4_6_cross_channel_independence
    (n : ℕ)
    (P : (Fin n → Bool) → ℝ)
    (h_nonneg : ∀ x, 0 ≤ P x)
    (h_sum : ∑ x, P x = 1)
    (h_pos_marginal : ∀ i b, 0 < marginal n P i b) :
    combined_detection n P ≥ independent_detection n P - error_bound n P := by
      -- By Pinsker's inequality, we have that the total variation distance between P and Q is bounded by sqrt(2 * I(P)).
      have h_pinsker : |(P (system_failure n)) - (∏ i, (marginal n P i false))| ≤ Real.sqrt (2 * (mutualInformation n P)) := by
        have h_pinsker : (∑ x, |P x - productDistribution n P x|) ≤ Real.sqrt (2 * (mutualInformation n P)) := by
          apply pinsker_inequality P (productDistribution n P) h_nonneg (fun x => by
            exact Finset.prod_pos fun i _ => h_pos_marginal i ( x i )) h_sum (by
          exact?);
        refine' le_trans _ h_pinsker;
        refine' le_trans _ ( Finset.single_le_sum ( fun x _ => abs_nonneg ( P x - productDistribution n P x ) ) ( Finset.mem_univ ( system_failure n ) ) ) ; aesop;
      unfold combined_detection independent_detection error_bound; linarith [ abs_le.mp h_pinsker ] ;

