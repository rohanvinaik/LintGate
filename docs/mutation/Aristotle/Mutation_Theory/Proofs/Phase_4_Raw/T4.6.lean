      -- Apply the Cauchy-Schwarz inequality to the vectors $u$ and $v$, where $u_x = |P_x - Q_x| / \sqrt{P_x + 2Q_x}$ and $v_x = \sqrt{P_x + 2Q_x}$.
      have h_cauchy_schwarz : (∑ x, abs (P x - Q x))^2 ≤ (∑ x, (abs (P x - Q x) / Real.sqrt (P x + 2 * Q x))^2) * (∑ x, (Real.sqrt (P x + 2 * Q x))^2) := by
        have h_cauchy_schwarz : ∀ (u v : α → ℝ), (∑ x, u x * v x)^2 ≤ (∑ x, u x^2) * (∑ x, v x^2) := by
          exact?;
