section Phase3_Adjunction_Helpers_Compose_Retry

variable {D1 R1 D2 R2 : Type}
variable [DecidableEq D1] [DecidableEq R1] [DecidableEq D2] [DecidableEq R2]

def compose (T1 : TestSuite D1 R1) (T2 : TestSuite D2 R2) : TestSuite (D1 × D2) (R1 × R2) :=
  (T1 ×ˢ T2).image (fun (t1, t2) => {id := t1.id + t2.id, input := (t1.input, t2.input)})

variable (sem1 : Program D1 R1 → D1 → R1)
variable (sem2 : Program D2 R2 → D2 → R2)
variable (sem : Program (D1 × D2) (R1 × R2) → (D1 × D2) → (R1 × R2))

variable (oracle1 : Test D1 R1 → R1 → Bool)
variable (oracle2 : Test D2 R2 → R2 → Bool)
variable (oracle : Test (D1 × D2) (R1 × R2) → (R1 × R2) → Bool)

variable (P1 : Program D1 R1) (P2 : Program D2 R2) (P : Program (D1 × D2) (R1 × R2))
variable (MS1 : MutationSystem D1 R1)
variable (MS2 : MutationSystem D2 R2)
variable (MS : MutationSystem (D1 × D2) (R1 × R2))
variable (inj1 : Program D1 R1 → Program (D1 × D2) (R1 × R2))
variable (inj2 : Program D2 R2 → Program (D1 × D2) (R1 × R2))

theorem killedSet_compose_decomposition
    (h_sem : ∀ x y, sem P (x, y) = (sem1 P1 x, sem2 P2 y))
    (h_oracle : ∀ t r, oracle t r = (oracle1 {id:=t.id, input:=t.input.1} r.1 && oracle2 {id:=t.id, input:=t.input.2} r.2))
    (h_oracle1_id : ∀ t t' r, t.input = t'.input → oracle1 t r = oracle1 t' r)
    (h_oracle2_id : ∀ t t' r, t.input = t'.input → oracle2 t r = oracle2 t' r)
    (h_mutants : MS.mutants P = (MS1.mutants P1).image inj1 ∪ (MS2.mutants P2).image inj2)
    (h_inj1_sem : ∀ m1 x y, sem (inj1 m1) (x, y) = (sem1 m1 x, sem2 P2 y))
    (h_inj2_sem : ∀ m2 x y, sem (inj2 m2) (x, y) = (sem1 P1 x, sem2 m2 y))
    (h_disjoint : Disjoint ((MS1.mutants P1).image inj1) ((MS2.mutants P2).image inj2))
    (h_inj1_inj : Function.Injective inj1)
    (h_inj2_inj : Function.Injective inj2)
    (h_P1_correct : ∀ t, passes sem1 oracle1 P1 t)
    (h_P2_correct : ∀ t, passes sem2 oracle2 P2 t)
    (T1 : TestSuite D1 R1) (T2 : TestSuite D2 R2)
    (h_T1_nonempty : T1.Nonempty) (h_T2_nonempty : T2.Nonempty) :
    killedSet sem oracle MS P (compose T1 T2) =
    (killedSet sem1 oracle1 MS1 P1 T1).image inj1 ∪
    (killedSet sem2 oracle2 MS2 P2 T2).image inj2 := by
  unfold killedSet at *; simp_all +decide [ Finset.ext_iff ] ;
  intro a; constructor <;> intro h; rcases h with ⟨ h₁ | h₁, h₂ ⟩ <;> simp_all +decide [ Finset.ext_iff, compose ] ;
  · rcases h₁ with ⟨ m1, hm1, rfl ⟩ ; rcases h₂ with ⟨ t, ⟨ a, b, ⟨ ha, hb ⟩, rfl ⟩, h₂ ⟩ ; simp_all +decide [ passes ] ;
    exact Or.inl ⟨ m1, ⟨ hm1, a, ha, by specialize h_oracle1_id ⟨ a.id + b.id, a.input ⟩ a ( sem1 m1 a.input ) ; aesop ⟩, rfl ⟩ ;
  · obtain ⟨ t, ⟨ a, b, ⟨ ha, hb ⟩, rfl ⟩, ht ⟩ := h₂; simp_all +decide [ passes ] ;
    rcases h₁ with ⟨ m, hm, rfl ⟩ ; simp_all +decide [ Finset.ext_iff, compose ] ;
    exact Or.inr ⟨ m, ⟨ hm, b, hb, by simpa [ h_oracle2_id ⟨ a.id + b.id, b.input ⟩ b _ rfl ] using ht ⟩, rfl ⟩;
  · obtain ⟨ m1, ⟨ hm1, t1, ht1, hm1' ⟩, rfl ⟩ | ⟨ m2, ⟨ hm2, t2, ht2, hm2' ⟩, rfl ⟩ := h <;> simp_all +decide [ passes ] ; (
    obtain ⟨ t2, ht2 ⟩ := h_T2_nonempty;
    refine' ⟨ Or.inl ⟨ m1, hm1, rfl ⟩, _ ⟩;
    use ⟨ t1.id + t2.id, ( t1.input, t2.input ) ⟩ ; simp_all +decide [ compose ] ;
    exact ⟨ ⟨ t1, t2, ⟨ ht1, ht2 ⟩, rfl, rfl, rfl ⟩, by simpa using h_oracle1_id ⟨ t1.id + t2.id, t1.input ⟩ t1 ( sem1 m1 t1.input ) rfl ▸ hm1' ⟩);
    refine' ⟨ Or.inr ⟨ m2, hm2, rfl ⟩, _ ⟩;
    obtain ⟨ t1, ht1 ⟩ := h_T1_nonempty;
    use ⟨ t1.id + t2.id, ( t1.input, t2.input ) ⟩ ; simp_all +decide [ compose ] ;
    exact ⟨ ⟨ t1, t2, ⟨ ht1, ht2 ⟩, rfl, rfl, rfl ⟩, by simpa using h_oracle2_id ⟨ t1.id + t2.id, t2.input ⟩ t2 ( sem2 m2 t2.input ) rfl |> fun h => h.symm ▸ hm2' ⟩

end Phase3_Adjunction_Helpers_Compose_Retry

/-
Decomposition and specification are adjoint functors. Decomposing a function corresponds to projecting the test space, and composing components corresponds to taking the product of test spaces. This adjunction formalizes why decomposition simplifies specification.
-/
section Phase3_Adjunction_Main

variable {D1 R1 D2 R2 : Type}
variable [DecidableEq D1] [DecidableEq R1] [DecidableEq D2] [DecidableEq R2]

variable (sem1 : Program D1 R1 → D1 → R1)
variable (sem2 : Program D2 R2 → D2 → R2)
variable (sem : Program (D1 × D2) (R1 × R2) → (D1 × D2) → (R1 × R2))

variable (oracle1 : Test D1 R1 → R1 → Bool)
variable (oracle2 : Test D2 R2 → R2 → Bool)
variable (oracle : Test (D1 × D2) (R1 × R2) → (R1 × R2) → Bool)

variable (P1 : Program D1 R1) (P2 : Program D2 R2) (P : Program (D1 × D2) (R1 × R2))
variable (MS1 : MutationSystem D1 R1)
variable (MS2 : MutationSystem D2 R2)
variable (MS : MutationSystem (D1 × D2) (R1 × R2))
variable (inj1 : Program D1 R1 → Program (D1 × D2) (R1 × R2))
variable (inj2 : Program D2 R2 → Program (D1 × D2) (R1 × R2))

theorem T3_3_decomposition_specification_adjoint
    (h_sem : ∀ x y, sem P (x, y) = (sem1 P1 x, sem2 P2 y))
    (h_oracle : ∀ t r, oracle t r = (oracle1 {id:=t.id, input:=t.input.1} r.1 && oracle2 {id:=t.id, input:=t.input.2} r.2))
    (h_oracle1_id : ∀ t t' r, t.input = t'.input → oracle1 t r = oracle1 t' r)
    (h_oracle2_id : ∀ t t' r, t.input = t'.input → oracle2 t r = oracle2 t' r)
    (h_mutants : MS.mutants P = (MS1.mutants P1).image inj1 ∪ (MS2.mutants P2).image inj2)
    (h_inj1_sem : ∀ m1 x y, sem (inj1 m1) (x, y) = (sem1 m1 x, sem2 P2 y))
    (h_inj2_sem : ∀ m2 x y, sem (inj2 m2) (x, y) = (sem1 P1 x, sem2 m2 y))
    (h_disjoint : Disjoint ((MS1.mutants P1).image inj1) ((MS2.mutants P2).image inj2))
    (h_inj1_inj : Function.Injective inj1)
    (h_inj2_inj : Function.Injective inj2)
    (h_P1_correct : ∀ t, passes sem1 oracle1 P1 t)
    (h_P2_correct : ∀ t, passes sem2 oracle2 P2 t)
    (T : TestSuite (D1 × D2) (R1 × R2))
    (T1 : TestSuite D1 R1) (T2 : TestSuite D2 R2)
    (h_T1_nonempty : T1.Nonempty) (h_T2_nonempty : T2.Nonempty) :
    refines sem oracle MS P T (compose T1 T2) ↔
    refines sem1 oracle1 MS1 P1 (project T).1 T1 ∧
    refines sem2 oracle2 MS2 P2 (project T).2 T2 := by
  unfold refines;
  rw [killedSet_decomposition_under_correctness, killedSet_compose_decomposition];
  any_goals assumption;
  simp +decide [ Finset.subset_iff, Finset.image_subset_iff ];
  constructor <;> intro h;
  · constructor <;> intro x hx <;> contrapose! h;
    · use inj1 x;
      simp_all +decide [ Finset.disjoint_left, h_inj1_inj.eq_iff, h_inj2_inj.eq_iff ];
      exact fun y hy => h_disjoint x ( Finset.mem_filter.mp hx |>.1 ) y ( Finset.mem_filter.mp hy |>.1 );
    · use inj2 x;
      simp_all +decide [ Finset.disjoint_left, h_inj1_inj.eq_iff, h_inj2_inj.eq_iff ];
      exact fun y hy => Ne.symm ( h_disjoint _ ( Finset.mem_filter.mp hy |>.1 ) _ ( Finset.mem_filter.mp hx |>.1 ) );
  · rintro x ( ⟨ a, ha, rfl ⟩ | ⟨ a, ha, rfl ⟩ ) <;> [ exact Or.inl ⟨ a, h.1 ha, rfl ⟩ ; exact Or.inr ⟨ a, h.2 ha, rfl ⟩ ]

end Phase3_Adjunction_Main

section Check_Compose

variable {D1 R1 D2 R2 : Type}
variable [DecidableEq D1] [DecidableEq R1] [DecidableEq D2] [DecidableEq R2]

#check compose (D1:=D1) (R1:=R1) (D2:=D2) (R2:=R2)
#check killedSet_compose_decomposition (D1:=D1) (R1:=R1) (D2:=D2) (R2:=R2)

end Check_Compose