section Phase3_Adjunction_Helpers_Correct

variable {D1 R1 D2 R2 : Type}
variable [DecidableEq D1] [DecidableEq R1] [DecidableEq D2] [DecidableEq R2]

variable (sem1 : Program D1 R1 → D1 → R1)
variable (sem2 : Program D2 R2 → D2 → R2)
variable (sem : Program (D1 × D2) (R1 × R2) → (D1 × D2) → (R1 × R2))

variable (oracle1 : Test D1 R1 → R1 → Bool)
variable (oracle2 : Test D2 R2 → R2 → Bool)
variable (oracle : Test (D1 × D2) (R1 × R2) → (R1 × R2) → Bool)

variable (P1 : Program D1 R1) (P2 : Program D2 R2) (P : Program (D1 × D2) (R1 × R2))
variable (MS1 : MutationSystem D1 R1)
variable (MS2 : MutationSystem D2 R2)
variable (MS : MutationSystem (D1 × D2) (R1 × R2))
variable (inj1 : Program D1 R1 → Program (D1 × D2) (R1 × R2))
variable (inj2 : Program D2 R2 → Program (D1 × D2) (R1 × R2))

theorem killedSet_decomposition_under_correctness
    (h_sem : ∀ x y, sem P (x, y) = (sem1 P1 x, sem2 P2 y))
    (h_oracle : ∀ t r, oracle t r = (oracle1 {id:=t.id, input:=t.input.1} r.1 && oracle2 {id:=t.id, input:=t.input.2} r.2))
    (h_mutants : MS.mutants P = (MS1.mutants P1).image inj1 ∪ (MS2.mutants P2).image inj2)
    (h_inj1_sem : ∀ m1 x y, sem (inj1 m1) (x, y) = (sem1 m1 x, sem2 P2 y))
    (h_inj2_sem : ∀ m2 x y, sem (inj2 m2) (x, y) = (sem1 P1 x, sem2 m2 y))
    (h_disjoint : Disjoint ((MS1.mutants P1).image inj1) ((MS2.mutants P2).image inj2))
    (h_inj1_inj : Function.Injective inj1)
    (h_inj2_inj : Function.Injective inj2)
    (h_P1_correct : ∀ t, passes sem1 oracle1 P1 t)
    (h_P2_correct : ∀ t, passes sem2 oracle2 P2 t)
    (T : TestSuite (D1 × D2) (R1 × R2)) :
    killedSet sem oracle MS P T =
    (killedSet sem1 oracle1 MS1 P1 (project T).1).image inj1 ∪
    (killedSet sem2 oracle2 MS2 P2 (project T).2).image inj2 := by
  refine' Finset.Subset.antisymm _ _;
  · exact?;
  · intro m hm;
    simp_all +decide [ Finset.mem_union, Finset.mem_image ];
    rcases hm with ( ⟨ m1, hm1, rfl ⟩ | ⟨ m2, hm2, rfl ⟩ ) <;> simp_all +decide [ passes, killedSet ];
    · exact ⟨ Or.inl ⟨ m1, hm1.1, rfl ⟩, by rcases hm1.2 with ⟨ t, ht, h ⟩ ; obtain ⟨ u, hu, rfl ⟩ := Finset.mem_image.mp ht; exact ⟨ u, hu, h ⟩ ⟩;
    · unfold project at hm2; aesop;

end Phase3_Adjunction_Helpers_Correct

