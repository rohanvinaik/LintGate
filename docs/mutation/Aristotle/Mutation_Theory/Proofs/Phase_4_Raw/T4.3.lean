  simp_all +decide [ Finset.mem_union, Finset.mem_image, killedSet ];
  unfold passes at *; simp_all +decide [ Finset.mem_image ] ;
  exact ⟨ Or.inl ⟨ m1, hm1.1, rfl ⟩, by rcases hm1.2 with ⟨ t, ht1, ht2 ⟩ ; rcases Finset.mem_image.mp ht1 with ⟨ t', ht3, rfl ⟩ ; exact ⟨ t', ht3, ht2 ⟩ ⟩

