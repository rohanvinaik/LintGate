/-
This module formalizes the Tier 3 theorems (T3.1 - T3.6) regarding function decomposition and specification completeness.
It includes:
- T3.1: Separable Independent Testing (changes in one component propagate if the combiner is injective).
- T3.2: Product vs Sum (decomposition reduces the state space size, with a minor correction for the 2x2 case).
- T3.3: Decomposition Reduces Burden (the central conjecture: decomposition eliminates interaction terms).
- T3.4: Irreducible Functions Exist (XOR factors through non-identity components, showing decomposition is non-trivial).
- T3.5: Universal Stronger than Finite (finite tests cannot prove universal properties on infinite domains).
- T3.6: Weighted Distinguishes (higher oracle levels yield higher weighted scores).
- Definition of `OracleLevel` and its linear order.
-/

import Mathlib

set_option linter.mathlibStandardSet false

open scoped BigOperators
open scoped Real
open scoped Nat
open scoped Classical
open scoped Pointwise

set_option maxHeartbeats 0
set_option maxRecDepth 4000
set_option synthInstance.maxHeartbeats 20000
set_option synthInstance.maxSize 128

set_option relaxedAutoImplicit false
set_option autoImplicit false

noncomputable section

/-
If interaction > 0, then survA + survB < survA + survB + interaction.
-/
theorem T3_3_decomposition_reduces_burden
    (survA survB interaction : ℕ)
    (h_interaction_pos : 0 < interaction)
    /- Before decomposition: total tests needed includes interaction -/
    /- After decomposition: interaction term vanishes -/
    : survA + survB < survA + survB + interaction := by
  linarith

/-
XOR factors through non-identity components (specifically `not`).
-/
def XOR (x y : Bool) : Bool := x ≠ y

theorem T3_4_XOR_factors_through_not :
    ∃ (h : Bool → Bool → Bool) (g₁ g₂ : Bool → Bool),
      (∀ x y, XOR x y = h (g₁ x) (g₂ y)) ∧ g₁ ≠ id ∧ g₂ ≠ id := by
  exists fun x y => x ≠ y, fun x => !x, fun x => !x

/-
If a property P holds on a finite set S but is not universally true, there exists a counterexample outside S.
-/
theorem T3_5_universal_stronger_than_finite
    {α : Type} [Infinite α]
    (S : Finset α)
    (P : α → Prop)
    (h_holds_on_S : ∀ x ∈ S, P x)
    (h_not_universal : ¬ ∀ x, P x)
    : ∃ x, x ∉ S ∧ ¬ P x := by
  grind +ring

/-
Definition of OracleLevel and its LinearOrder instance using lift'.
-/
inductive OracleLevel
  | CRASH
  | TYPE
  | STRUCTURAL
  | SHAPE
  | VALUE
  | PROPERTY
  deriving Repr, DecidableEq, Inhabited

def OracleLevel.toNat : OracleLevel → Nat
  | CRASH => 0
  | TYPE => 1
  | STRUCTURAL => 2
  | SHAPE => 3
  | VALUE => 4
  | PROPERTY => 5

theorem OracleLevel.toNat_injective : Function.Injective OracleLevel.toNat := by
  intro a b h
  cases a <;> cases b <;> try (simp [OracleLevel.toNat] at h) <;> try rfl
  all_goals contradiction

instance : LinearOrder OracleLevel := LinearOrder.lift' OracleLevel.toNat OracleLevel.toNat_injective

/-
If a weighting function is strictly monotone with respect to oracle levels, then a higher oracle level yields a strictly higher weighted score for the same number of kills (assuming kills > 0).
-/
theorem T3_6_weighted_distinguishes
    (kills : ℕ)
    (level₁ level₂ : OracleLevel)
    (w : OracleLevel → ℚ)
    (h_monotone : ∀ l₁ l₂, l₁ < l₂ → w l₁ < w l₂)
    (h_kills_pos : 0 < kills)
    (h_level_lt : level₁ < level₂)
    : (kills : ℚ) * w level₁ < (kills : ℚ) * w level₂ := by
  exact mul_lt_mul_of_pos_left ( h_monotone _ _ h_level_lt ) ( Nat.cast_pos.mpr h_kills_pos )

/-
If a function h is injective in its first argument, then a change in the first component g₁ propagates to the output of h, assuming the second component g₂ is fixed.
-/
theorem T3_1_separable_independent_testing
    {α β γ δ : Type}
    (h : β → γ → δ)
    (g₁ g₁' : α → β)
    (g₂ : α → γ)
    (x : α)
    (h_inj_left : ∀ c, Function.Injective (fun b => h b c))
    (h_mutant_diff : g₁ x ≠ g₁' x)
    : h (g₁ x) (g₂ x) ≠ h (g₁' x) (g₂ x) := by
  exact h_inj_left _ |> fun h => h.ne h_mutant_diff

/-
For a, b > 1, if not both are 2, then a + b < a * b.
-/
theorem T3_2_product_vs_sum
    (a b : ℕ)
    (ha : 1 < a)
    (hb : 1 < b)
    (h_not_2_2 : ¬(a = 2 ∧ b = 2))
    : a + b < a * b := by
  rcases a with ( _ | _ | _ | a ) <;> rcases b with ( _ | _ | _ | b ) <;> norm_num at * ; nlinarith;
  · linarith;
  · nlinarith