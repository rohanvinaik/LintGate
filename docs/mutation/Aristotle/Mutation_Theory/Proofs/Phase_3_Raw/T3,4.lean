/-
We proved T3.4: Irreducible Functions Exist.
The theorem demonstrates that there exists a function on `Bool × Bool` (specifically `Bool.xor` or equality) that cannot be factored into `h(g₁(x), g₂(y))` if either `g₁` or `g₂` is not injective.
This formalizes the intuition that some functions have essential coupling between their inputs that is destroyed by lossy independent processing.
The proof relies on the finite nature of `Bool` and is discharged by decision procedures.
-/

import Mathlib

set_option linter.mathlibStandardSet false

open scoped BigOperators
open scoped Real
open scoped Nat
open scoped Classical
open scoped Pointwise

set_option maxHeartbeats 0
set_option maxRecDepth 4000
set_option synthInstance.maxHeartbeats 20000
set_option synthInstance.maxSize 128

set_option relaxedAutoImplicit false
set_option autoImplicit false

noncomputable section

#check Bool.xor

/-
There exist functions (like XOR or Equality) that cannot be decomposed into independent components without at least one component being an isomorphism (i.e., no information loss). This captures the idea of 'irreducible' functions where the interaction is essential. Note: The original condition 'g ≠ id' is insufficient for Bool as 'not' is a non-identity isomorphism; we use '¬ Injective' to represent lossy decomposition.
-/
theorem T3_4_irreducible_functions_exist :
    ∃ (f : Bool × Bool → Bool),
      ¬ ∃ (g₁ : Bool → Bool) (g₂ : Bool → Bool) (h : Bool → Bool → Bool),
        (∀ x y, f (x, y) = h (g₁ x) (g₂ y)) ∧
        (¬ Function.Injective g₁ ∨ ¬ Function.Injective g₂) := by
  simp_all +decide [ Function.Injective ]