/-
Formalization of Oracle Levels and Weighted Specification Completeness.

This module defines the `OracleLevel` hierarchy and proves that a weighted specification completeness
metric, using strictly monotone weights for oracle levels, can distinguish test suites that an
unweighted metric (counting only kills) would consider equivalent.

Key definitions:
- `OracleLevel`: Enumeration of oracle strengths (CRASH, TYPE, STRUCTURAL, SHAPE, VALUE, PROPERTY).
- `T3_6_weighted_distinguishes`: Theorem showing weighted scores strictly increase with oracle level.

-/

import Mathlib

set_option linter.mathlibStandardSet false

open scoped BigOperators
open scoped Real
open scoped Nat
open scoped Classical
open scoped Pointwise

set_option maxHeartbeats 0
set_option maxRecDepth 4000
set_option synthInstance.maxHeartbeats 20000
set_option synthInstance.maxSize 128

set_option relaxedAutoImplicit false
set_option autoImplicit false

noncomputable section

/-
The set of oracle levels and a mapping to natural numbers to define their order.
-/
inductive OracleLevel
  | CRASH
  | TYPE
  | STRUCTURAL
  | SHAPE
  | VALUE
  | PROPERTY
  deriving Repr, DecidableEq

def OracleLevel.toNat : OracleLevel → ℕ
  | CRASH => 0
  | TYPE => 1
  | STRUCTURAL => 2
  | SHAPE => 3
  | VALUE => 4
  | PROPERTY => 5

/-
Defining the linear order on OracleLevel by lifting the order from natural numbers.
-/
instance : LinearOrder OracleLevel :=
  LinearOrder.lift' OracleLevel.toNat (fun x y => by cases x <;> cases y <;> simp [OracleLevel.toNat])

/-
If we extend the specification completeness metric to weight kills by oracle level, then the weighted metric agrees with the unweighted metric when all kills are at the same level, and strictly distinguishes suites that the unweighted metric considers equal when oracle levels differ.
-/
theorem T3_6_weighted_distinguishes
    (w : OracleLevel → ℚ)
    (h_monotone : ∀ a b : OracleLevel, a < b → w a < w b)
    (h_pos : ∀ a, 0 < w a)
    /- Two suites with same kill count but different level distributions -/
    (kills : ℕ)
    (level₁ level₂ : OracleLevel)
    (h_diff : level₁ < level₂) :
    (kills : ℚ) * w level₁ < (kills : ℚ) * w level₂ ∨ kills = 0 := by
  exact Classical.or_iff_not_imp_right.2 fun h => mul_lt_mul_of_pos_left ( h_monotone _ _ h_diff ) ( Nat.cast_pos.2 ( Nat.pos_of_ne_zero h ) )