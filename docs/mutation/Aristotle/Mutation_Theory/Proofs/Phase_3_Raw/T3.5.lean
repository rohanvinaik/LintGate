set_option autoImplicit false

noncomputable section

/-
If a property P does not hold for all elements, but holds for all elements in a finite set S, then there exists an element outside S where P does not hold.
-/
theorem T3_5_universal_stronger_than_finite
    {α : Type} [Infinite α] (P : α → Prop)
    (S : Finset α)
    (h_not_all : ¬ ∀ x, P x)
    (h_holds_on_S : ∀ x ∈ S, P x) :
    ∃ x, x ∉ S ∧ ¬ P x := by
  contrapose! h_not_all;
  exact fun x => if hx : x ∈ S then h_holds_on_S x hx else h_not_all x hx