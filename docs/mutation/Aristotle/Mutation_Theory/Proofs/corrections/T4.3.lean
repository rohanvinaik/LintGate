def Program (D R : Type) : Type := ℕ

instance (D R : Type) : DecidableEq (Program D R) := inferInstanceAs (DecidableEq ℕ)

def Test (D R : Type) : Type := D

def TestSuite (D R : Type) : Type := Finset (Test D R)

structure MutationSystem (D R : Type) where
  mutants : Program D R → Finset (Program D R)

def passes {D R : Type} (sem : Program D R → D → R) (oracle : Test D R → R → Bool) (p : Program D R) (t : Test D R) : Bool :=
  oracle t (sem p t)

def killedSet {D R : Type} [DecidableEq D] (sem : Program D R → D → R) (oracle : Test D R → R → Bool) (MS : MutationSystem D R) (p : Program D R) (T : Finset (Test D R)) : Finset (Program D R) :=
  (MS.mutants p).filter (λ m => ∃ t ∈ T, passes sem oracle m t = false)

variable {D₁ D₂ R₁ R₂ : Type}
variable [DecidableEq D₁] [DecidableEq D₂]

def test_project1 (t : Test (D₁ × D₂) (R₁ × R₂)) : Test D₁ R₁ := t.1
def test_project2 (t : Test (D₁ × D₂) (R₁ × R₂)) : Test D₂ R₂ := t.2

def project (T : Finset (Test (D₁ × D₂) (R₁ × R₂))) : Finset (Test D₁ R₁) × Finset (Test D₂ R₂) :=
  (T.image test_project1, T.image test_project2)

def oracle_product (oracle₁ : Test D₁ R₁ → R₁ → Bool) (oracle₂ : Test D₂ R₂ → R₂ → Bool) : Test (D₁ × D₂) (R₁ × R₂) → (R₁ × R₂) → Bool :=
  λ t r => oracle₁ t.1 r.1 && oracle₂ t.2 r.2

