open Classical in
def refines (sem : Program D R → D → R) (oracle : Test D R → R → Bool) (MS : MutationSystem D R) (P : Program D R) (T₁ T₂ : TestSuite D R) :=
  killedSet sem oracle MS P T₁ ⊆ killedSet sem oracle MS P T₂

def trueEquiv (sem : Program D R → D → R) (P₁ P₂ : Program D R) :=
  ∀ x, sem P₁ x = sem P₂ x

def mutationScore (killed total : ℕ) : ℚ :=
