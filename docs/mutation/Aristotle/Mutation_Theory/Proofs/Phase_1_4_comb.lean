theorem T1_14_optimization_safety_mono (O₁ O₂ : OptimizationType) (achievedLevel : OracleLevel) :
  O₁.requiredLevel ≤ O₂.requiredLevel → O₂.requiredLevel ≤ achievedLevel → O₁.requiredLevel ≤ achievedLevel := by
  exact fun h₁ h₂ => le_trans h₁ h₂

structure SynthState (D R : Type) where
  tests : TestSuite D R
  survivors : Finset (Program D R)

structure SynthOperator (D R : Type) where
  step : SynthState D R → SynthState D R
  tests_monotone : ∀ s, s.tests ⊆ (step s).tests
  surv_antitone : ∀ s, (step s).survivors ⊆ s.survivors

def iterSynth (op : SynthOperator D R) (s₀ : SynthState D R) (n : Nat) : SynthState D R :=
  match n with
  | 0 => s₀
  | k + 1 => op.step (iterSynth op s₀ k)

/-
Tests Grow Monotonically: For synthesis operator op and initial state s₀, if n ≤ m then (iterSynth op s₀ n).tests ⊆ (iterSynth op s₀ m).tests.
-/
theorem T2_1_tests_grow_monotonically (op : SynthOperator D R) (s₀ : SynthState D R) (n m : Nat) (h : n ≤ m) :
  (iterSynth op s₀ n).tests ⊆ (iterSynth op s₀ m).tests := by
  induction' h with k hk ih;
  · rfl;
  · exact Set.Subset.trans ih ( op.tests_monotone _ )

/-
Survivors Shrink Monotonically: If n ≤ m then (iterSynth op s₀ m).survivors ⊆ (iterSynth op s₀ n).survivors.
-/
theorem T2_2_survivors_shrink_monotonically (op : SynthOperator D R) (s₀ : SynthState D R) (n m : Nat) (h : n ≤ m) :
  (iterSynth op s₀ m).survivors ⊆ (iterSynth op s₀ n).survivors := by
  induction' h with k hk ih;
  · rfl;
  · exact Set.Subset.trans ( op.surv_antitone _ ) ih

/-
Termination Bound: There exists N ≤ s₀.survivors.card such that the survivors stabilize at step N.
-/
theorem T2_3_termination_bound (op : SynthOperator D R) (s₀ : SynthState D R) :
  ∃ N, N ≤ s₀.survivors.card ∧ (iterSynth op s₀ (N+1)).survivors = (iterSynth op s₀ N).survivors := by
  by_contra! h;
  have h_card_decr : ∀ n ≤ s₀.survivors.card, (iterSynth op s₀ n).survivors.card > (iterSynth op s₀ (n + 1)).survivors.card := by
    intro n hn
    specialize h n hn
    have h_card_lt : (iterSynth op s₀ (n + 1)).survivors ⊂ (iterSynth op s₀ n).survivors := by
      exact lt_of_le_of_ne ( op.surv_antitone _ ) h
    exact Finset.card_lt_card h_card_lt;
  have h_card_decr_seq : ∀ n ≤ s₀.survivors.card, (iterSynth op s₀ n).survivors.card ≤ s₀.survivors.card - n := by
    intro n hn
    induction' n with n ih;
    · rfl;
    · exact Nat.le_sub_one_of_lt ( lt_of_lt_of_le ( h_card_decr n ( Nat.le_of_succ_le hn ) ) ( ih ( Nat.le_of_succ_le hn ) ) );
  specialize h_card_decr_seq s₀.survivors.card le_rfl ; specialize h_card_decr s₀.survivors.card le_rfl ; aesop;

/-
Combined Detection is a Valid Probability: If each pᵢ ∈ [0,1], then combined := 1 - ∏(1 - pᵢ) satisfies 0 ≤ combined ≤ 1.
-/
theorem T2_4_combined_detection_valid_prob {ι : Type} (s : Finset ι) (p : ι → ℝ) (h_prob : ∀ i ∈ s, 0 ≤ p i ∧ p i ≤ 1) :
  let combined := 1 - ∏ i ∈ s, (1 - p i)
  0 ≤ combined ∧ combined ≤ 1 := by
  exact ⟨ sub_nonneg.2 <| Finset.prod_le_one ( fun _ _ => sub_nonneg.2 <| h_prob _ ‹_› |>.2 ) fun _ _ => sub_le_self _ <| h_prob _ ‹_› |>.1, sub_le_self _ <| Finset.prod_nonneg fun _ _ => sub_nonneg.2 <| h_prob _ ‹_› |>.2 ⟩

/-
More Signals Improve Detection: If each pᵢ ∈ [0,1) and 0 < p_new ≤ 1, then ∏(1 - pᵢ) × (1 - p_new) < ∏(1 - pᵢ).
-/
theorem T2_5_more_signals_improve_detection {ι : Type} (s : Finset ι) (p : ι → ℝ) (p_new : ℝ) (h_prob : ∀ i ∈ s, 0 ≤ p i ∧ p i < 1) (h_new : 0 < p_new ∧ p_new ≤ 1) :
  (∏ i ∈ s, (1 - p i)) * (1 - p_new) < ∏ i ∈ s, (1 - p i) := by
  exact mul_lt_of_lt_one_right ( Finset.prod_pos fun i hi => sub_pos.mpr ( h_prob i hi |>.2 ) ) ( sub_lt_self _ h_new.1 )

/-
Bounded Aggregate Miss: If each miss_prob i ≤ ε, then ∑ miss_prob ≤ k × ε.
-/
theorem T2_6_bounded_aggregate_miss {ι : Type} (s : Finset ι) (miss_prob : ι → ℝ) (ε : ℝ) (h_bound : ∀ i ∈ s, miss_prob i ≤ ε) :
  ∑ i ∈ s, miss_prob i ≤ s.card * ε := by
