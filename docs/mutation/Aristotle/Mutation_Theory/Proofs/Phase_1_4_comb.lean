  have := @ComputablePred.rice₂;
  contrapose! this;
  refine' ⟨ { c | ∀ n, c.eval n = some 0 }, _, _ ⟩ <;> norm_num [ funext_iff ];
  · aesop;
  · refine' Or.inl ⟨ _, _, _ ⟩;
    · refine' ⟨ _, _ ⟩;
      exact?;
      convert hf.comp ( Computable.pair ( Computable.id ) ( Computable.const ( Nat.Partrec.Code.const 0 ) ) ) using 1 ; aesop;
    · use Nat.Partrec.Code.const 0; simp [Nat.Partrec.Code.eval];
    · norm_num [ Set.ext_iff ];
      exact ⟨ Nat.Partrec.Code.succ, 0, by simp +decide [ Nat.Partrec.Code.eval ] ⟩)

/-
Separable Independent Testing: If g₁ ≠ g₁' on some x*, and h is injective in its first argument, then h(g₁(x*), g₂(x₂)) ≠ h(g₁'(x*), g₂(x₂)) for any x₂.
