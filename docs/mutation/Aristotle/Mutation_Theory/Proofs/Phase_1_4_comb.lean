/-
Greedy Set Cover Approximation Ratio: The greedy algorithm uses at most opt × (ln n + 1) sets.
-/
structure SetCoverInstance (α β : Type) [DecidableEq α] where
  domain : Finset α
  sets : β → Finset α

def isGreedyCover {α β : Type} [DecidableEq α] (inst : SetCoverInstance α β) (seq : Nat → β) (k : Nat) : Prop :=
  ∀ i < k, ∀ b,
    ((inst.sets (seq i)) \ (Finset.univ.biUnion (fun j : Fin i => inst.sets (seq j)))).card ≥
    ((inst.sets b) \ (Finset.univ.biUnion (fun j : Fin i => inst.sets (seq j)))).card

noncomputable def optimalCoverSize {α β : Type} [DecidableEq α] (inst : SetCoverInstance α β) : Nat :=
  sInf { k | ∃ seq : Fin k → β, inst.domain ⊆ Finset.univ.biUnion (fun i => inst.sets (seq i)) }

class GreedySetCoverTheory where
  greedy_bound : ∀ {α β : Type} [DecidableEq α] (inst : SetCoverInstance α β) (seq : Nat → β) (k : Nat),
    isGreedyCover inst seq k →
    inst.domain ⊆ (Finset.range k).biUnion (fun i => inst.sets (seq i)) →
    (k : ℝ) ≤ (optimalCoverSize inst : ℝ) * (Real.log inst.domain.card + 1)

theorem T2_8_greedy_set_cover_ratio [GreedySetCoverTheory] {α β : Type} [DecidableEq α] (inst : SetCoverInstance α β) (seq : Nat → β) (k : Nat)
    (h_greedy : isGreedyCover inst seq k)
    (h_cover : inst.domain ⊆ (Finset.range k).biUnion (fun i => inst.sets (seq i))) :
    (k : ℝ) ≤ (optimalCoverSize inst : ℝ) * (Real.log inst.domain.card + 1) :=
  GreedySetCoverTheory.greedy_bound inst seq k h_greedy h_cover

