theorem T3_1_separable_independent_testing
  {D₁ D₂ R₁ R₂ R : Type}
  (g₁ g₁' : D₁ → R₁)
  (g₂ : D₂ → R₂)
  (h : R₁ → R₂ → R)
  (x_star : D₁)
  (x₂ : D₂)
  (h_diff : g₁ x_star ≠ g₁' x_star)
  (h_inj : ∀ (r₁ r₁' : R₁) (r₂ : R₂), h r₁ r₂ = h r₁' r₂ → r₁ = r₁') :
  h (g₁ x_star) (g₂ x₂) ≠ h (g₁' x_star) (g₂ x₂) := by
  exact fun h' => h_diff <| h_inj _ _ _ h'

/-
Product vs Sum: If a > 1 and b > 1, then a + b ≤ a × b.
-/
theorem T3_2_product_vs_sum (a b : Nat) (ha : 1 < a) (hb : 1 < b) :
  a + b ≤ a * b := by
  nlinarith

/-
Decomposition Reduces Burden: survA + survB < survA + survB + interaction when interaction > 0.
-/
theorem T3_3_decomposition_reduces_burden (survA survB interaction : ℚ) (h_interaction : 0 < interaction) :
  survA + survB < survA + survB + interaction := by
  grind

/-
Irreducible Functions Exist: There exists f : Bool × Bool → Bool such that no factorization through non-injective component functions exists.
-/
theorem T3_4_irreducible_functions_exist :
  ∃ f : Bool × Bool → Bool, ∀ g₁ g₂ : Bool → Bool, ∀ h : Bool × Bool → Bool,
    (¬ Function.Injective g₁ ∨ ¬ Function.Injective g₂) →
    (fun p => h (g₁ p.1, g₂ p.2)) ≠ f := by
  simp_all +decide [ funext_iff, Fin.forall_fin_two ]

/-
Universal Stronger than Finite: If P holds on finite set S but ¬(∀ x, P x), then ∃ x ∉ S with ¬P x.
-/
theorem T3_5_universal_stronger_than_finite {α : Type} (P : α → Prop) (S : Set α) (h_finite : S.Finite) (h_holds_on_S : ∀ x ∈ S, P x) (h_not_universal : ¬ ∀ x, P x) :
  ∃ x ∉ S, ¬ P x := by
  grind

/-
Weighted Distinguishing: If w is strictly monotone on OracleLevel and kills > 0 and level₁ < level₂, then kills × w(level₁) < kills × w(level₂).
-/
theorem T3_6_weighted_distinguishing (w : OracleLevel → ℚ) (kills : ℕ) (level₁ level₂ : OracleLevel) (h_mono : ∀ l₁ l₂, l₁ < l₂ → w l₁ < w l₂) (h_kills : 0 < kills) (h_levels : level₁ < level₂) :
  (kills : ℚ) * w level₁ < (kills : ℚ) * w level₂ := by
  exact mul_lt_mul_of_pos_left ( h_mono _ _ h_levels ) ( Nat.cast_pos.mpr h_kills )

/-
If a mutant is in the killed set, there exists a distinguishing test in the test suite.
-/
lemma killedSet_mem_has_distinguishing_test (sem : Program D R → D → R) (oracle : Test D R → R → Bool) (MS : MutationSystem D R) (P : Program D R) (T : TestSuite D R) (m : Program D R)
    (hm : m ∈ killedSet sem oracle MS P T) :
    ∃ t ∈ T, passes sem oracle P t ≠ passes sem oracle m t := by
  unfold killedSet at hm; aesop;

/-
Rewrite License: If killedSet = MS.mutants P, then ∀ m ∈ MS.mutants P, ¬ testEquiv sem oracle T P m.
-/
theorem T4_1_rewrite_license (sem : Program D R → D → R) (oracle : Test D R → R → Bool) (MS : MutationSystem D R) (P : Program D R) (T : TestSuite D R)
    (h_killed : killedSet sem oracle MS P T = MS.mutants P) :
    ∀ m ∈ MS.mutants P, ¬ testEquiv sem oracle T P m := by
  intro m hm htestEquiv; replace h_killed := Finset.ext_iff.mp h_killed m; simp_all +decide [ testEquiv ] ;
  unfold killedSet at h_killed; aesop;

/-
Survivor Existence: If killedSet ≠ MS.mutants P, then ∃ m ∈ MS.mutants P, isSurvivor P T m.
-/
theorem T4_1_survivor_existence (sem : Program D R → D → R) (oracle : Test D R → R → Bool) (MS : MutationSystem D R) (P : Program D R) (T : TestSuite D R)
    (h_not_killed : killedSet sem oracle MS P T ≠ MS.mutants P) :
    ∃ m ∈ MS.mutants P, isSurvivor sem oracle P T m := by
  -- Since killedSet ≠ MS.mutants P, there exists m ∈ MS.mutants P \ killedSet.
  obtain ⟨m, hm⟩ : ∃ m ∈ MS.mutants P, m∉killedSet sem oracle MS P T := by
    contrapose! h_not_killed with h_killed;
    exact Finset.Subset.antisymm ( Finset.filter_subset _ _ ) h_killed;
  unfold killedSet at hm; aesop;

def KilledMutants (sem : Program D R → D → R) (oracle : Test D R → R → Bool) (MS : MutationSystem D R) (P : Program D R) (s : SynthState D R) : Set (Program D R) :=
  { m | m ∈ MS.mutants P ∧ m ∉ s.survivors }

def EquivalentMutants (sem : Program D R → D → R) (MS : MutationSystem D R) (P : Program D R) (s : SynthState D R) : Set (Program D R) :=
  { m | m ∈ MS.mutants P ∧ m ∈ s.survivors ∧ trueEquiv sem P m }

def DistinguishableSurvivors (sem : Program D R → D → R) (MS : MutationSystem D R) (P : Program D R) (s : SynthState D R) : Set (Program D R) :=
  { m | m ∈ MS.mutants P ∧ m ∈ s.survivors ∧ ¬ trueEquiv sem P m }

/-
Fixed-Point Partition: The set of mutants partitions into KilledMutants, EquivalentMutants, and DistinguishableSurvivors.
-/
theorem T4_2_fixed_point_partition (sem : Program D R → D → R) (oracle : Test D R → R → Bool) (MS : MutationSystem D R) (P : Program D R) (s : SynthState D R) :
  (KilledMutants sem oracle MS P s ∪ EquivalentMutants sem MS P s ∪ DistinguishableSurvivors sem MS P s = {m | m ∈ MS.mutants P}) ∧
  Disjoint (KilledMutants sem oracle MS P s) (EquivalentMutants sem MS P s) ∧
  Disjoint (KilledMutants sem oracle MS P s) (DistinguishableSurvivors sem MS P s) ∧
  Disjoint (EquivalentMutants sem MS P s) (DistinguishableSurvivors sem MS P s) := by
  -- To prove the union, take any mutant m. If m is not in s_survivors, then it's in KilledMutants. If m is in s_survivors, then it's either in EquivalentMutants (if trueEquiv) or DistinguishableSurvivors (if not). Thus, the union covers all mutants.
  have h_union : KilledMutants sem oracle MS P s ∪ EquivalentMutants sem MS P s ∪ DistinguishableSurvivors sem MS P s = {m | m ∈ MS.mutants P} := by
    ext m; by_cases hm : m ∈ s.survivors <;> by_cases hm' : trueEquiv sem P m <;> simp +decide [ hm, hm' ] ;
    · unfold KilledMutants EquivalentMutants DistinguishableSurvivors; aesop;
    · unfold KilledMutants EquivalentMutants DistinguishableSurvivors; aesop;
    · unfold KilledMutants EquivalentMutants DistinguishableSurvivors; aesop;
    · unfold KilledMutants EquivalentMutants DistinguishableSurvivors; aesop;
  simp_all +decide [ Set.ext_iff, Set.disjoint_left ];
  unfold KilledMutants EquivalentMutants DistinguishableSurvivors; aesop;

variable {D₁ D₂ R₁ R₂ : Type}

def compose (T₁ : TestSuite D₁ R₁) (T₂ : TestSuite D₂ R₂) : TestSuite (D₁ × D₂) (R₁ × R₂) :=
  (T₁.product T₂).image (fun (t₁, t₂) => ⟨t₁.id + t₂.id, (t₁.input, t₂.input)⟩)

variable {D₁ D₂ R₁ R₂ : Type}

def project (T : TestSuite (D₁ × D₂) (R₁ × R₂)) : TestSuite D₁ R₁ × TestSuite D₂ R₂ :=
  (T.image (fun t => ⟨t.id, t.input.1⟩), T.image (fun t => ⟨t.id, t.input.2⟩))

def inj1 (P : Program D₁ R₁) : Program (D₁ × D₂) (R₁ × R₂) := ⟨P.id⟩
def inj2 (P : Program D₂ R₂) : Program (D₁ × D₂) (R₁ × R₂) := ⟨P.id⟩

def test_project1 (t : Test (D₁ × D₂) (R₁ × R₂)) : Test D₁ R₁ := ⟨t.id, t.input.1⟩
def test_project2 (t : Test (D₁ × D₂) (R₁ × R₂)) : Test D₂ R₂ := ⟨t.id, t.input.2⟩

def oracle_product (oracle₁ : Test D₁ R₁ → R₁ → Bool) (oracle₂ : Test D₂ R₂ → R₂ → Bool)
    (t : Test (D₁ × D₂) (R₁ × R₂)) (r : R₁ × R₂) : Bool :=
  oracle₁ (test_project1 t) r.1 && oracle₂ (test_project2 t) r.2

/-
Lemma 1: passes(inj₁(m₁), t) = passes₁(m₁, π₁(t)) ∧ passes₂(P₂, π₂(t)).
-/
lemma T4_3_lemma1_passes_inj1
    (sem : Program (D₁ × D₂) (R₁ × R₂) → (D₁ × D₂) → (R₁ × R₂))
    (sem₁ : Program D₁ R₁ → D₁ → R₁)
    (sem₂ : Program D₂ R₂ → D₂ → R₂)
    (oracle₁ : Test D₁ R₁ → R₁ → Bool)
    (oracle₂ : Test D₂ R₂ → R₂ → Bool)
    (P₂ : Program D₂ R₂)
    (m₁ : Program D₁ R₁)
    (t : Test (D₁ × D₂) (R₁ × R₂))
    (h_sem_inj1 : ∀ x y, sem (inj1 m₁) (x, y) = (sem₁ m₁ x, sem₂ P₂ y)) :
    passes sem (oracle_product oracle₁ oracle₂) (inj1 m₁) t =
    (passes sem₁ oracle₁ m₁ (test_project1 t) && passes sem₂ oracle₂ P₂ (test_project2 t)) := by
  unfold passes; aesop;

/-
Lemma 2: passes(inj₂(m₂), t) = passes₁(P₁, π₁(t)) ∧ passes₂(m₂, π₂(t)).
-/
lemma T4_3_lemma2_passes_inj2
    (sem : Program (D₁ × D₂) (R₁ × R₂) → (D₁ × D₂) → (R₁ × R₂))
    (sem₁ : Program D₁ R₁ → D₁ → R₁)
    (sem₂ : Program D₂ R₂ → D₂ → R₂)
    (oracle₁ : Test D₁ R₁ → R₁ → Bool)
    (oracle₂ : Test D₂ R₂ → R₂ → Bool)
    (P₁ : Program D₁ R₁)
    (m₂ : Program D₂ R₂)
    (t : Test (D₁ × D₂) (R₁ × R₂))
    (h_sem_inj2 : ∀ x y, sem (inj2 m₂) (x, y) = (sem₁ P₁ x, sem₂ m₂ y)) :
    passes sem (oracle_product oracle₁ oracle₂) (inj2 m₂) t =
    (passes sem₁ oracle₁ P₁ (test_project1 t) && passes sem₂ oracle₂ m₂ (test_project2 t)) := by
  -- By definition of `passes`, we have:
  simp [passes, oracle_product, h_sem_inj2];
  rfl

/-
Lemma 3: killedSet(T) ⊆ killedSet₁(π₁(T)).image(inj₁) ∪ killedSet₂(π₂(T)).image(inj₂).
-/
lemma T4_3_lemma3_killedSet_decomposition_subset
    (sem : Program (D₁ × D₂) (R₁ × R₂) → (D₁ × D₂) → (R₁ × R₂))
    (sem₁ : Program D₁ R₁ → D₁ → R₁)
    (sem₂ : Program D₂ R₂ → D₂ → R₂)
    (oracle₁ : Test D₁ R₁ → R₁ → Bool)
    (oracle₂ : Test D₂ R₂ → R₂ → Bool)
    (MS : MutationSystem (D₁ × D₂) (R₁ × R₂))
    (MS₁ : MutationSystem D₁ R₁)
    (MS₂ : MutationSystem D₂ R₂)
    (P : Program (D₁ × D₂) (R₁ × R₂))
    (P₁ : Program D₁ R₁)
    (P₂ : Program D₂ R₂)
    (T : TestSuite (D₁ × D₂) (R₁ × R₂))
    (h_sem_P : ∀ x y, sem P (x, y) = (sem₁ P₁ x, sem₂ P₂ y))
    (h_mutants_decomp : MS.mutants P = (MS₁.mutants P₁).image inj1 ∪ (MS₂.mutants P₂).image inj2)
    (h_sem_inj1 : ∀ m₁ x y, sem (inj1 m₁) (x, y) = (sem₁ m₁ x, sem₂ P₂ y))
    (h_sem_inj2 : ∀ m₂ x y, sem (inj2 m₂) (x, y) = (sem₁ P₁ x, sem₂ m₂ y)) :
    killedSet sem (oracle_product oracle₁ oracle₂) MS P T ⊆
    (killedSet sem₁ oracle₁ MS₁ P₁ (project T).1).image inj1 ∪
    (killedSet sem₂ oracle₂ MS₂ P₂ (project T).2).image inj2 := by
  intro m hm; simp_all +decide [ Finset.subset_iff ] ;
  unfold killedSet at *; simp_all +decide [ Finset.mem_union ] ;
  rcases hm with ⟨ ⟨ a, ha, rfl ⟩ | ⟨ a, ha, rfl ⟩, t, ht, h ⟩ <;> simp_all +decide [ passes ];
  · unfold oracle_product at h; simp_all +decide [ test_project1, test_project2 ] ;
    exact Or.inl ⟨ a, ⟨ ha, ⟨ _, Finset.mem_image_of_mem _ ht, by aesop ⟩ ⟩, rfl ⟩;
  · unfold oracle_product at h; simp_all +decide [ test_project1, test_project2 ] ;
    exact Or.inr ⟨ a, ⟨ ha, ⟨ ⟨ t.id, t.input.2 ⟩, by
      exact Finset.mem_image_of_mem _ ht, by
      grind +ring ⟩ ⟩, rfl ⟩
    skip

/-
Lemma 4: killedSet₁(π₁(T)).image(inj₁) ⊆ killedSet(T).
-/
lemma T4_3_lemma4_killedSet_decomposition_superset_left
    (sem : Program (D₁ × D₂) (R₁ × R₂) → (D₁ × D₂) → (R₁ × R₂))
    (sem₁ : Program D₁ R₁ → D₁ → R₁)
    (sem₂ : Program D₂ R₂ → D₂ → R₂)
    (oracle₁ : Test D₁ R₁ → R₁ → Bool)
    (oracle₂ : Test D₂ R₂ → R₂ → Bool)
    (MS : MutationSystem (D₁ × D₂) (R₁ × R₂))
    (MS₁ : MutationSystem D₁ R₁)
    (P : Program (D₁ × D₂) (R₁ × R₂))
    (P₁ : Program D₁ R₁)
    (P₂ : Program D₂ R₂)
    (T : TestSuite (D₁ × D₂) (R₁ × R₂))
    (h_sem_P : ∀ x y, sem P (x, y) = (sem₁ P₁ x, sem₂ P₂ y))
    (h_sem_inj1 : ∀ m₁ x y, sem (inj1 m₁) (x, y) = (sem₁ m₁ x, sem₂ P₂ y))
    (h_mutants_inj1 : ∀ m₁, m₁ ∈ MS₁.mutants P₁ → inj1 m₁ ∈ MS.mutants P)
    (h_P2_correct : ∀ t ∈ T, passes sem₂ oracle₂ P₂ (test_project2 t) = true) :
    (killedSet sem₁ oracle₁ MS₁ P₁ (project T).1).image inj1 ⊆
    killedSet sem (oracle_product oracle₁ oracle₂) MS P T := by
  simp_all +decide [ Finset.subset_iff ];
  unfold killedSet at *;
  simp_all +decide [ passes, test_project1, test_project2, oracle_product ];
  unfold project at *; aesop;

/-
Decomposition of passes(P, t) into component passes.
-/
lemma T4_3_lemma_passes_P
    (sem : Program (D₁ × D₂) (R₁ × R₂) → (D₁ × D₂) → (R₁ × R₂))
    (sem₁ : Program D₁ R₁ → D₁ → R₁)
    (sem₂ : Program D₂ R₂ → D₂ → R₂)
    (oracle₁ : Test D₁ R₁ → R₁ → Bool)
    (oracle₂ : Test D₂ R₂ → R₂ → Bool)
    (P : Program (D₁ × D₂) (R₁ × R₂))
    (P₁ : Program D₁ R₁)
    (P₂ : Program D₂ R₂)
    (t : Test (D₁ × D₂) (R₁ × R₂))
    (h_sem_P : ∀ x y, sem P (x, y) = (sem₁ P₁ x, sem₂ P₂ y)) :
    passes sem (oracle_product oracle₁ oracle₂) P t =
    (passes sem₁ oracle₁ P₁ (test_project1 t) && passes sem₂ oracle₂ P₂ (test_project2 t)) := by
  unfold passes oracle_product; aesop;

/-
Lemma 5: killedSet₂(π₂(T)).image(inj₂) ⊆ killedSet(T).
-/
lemma T4_3_lemma5_killedSet_decomposition_superset_right
    (sem : Program (D₁ × D₂) (R₁ × R₂) → (D₁ × D₂) → (R₁ × R₂))
    (sem₁ : Program D₁ R₁ → D₁ → R₁)
    (sem₂ : Program D₂ R₂ → D₂ → R₂)
    (oracle₁ : Test D₁ R₁ → R₁ → Bool)
    (oracle₂ : Test D₂ R₂ → R₂ → Bool)
    (MS : MutationSystem (D₁ × D₂) (R₁ × R₂))
    (MS₂ : MutationSystem D₂ R₂)
    (P : Program (D₁ × D₂) (R₁ × R₂))
    (P₁ : Program D₁ R₁)
    (P₂ : Program D₂ R₂)
    (T : TestSuite (D₁ × D₂) (R₁ × R₂))
    (h_sem_P : ∀ x y, sem P (x, y) = (sem₁ P₁ x, sem₂ P₂ y))
    (h_sem_inj2 : ∀ m₂ x y, sem (inj2 m₂) (x, y) = (sem₁ P₁ x, sem₂ m₂ y))
    (h_mutants_inj2 : ∀ m₂, m₂ ∈ MS₂.mutants P₂ → inj2 m₂ ∈ MS.mutants P)
    (h_P1_correct : ∀ t ∈ T, passes sem₁ oracle₁ P₁ (test_project1 t) = true) :
    (killedSet sem₂ oracle₂ MS₂ P₂ (project T).2).image inj2 ⊆
    killedSet sem (oracle_product oracle₁ oracle₂) MS P T := by
  intro m hm; obtain ⟨ m₂, hm₂, rfl ⟩ := Finset.mem_image.mp hm; simp_all +decide [ Finset.subset_iff ] ;
  obtain ⟨ t, ht, h ⟩ := Finset.mem_filter.mp hm₂ |>.2;
  obtain ⟨ u, hu, rfl ⟩ := Finset.mem_image.mp ht;
  refine' Finset.mem_filter.mpr ⟨ h_mutants_inj2 m₂ _, u, hu, _ ⟩ ; simp_all +decide [ passes ] ;
  · exact Finset.mem_filter.mp hm₂ |>.1;
  · unfold passes at *; simp_all +decide [ test_project1, test_project2, oracle_product ] ;

/-
Lemma 6: killedSet(T) = killedSet₁(π₁(T)).image(inj₁) ∪ killedSet₂(π₂(T)).image(inj₂).
-/
lemma T4_3_lemma6_killedSet_decomposition_under_correctness
    (sem : Program (D₁ × D₂) (R₁ × R₂) → (D₁ × D₂) → (R₁ × R₂))
    (sem₁ : Program D₁ R₁ → D₁ → R₁)
    (sem₂ : Program D₂ R₂ → D₂ → R₂)
    (oracle₁ : Test D₁ R₁ → R₁ → Bool)
    (oracle₂ : Test D₂ R₂ → R₂ → Bool)
    (MS : MutationSystem (D₁ × D₂) (R₁ × R₂))
    (MS₁ : MutationSystem D₁ R₁)
    (MS₂ : MutationSystem D₂ R₂)
    (P : Program (D₁ × D₂) (R₁ × R₂))
    (P₁ : Program D₁ R₁)
    (P₂ : Program D₂ R₂)
    (T : TestSuite (D₁ × D₂) (R₁ × R₂))
    (h_sem_P : ∀ x y, sem P (x, y) = (sem₁ P₁ x, sem₂ P₂ y))
    (h_mutants_decomp : MS.mutants P = (MS₁.mutants P₁).image inj1 ∪ (MS₂.mutants P₂).image inj2)
    (h_sem_inj1 : ∀ m₁ x y, sem (inj1 m₁) (x, y) = (sem₁ m₁ x, sem₂ P₂ y))
    (h_sem_inj2 : ∀ m₂ x y, sem (inj2 m₂) (x, y) = (sem₁ P₁ x, sem₂ m₂ y))
    (h_mutants_inj1 : ∀ m₁, m₁ ∈ MS₁.mutants P₁ → inj1 m₁ ∈ MS.mutants P)
    (h_mutants_inj2 : ∀ m₂, m₂ ∈ MS₂.mutants P₂ → inj2 m₂ ∈ MS.mutants P)
    (h_P1_correct : ∀ t ∈ T, passes sem₁ oracle₁ P₁ (test_project1 t) = true)
    (h_P2_correct : ∀ t ∈ T, passes sem₂ oracle₂ P₂ (test_project2 t) = true) :
    killedSet sem (oracle_product oracle₁ oracle₂) MS P T =
    (killedSet sem₁ oracle₁ MS₁ P₁ (project T).1).image inj1 ∪
    (killedSet sem₂ oracle₂ MS₂ P₂ (project T).2).image inj2 := by
  refine' Finset.Subset.antisymm _ _;
  · exact?;
  · exact Finset.union_subset ( T4_3_lemma4_killedSet_decomposition_superset_left sem sem₁ sem₂ oracle₁ oracle₂ MS MS₁ P P₁ P₂ T h_sem_P h_sem_inj1 h_mutants_inj1 h_P2_correct ) ( T4_3_lemma5_killedSet_decomposition_superset_right sem sem₁ sem₂ oracle₁ oracle₂ MS MS₂ P P₁ P₂ T h_sem_P h_sem_inj2 h_mutants_inj2 h_P1_correct )

/-
Oracle Hierarchy as Information Ordering: If T decomposes into S, then killedSet'(T) = ⋃ s ∈ S, killedSet'(s).
-/
structure OracleTest (D R : Type) where
  check : Program D R → Bool

def killedSet' (sem : Program D R → D → R) (MS : MutationSystem D R) (P : Program D R) (T : OracleTest D R) : Set (Program D R) :=
  { m | m ∈ MS.mutants P ∧ T.check P ∧ ¬ T.check m }

theorem T4_4_oracle_hierarchy_information_ordering
    (sem : Program D R → D → R)
    (MS : MutationSystem D R)
    (P : Program D R)
    (T : OracleTest D R)
    (S : Set (OracleTest D R))
    (h_decomp : ∀ m, T.check m ↔ ∀ s ∈ S, s.check m)
    (h_original : T.check P) :
    killedSet' sem MS P T = ⋃ s ∈ S, killedSet' sem MS P s := by
  simp_all +decide [ Set.ext_iff, killedSet' ]

/-
Lemma 4: killedSet₁(π₁(T)).image(inj₁) ⊆ killedSet(T).
-/
lemma T4_3_lemma4_killedSet_decomposition_superset_left_v2
    (sem : Program (D₁ × D₂) (R₁ × R₂) → (D₁ × D₂) → (R₁ × R₂))
    (sem₁ : Program D₁ R₁ → D₁ → R₁)
    (sem₂ : Program D₂ R₂ → D₂ → R₂)
    (oracle₁ : Test D₁ R₁ → R₁ → Bool)
    (oracle₂ : Test D₂ R₂ → R₂ → Bool)
    (MS : MutationSystem (D₁ × D₂) (R₁ × R₂))
    (MS₁ : MutationSystem D₁ R₁)
    (P : Program (D₁ × D₂) (R₁ × R₂))
    (P₁ : Program D₁ R₁)
    (P₂ : Program D₂ R₂)
    (T : TestSuite (D₁ × D₂) (R₁ × R₂))
    (h_sem_P : ∀ x y, sem P (x, y) = (sem₁ P₁ x, sem₂ P₂ y))
    (h_sem_inj1 : ∀ m₁ x y, sem (inj1 m₁) (x, y) = (sem₁ m₁ x, sem₂ P₂ y))
    (h_mutants_inj1 : ∀ m₁, m₁ ∈ MS₁.mutants P₁ → inj1 m₁ ∈ MS.mutants P)
    (h_P2_correct : ∀ t ∈ T, passes sem₂ oracle₂ P₂ (test_project2 t) = true) :
    (killedSet sem₁ oracle₁ MS₁ P₁ (project T).1).image inj1 ⊆
    killedSet sem (oracle_product oracle₁ oracle₂) MS P T := by
  convert T4_3_lemma4_killedSet_decomposition_superset_left sem sem₁ sem₂ oracle₁ oracle₂ MS MS₁ P P₁ P₂ T h_sem_P h_sem_inj1 h_mutants_inj1 h_P2_correct using 1

/-
Lemma 7 (subset): killedSet(compose T₁ T₂) ⊆ killedSet₁(T₁).image(inj₁) ∪ killedSet₂(T₂).image(inj₂).
-/
lemma T4_3_lemma7_subset
    (sem : Program (D₁ × D₂) (R₁ × R₂) → (D₁ × D₂) → (R₁ × R₂))
    (sem₁ : Program D₁ R₁ → D₁ → R₁)
    (sem₂ : Program D₂ R₂ → D₂ → R₂)
    (oracle₁ : Test D₁ R₁ → R₁ → Bool)
    (oracle₂ : Test D₂ R₂ → R₂ → Bool)
    (MS : MutationSystem (D₁ × D₂) (R₁ × R₂))
    (MS₁ : MutationSystem D₁ R₁)
    (MS₂ : MutationSystem D₂ R₂)
    (P : Program (D₁ × D₂) (R₁ × R₂))
    (P₁ : Program D₁ R₁)
    (P₂ : Program D₂ R₂)
    (T₁ : TestSuite D₁ R₁)
    (T₂ : TestSuite D₂ R₂)
    (h_sem_P : ∀ x y, sem P (x, y) = (sem₁ P₁ x, sem₂ P₂ y))
    (h_mutants_decomp : MS.mutants P = (MS₁.mutants P₁).image inj1 ∪ (MS₂.mutants P₂).image inj2)
    (h_sem_inj1 : ∀ m₁ x y, sem (inj1 m₁) (x, y) = (sem₁ m₁ x, sem₂ P₂ y))
    (h_sem_inj2 : ∀ m₂ x y, sem (inj2 m₂) (x, y) = (sem₁ P₁ x, sem₂ m₂ y))
    (h_P1_correct : ∀ t ∈ T₁, passes sem₁ oracle₁ P₁ t = true)
    (h_P2_correct : ∀ t ∈ T₂, passes sem₂ oracle₂ P₂ t = true)
    (h_oracle1_ignore_id : ∀ t t' : Test D₁ R₁, t.input = t'.input → ∀ r, oracle₁ t r = oracle₁ t' r)
    (h_oracle2_ignore_id : ∀ t t' : Test D₂ R₂, t.input = t'.input → ∀ r, oracle₂ t r = oracle₂ t' r) :
    killedSet sem (oracle_product oracle₁ oracle₂) MS P (compose T₁ T₂) ⊆
    (killedSet sem₁ oracle₁ MS₁ P₁ T₁).image inj1 ∪
    (killedSet sem₂ oracle₂ MS₂ P₂ T₂).image inj2 := by
  intro m hm
  simp [killedSet] at hm
  obtain ⟨hm_mutants, hm_killed⟩ := hm
  simp [compose] at hm_killed;
  rcases Finset.mem_union.mp ( h_mutants_decomp ▸ hm_mutants ) with ( h|h ) <;> simp_all +decide [ Finset.mem_image ];
  · rcases h with ⟨ a, ha, rfl ⟩ ; simp_all +decide [ passes, oracle_product ] ;
    contrapose! hm_killed; simp_all +decide [ test_project1, test_project2 ] ;
    intro t t₁ t₂ ht₁ ht₂ rfl; simp +decide [ h_P1_correct t₁ ht₁, h_P2_correct t₂ ht₂ ] ;
    simp_all +decide [ killedSet ];
    specialize hm_killed ; have := hm_killed.1 a ha t₁ ht₁ ; simp_all +decide [ passes ] ;
    specialize h_oracle1_ignore_id ⟨ t₁.id + t₂.id, t₁.input ⟩ t₁ ; aesop ( simp_config := { singlePass := true } ) ;
  · obtain ⟨ a, ha₁, rfl ⟩ := h; simp_all +decide [ passes ] ;
    obtain ⟨ t, ⟨ a, b, ⟨ ha, hb ⟩, rfl ⟩, h ⟩ := hm_killed; simp_all +decide [ oracle_product ] ;
    refine Or.inr ⟨ _, ?_, rfl ⟩ ; simp_all +decide [ killedSet ] ;
    use b; simp_all +decide [ passes ] ;
    specialize h_oracle2_ignore_id ( test_project2 { id := a.id + b.id, input := ( a.input, b.input ) } ) b ; aesop;
    unfold test_project2 at *; aesop;

/-
Lemma 7 (superset): killedSet₁(T₁).image(inj₁) ∪ killedSet₂(T₂).image(inj₂) ⊆ killedSet(compose T₁ T₂).
-/
lemma T4_3_lemma7_superset
    (sem : Program (D₁ × D₂) (R₁ × R₂) → (D₁ × D₂) → (R₁ × R₂))
    (sem₁ : Program D₁ R₁ → D₁ → R₁)
    (sem₂ : Program D₂ R₂ → D₂ → R₂)
    (oracle₁ : Test D₁ R₁ → R₁ → Bool)
    (oracle₂ : Test D₂ R₂ → R₂ → Bool)
    (MS : MutationSystem (D₁ × D₂) (R₁ × R₂))
    (MS₁ : MutationSystem D₁ R₁)
    (MS₂ : MutationSystem D₂ R₂)
    (P : Program (D₁ × D₂) (R₁ × R₂))
    (P₁ : Program D₁ R₁)
    (P₂ : Program D₂ R₂)
    (T₁ : TestSuite D₁ R₁)
    (T₂ : TestSuite D₂ R₂)
    (h_sem_P : ∀ x y, sem P (x, y) = (sem₁ P₁ x, sem₂ P₂ y))
    (h_mutants_decomp : MS.mutants P = (MS₁.mutants P₁).image inj1 ∪ (MS₂.mutants P₂).image inj2)
    (h_sem_inj1 : ∀ m₁ x y, sem (inj1 m₁) (x, y) = (sem₁ m₁ x, sem₂ P₂ y))
    (h_sem_inj2 : ∀ m₂ x y, sem (inj2 m₂) (x, y) = (sem₁ P₁ x, sem₂ m₂ y))
    (h_P1_correct : ∀ t ∈ T₁, passes sem₁ oracle₁ P₁ t = true)
    (h_P2_correct : ∀ t ∈ T₂, passes sem₂ oracle₂ P₂ t = true)
    (h_oracle1_ignore_id : ∀ t t' : Test D₁ R₁, t.input = t'.input → ∀ r, oracle₁ t r = oracle₁ t' r)
    (h_oracle2_ignore_id : ∀ t t' : Test D₂ R₂, t.input = t'.input → ∀ r, oracle₂ t r = oracle₂ t' r)
    (h_T1_nonempty : T₁.Nonempty)
    (h_T2_nonempty : T₂.Nonempty) :
    (killedSet sem₁ oracle₁ MS₁ P₁ T₁).image inj1 ∪
    (killedSet sem₂ oracle₂ MS₂ P₂ T₂).image inj2 ⊆
    killedSet sem (oracle_product oracle₁ oracle₂) MS P (compose T₁ T₂) := by
  intro m;
  unfold killedSet at *; simp_all +decide [ Finset.ext_iff ] ;
  rintro ( ⟨ a, ⟨ ha₁, t₁, ht₁, ht₁' ⟩, rfl ⟩ | ⟨ a, ⟨ ha₁, t₂, ht₂, ht₂' ⟩, rfl ⟩ ) <;> simp_all +decide [ passes, oracle_product ];
  · obtain ⟨ t₂, ht₂ ⟩ := h_T2_nonempty.exists_mem; use Or.inl ⟨ a, ha₁, rfl ⟩ ; use ⟨ t₁.id + t₂.id, ( t₁.input, t₂.input ) ⟩ ; simp_all +decide [ compose, test_project1, test_project2 ] ;
    refine' ⟨ ⟨ t₁, t₂, ⟨ ht₁, ht₂ ⟩, rfl, rfl, rfl ⟩, _ ⟩ ; specialize h_oracle1_ignore_id ⟨ t₁.id + t₂.id, t₁.input ⟩ t₁ rfl ; specialize h_oracle2_ignore_id ⟨ t₁.id + t₂.id, t₂.input ⟩ t₂ rfl ; aesop;
  · refine' ⟨ Or.inr ⟨ a, ha₁, rfl ⟩, _ ⟩;
    obtain ⟨ t₁, ht₁ ⟩ := h_T1_nonempty; use ⟨ t₁.id + t₂.id, ( t₁.input, t₂.input ) ⟩ ; simp_all +decide [ test_project1, test_project2, compose ] ;
    refine' ⟨ ⟨ t₁, t₂, ⟨ ht₁, ht₂ ⟩, rfl, rfl, rfl ⟩, _ ⟩ ; specialize h_oracle1_ignore_id ⟨ t₁.id + t₂.id, t₁.input ⟩ t₁ rfl ; specialize h_oracle2_ignore_id ⟨ t₁.id + t₂.id, t₂.input ⟩ t₂ rfl ; aesop;

/-
Lemma 7: killedSet(compose T₁ T₂) = killedSet₁(T₁).image(inj₁) ∪ killedSet₂(T₂).image(inj₂).
-/
lemma T4_3_lemma7_killedSet_compose_decomposition
    (sem : Program (D₁ × D₂) (R₁ × R₂) → (D₁ × D₂) → (R₁ × R₂))
    (sem₁ : Program D₁ R₁ → D₁ → R₁)
    (sem₂ : Program D₂ R₂ → D₂ → R₂)
    (oracle₁ : Test D₁ R₁ → R₁ → Bool)
    (oracle₂ : Test D₂ R₂ → R₂ → Bool)
    (MS : MutationSystem (D₁ × D₂) (R₁ × R₂))
    (MS₁ : MutationSystem D₁ R₁)
    (MS₂ : MutationSystem D₂ R₂)
    (P : Program (D₁ × D₂) (R₁ × R₂))
    (P₁ : Program D₁ R₁)
    (P₂ : Program D₂ R₂)
    (T₁ : TestSuite D₁ R₁)
    (T₂ : TestSuite D₂ R₂)
    (h_sem_P : ∀ x y, sem P (x, y) = (sem₁ P₁ x, sem₂ P₂ y))
    (h_mutants_decomp : MS.mutants P = (MS₁.mutants P₁).image inj1 ∪ (MS₂.mutants P₂).image inj2)
    (h_sem_inj1 : ∀ m₁ x y, sem (inj1 m₁) (x, y) = (sem₁ m₁ x, sem₂ P₂ y))
    (h_sem_inj2 : ∀ m₂ x y, sem (inj2 m₂) (x, y) = (sem₁ P₁ x, sem₂ m₂ y))
    (h_mutants_inj1 : ∀ m₁, m₁ ∈ MS₁.mutants P₁ → inj1 m₁ ∈ MS.mutants P)
    (h_mutants_inj2 : ∀ m₂, m₂ ∈ MS₂.mutants P₂ → inj2 m₂ ∈ MS.mutants P)
    (h_P1_correct : ∀ t ∈ T₁, passes sem₁ oracle₁ P₁ t = true)
    (h_P2_correct : ∀ t ∈ T₂, passes sem₂ oracle₂ P₂ t = true)
    (h_oracle1_ignore_id : ∀ t t' : Test D₁ R₁, t.input = t'.input → ∀ r, oracle₁ t r = oracle₁ t' r)
    (h_oracle2_ignore_id : ∀ t t' : Test D₂ R₂, t.input = t'.input → ∀ r, oracle₂ t r = oracle₂ t' r)
    (h_T1_nonempty : T₁.Nonempty)
    (h_T2_nonempty : T₂.Nonempty) :
    killedSet sem (oracle_product oracle₁ oracle₂) MS P (compose T₁ T₂) =
    (killedSet sem₁ oracle₁ MS₁ P₁ T₁).image inj1 ∪
    (killedSet sem₂ oracle₂ MS₂ P₂ T₂).image inj2 := by
  have h_subset : killedSet sem (oracle_product oracle₁ oracle₂) MS P (compose T₁ T₂) ⊆ Finset.image inj1 (killedSet sem₁ oracle₁ MS₁ P₁ T₁) ∪ Finset.image inj2 (killedSet sem₂ oracle₂ MS₂ P₂ T₂) := by
    convert T4_3_lemma7_subset sem sem₁ sem₂ oracle₁ oracle₂ MS MS₁ MS₂ P P₁ P₂ T₁ T₂ h_sem_P h_mutants_decomp h_sem_inj1 h_sem_inj2 h_P1_correct h_P2_correct h_oracle1_ignore_id h_oracle2_ignore_id using 1;
  apply Finset.Subset.antisymm h_subset;
  exact?

/-
T4.5 (Idempotency): If f is idempotent and m is not, then there exists a distinguishing test.
-/
def IsIdempotent {D : Type} (f : D → D) : Prop := ∀ x, f (f x) = f x

theorem T4_5_idempotency (sem : Program D D → D → D) (f m : Program D D)
    (h_f : IsIdempotent (sem f))
    (h_m : ¬ IsIdempotent (sem m)) :
    ∃ t : Test D D, passes sem (fun _ r => r = sem f t.input) f t ≠ passes sem (fun _ r => r = sem f t.input) m t := by
  contrapose! h_m; simp_all +decide [ IsIdempotent ] ;
  -- By definition of passes, we know that if passes sem (fun x r => Decidable.decide (r = sem f x)) f x = passes sem (fun x r => Decidable.decide (r = sem f x)) m x, then sem m x = sem f x.
  have h_eq : ∀ x, sem m x = sem f x := by
    intro x; specialize h_m ⟨ 0, x ⟩ ; unfold passes at h_m; aesop;
  aesop

/-
Decomposition-Specification Adjunction: refines P T (compose T₁ T₂) ↔ refines P₁ (project T).1 T₁ ∧ refines P₂ (project T).2 T₂.
-/
theorem T4_3_decomposition_specification_adjunction
    (sem : Program (D₁ × D₂) (R₁ × R₂) → (D₁ × D₂) → (R₁ × R₂))
    (sem₁ : Program D₁ R₁ → D₁ → R₁)
    (sem₂ : Program D₂ R₂ → D₂ → R₂)
    (oracle₁ : Test D₁ R₁ → R₁ → Bool)
    (oracle₂ : Test D₂ R₂ → R₂ → Bool)
    (MS : MutationSystem (D₁ × D₂) (R₁ × R₂))
    (MS₁ : MutationSystem D₁ R₁)
    (MS₂ : MutationSystem D₂ R₂)
    (P : Program (D₁ × D₂) (R₁ × R₂))
    (P₁ : Program D₁ R₁)
    (P₂ : Program D₂ R₂)
    (T : TestSuite (D₁ × D₂) (R₁ × R₂))
    (T₁ : TestSuite D₁ R₁)
    (T₂ : TestSuite D₂ R₂)
    (h_sem_P : ∀ x y, sem P (x, y) = (sem₁ P₁ x, sem₂ P₂ y))
    (h_mutants_decomp : MS.mutants P = (MS₁.mutants P₁).image inj1 ∪ (MS₂.mutants P₂).image inj2)
    (h_sem_inj1 : ∀ m₁ x y, sem (inj1 m₁) (x, y) = (sem₁ m₁ x, sem₂ P₂ y))
    (h_sem_inj2 : ∀ m₂ x y, sem (inj2 m₂) (x, y) = (sem₁ P₁ x, sem₂ m₂ y))
    (h_mutants_inj1 : ∀ m₁, m₁ ∈ MS₁.mutants P₁ → inj1 m₁ ∈ MS.mutants P)
    (h_mutants_inj2 : ∀ m₂, m₂ ∈ MS₂.mutants P₂ → inj2 m₂ ∈ MS.mutants P)
    (h_P1_correct : ∀ t ∈ T, passes sem₁ oracle₁ P₁ (test_project1 t) = true)
    (h_P2_correct : ∀ t ∈ T, passes sem₂ oracle₂ P₂ (test_project2 t) = true)
    (h_T1_correct : ∀ t ∈ T₁, passes sem₁ oracle₁ P₁ t = true)
    (h_T2_correct : ∀ t ∈ T₂, passes sem₂ oracle₂ P₂ t = true)
    (h_oracle1_ignore_id : ∀ t t' : Test D₁ R₁, t.input = t'.input → ∀ r, oracle₁ t r = oracle₁ t' r)
    (h_oracle2_ignore_id : ∀ t t' : Test D₂ R₂, t.input = t'.input → ∀ r, oracle₂ t r = oracle₂ t' r)
    (h_T1_nonempty : T₁.Nonempty)
    (h_T2_nonempty : T₂.Nonempty) :
    refines sem (oracle_product oracle₁ oracle₂) MS P T (compose T₁ T₂) ↔
      refines sem₁ oracle₁ MS₁ P₁ (project T).1 T₁ ∧
      refines sem₂ oracle₂ MS₂ P₂ (project T).2 T₂ := by
  constructor <;> intro h;
  · unfold refines at *;
    constructor <;> intro m hm <;> simp_all +decide [ Finset.subset_iff ];
    · unfold killedSet at *; simp_all +decide [ Finset.subset_iff ] ;
      unfold project at hm; simp_all +decide [ Finset.mem_image ] ;
      obtain ⟨ a, ha₁, ha₂ ⟩ := hm.2; specialize h ( Or.inl ⟨ m, hm.1, rfl ⟩ ) a ha₁; simp_all +decide [ compose ] ;
      contrapose! h; simp_all +decide [ passes ] ;
      unfold oracle_product; simp_all +decide [ test_project1, test_project2 ] ;
      rintro x y z hy hz rfl; simp_all +decide [ Finset.mem_image ] ;
      specialize h_oracle1_ignore_id ⟨ y.id + z.id, y.input ⟩ y ; aesop;
    · contrapose! h;
      refine' ⟨ inj2 m, _, _ ⟩ <;> simp_all +decide [ killedSet ];
      · obtain ⟨ t, ht₁, ht₂ ⟩ := hm.2;
        obtain ⟨ u, hu₁, hu₂ ⟩ := Finset.mem_image.mp ht₁;
        use u; simp_all +decide [ passes ] ;
        unfold oracle_product; simp_all +decide [ test_project1, test_project2 ] ;
        grind +ring;
      · unfold compose at *; simp_all +decide [ Finset.mem_image, Finset.mem_product ] ;
        rintro x y z hy hz rfl; simp +decide [ *, passes ] ;
        unfold oracle_product; simp +decide [ *, passes ] ;
        have := h_T2_correct z hz; have := h z hz; simp_all +decide [ passes ] ;
        simp_all +decide [ test_project1, test_project2 ];
        specialize h_oracle2_ignore_id ⟨ y.id + z.id, z.input ⟩ z ; aesop;
  · rw [refines, refines] at *;
    have h_killedSet_eq : killedSet sem (oracle_product oracle₁ oracle₂) MS P T = (killedSet sem₁ oracle₁ MS₁ P₁ (project T).1).image inj1 ∪ (killedSet sem₂ oracle₂ MS₂ P₂ (project T).2).image inj2 := by
      apply T4_3_lemma6_killedSet_decomposition_under_correctness sem sem₁ sem₂ oracle₁ oracle₂ MS MS₁ MS₂ P P₁ P₂ T h_sem_P h_mutants_decomp h_sem_inj1 h_sem_inj2 h_mutants_inj1 h_mutants_inj2 h_P1_correct h_P2_correct;
    have h_killedSet_eq_compose : killedSet sem (oracle_product oracle₁ oracle₂) MS P (compose T₁ T₂) = (killedSet sem₁ oracle₁ MS₁ P₁ T₁).image inj1 ∪ (killedSet sem₂ oracle₂ MS₂ P₂ T₂).image inj2 := by
      apply T4_3_lemma7_killedSet_compose_decomposition sem sem₁ sem₂ oracle₁ oracle₂ MS MS₁ MS₂ P P₁ P₂ T₁ T₂ h_sem_P h_mutants_decomp h_sem_inj1 h_sem_inj2 h_mutants_inj1 h_mutants_inj2 h_T1_correct h_T2_correct h_oracle1_ignore_id h_oracle2_ignore_id h_T1_nonempty h_T2_nonempty;
    grind

/-
Lemma A: For x > 0, (3/2)(x-1)²/(x+2) ≤ x·ln(x) - x + 1.
-/
def Distribution (α : Type) [Fintype α] := α → ℝ

def is_distribution {α : Type} [Fintype α] (P : Distribution α) : Prop :=
  (∀ x, 0 ≤ P x) ∧ (∑ x, P x = 1)

noncomputable def kl_divergence {α : Type} [Fintype α] (P Q : Distribution α) : ℝ :=
  ∑ x, P x * Real.log (P x / Q x)

lemma T4_6_lemmaA_pinsker_scalar_inequality (x : ℝ) (h : x > 0) :
  (3/2) * (x - 1)^2 / (x + 2) ≤ x * Real.log x - x + 1 := by
  by_cases hx : x ≥ 1;
  · -- For $x \geq 1$, we can use the fact that $f(x)$ is non-decreasing and $f(1) = 0$.
    have h_deriv_nonneg : ∀ x > 1, deriv (fun x => x * Real.log x - x + 1 - (3 / 2) * (x - 1) ^ 2 / (x + 2)) x ≥ 0 := by
      intro x hx; norm_num [ show x ≠ 0 by linarith, show x + 2 ≠ 0 by linarith ];
      -- We'll use the fact that $Real.log x \geq \frac{2(x - 1)}{x + 1}$ for $x > 1$.
      have h_log_bound : ∀ x > 1, Real.log x ≥ 2 * (x - 1) / (x + 1) := by
        -- Let's choose any $x > 1$ and derive a contradiction to $Real.log x < 2 * (x - 1) / (x + 1)$.
        intro x hx
        have h_deriv : ∀ x > 1, deriv (fun x => Real.log x - 2 * (x - 1) / (x + 1)) x ≥ 0 := by
          intro x hx; norm_num [ show x ≠ 0 by linarith, show x + 1 ≠ 0 by linarith ];
          rw [ inv_eq_one_div, div_le_div_iff₀ ] <;> nlinarith;
        -- Apply the mean value theorem to the interval $[1, x]$.
        obtain ⟨c, hc⟩ : ∃ c ∈ Set.Ioo 1 x, deriv (fun x => Real.log x - 2 * (x - 1) / (x + 1)) c = (Real.log x - 2 * (x - 1) / (x + 1) - (Real.log 1 - 2 * (1 - 1) / (1 + 1))) / (x - 1) := by
          have := exists_deriv_eq_slope ( f := fun x => Real.log x - 2 * ( x - 1 ) / ( x + 1 ) ) hx;
          exact this ( ContinuousOn.sub ( Real.continuousOn_log.mono <| by norm_num ) <| ContinuousOn.div ( continuousOn_const.mul <| continuousOn_id.sub continuousOn_const ) ( continuousOn_id.add continuousOn_const ) <| by intro y hy; linarith [ hy.1 ] ) ( fun y hy => DifferentiableAt.differentiableWithinAt <| by norm_num [ show y ≠ 0 by linarith [ hy.1 ], show y + 1 ≠ 0 by linarith [ hy.1 ] ] ) |> fun ⟨ c, hc₁, hc₂ ⟩ => ⟨ c, hc₁, by simpa using hc₂ ⟩;
        have := h_deriv c hc.1.1; rw [ hc.2, ge_iff_le ] at this; rw [ le_div_iff₀ ] at this <;> norm_num at * <;> linarith;
      exact le_trans ( by rw [ div_le_div_iff₀ ] <;> nlinarith [ mul_div_cancel₀ ( 2 * ( x - 1 ) ) ( by linarith : ( x + 1 ) ≠ 0 ) ] ) ( h_log_bound x hx );
    by_contra h_contra;
    have := exists_deriv_eq_slope ( f := fun x => x * Real.log x - x + 1 - 3 / 2 * ( x - 1 ) ^ 2 / ( x + 2 ) ) ( show x > 1 from hx.lt_of_ne ( by rintro rfl; norm_num at h_contra ) ) ; norm_num at this;
    exact absurd ( this ( by exact ContinuousOn.sub ( ContinuousOn.add ( ContinuousOn.sub ( continuousOn_id.mul ( Real.continuousOn_log.mono ( by norm_num ) ) ) continuousOn_id ) continuousOn_const ) ( ContinuousOn.div ( continuousOn_const.mul ( ContinuousOn.pow ( continuousOn_id.sub continuousOn_const ) 2 ) ) ( continuousOn_id.add continuousOn_const ) fun x hx => by linarith [ hx.1 ] ) ) ( by exact fun x hx => DifferentiableAt.differentiableWithinAt ( by norm_num [ show x ≠ 0 by linarith [ hx.1 ], show x + 2 ≠ 0 by linarith [ hx.1 ] ] ) ) ) ( by rintro ⟨ c, ⟨ hc1, hc2 ⟩, hc3 ⟩ ; have := h_deriv_nonneg c hc1; rw [ hc3, ge_iff_le ] at this; rw [ le_div_iff₀ ] at this <;> nlinarith [ mul_div_cancel₀ ( 3 / 2 * ( x - 1 ) ^ 2 ) ( by linarith : ( x + 2 ) ≠ 0 ) ] );
  · -- For $0 < x < 1$, we use the fact that $f(x)$ is decreasing and $f(1) = 0$.
    have h_deriv_neg : ∀ x ∈ Set.Ioo 0 1, deriv (fun x => x * Real.log x - x + 1 - (3 / 2) * (x - 1) ^ 2 / (x + 2)) x < 0 := by
      intro x hx; norm_num [ show x ≠ 0 by linarith [ hx.1 ], show x + 2 ≠ 0 by linarith [ hx.1 ] ] ; ring_nf; norm_num [ hx.1, hx.2 ] ; (
                                                                -- Let's simplify the expression for the derivative further by combining like terms.
                                                                field_simp [mul_comm, mul_assoc, add_assoc, sub_eq_add_neg] at *;
                                                                -- Since $f(x)$ is increasing on $(0, 1)$ and $f(1) = 0$, we have $f(x) < 0$ for $x \in (0, 1)$.
                                                                have h_inc : ∀ x ∈ Set.Ioo 0 1, deriv (fun x => Real.log x * 2 * (4 * (1 + x) + x ^ 2) + 15 - (x * (2 * 6 + x * 3))) x > 0 := by
                                                                  intro x hx; norm_num [ add_comm, mul_comm, hx.1.ne', hx.2.ne' ] ; ring_nf; (
                                                                  nlinarith [ hx.1, hx.2, inv_pos.2 hx.1, mul_inv_cancel₀ hx.1.ne', Real.log_inv x ▸ Real.log_lt_sub_one_of_pos ( inv_pos.2 hx.1 ) ( by nlinarith [ hx.1, hx.2, mul_inv_cancel₀ hx.1.ne' ] ) ]);
                                                                -- Since $f(x)$ is increasing on $(0, 1)$ and $f(1) = 0$, we have $f(x) < 0$ for $x \in (0, 1)$ by the Mean Value Theorem.
                                                                have h_mvt : ∃ c ∈ Set.Ioo x 1, deriv (fun x => Real.log x * 2 * (4 * (1 + x) + x ^ 2) + 15 - (x * (2 * 6 + x * 3))) c = (Real.log 1 * 2 * (4 * (1 + 1) + 1 ^ 2) + 15 - (1 * (2 * 6 + 1 * 3)) - (Real.log x * 2 * (4 * (1 + x) + x ^ 2) + 15 - (x * (2 * 6 + x * 3)))) / (1 - x) := by
                                                                  have := exists_deriv_eq_slope ( f := fun x => Real.log x * 2 * ( 4 * ( 1 + x ) + x ^ 2 ) + 15 - x * ( 2 * 6 + x * 3 ) ) hx.2;
                                                                  exact this ( ContinuousOn.sub ( ContinuousOn.add ( ContinuousOn.mul ( ContinuousOn.mul ( Real.continuousOn_log.mono ( by norm_num; linarith [ hx.1 ] ) ) continuousOn_const ) ( ContinuousOn.add ( continuousOn_const.mul ( continuousOn_const.add continuousOn_id ) ) ( continuousOn_pow 2 ) ) ) continuousOn_const ) ( ContinuousOn.mul continuousOn_id ( ContinuousOn.add continuousOn_const ( continuousOn_id.mul continuousOn_const ) ) ) ) ( fun y hy => DifferentiableAt.differentiableWithinAt ( by norm_num [ add_comm, mul_comm, show y ≠ 0 from by linarith [ hy.1, hx.1 ] ] ) ) |> fun ⟨ c, hc₁, hc₂ ⟩ => ⟨ c, hc₁, hc₂.trans ( by ring ) ⟩ ;
                                                                obtain ⟨ c, hc₁, hc₂ ⟩ := h_mvt; have := h_inc c ⟨ by linarith [ hc₁.1, hx.1 ], by linarith [ hc₁.2, hx.2 ] ⟩ ; rw [ hc₂, gt_iff_lt ] at this; rw [ lt_div_iff₀ ] at this <;> norm_num at * <;> try nlinarith;
                                                                rw [ add_div', div_lt_div_iff_of_pos_right ] <;> nlinarith [ sq_nonneg ( x - 1 ) ] ;);
    -- Apply the Mean Value Theorem to the interval [x, 1].
    obtain ⟨c, hc⟩ : ∃ c ∈ Set.Ioo x 1, deriv (fun x => x * Real.log x - x + 1 - (3 / 2) * (x - 1) ^ 2 / (x + 2)) c = ( (fun x => x * Real.log x - x + 1 - (3 / 2) * (x - 1) ^ 2 / (x + 2)) 1 - (fun x => x * Real.log x - x + 1 - (3 / 2) * (x - 1) ^ 2 / (x + 2)) x ) / (1 - x) := by
      apply_rules [ exists_deriv_eq_slope ];
      · linarith;
      · exact continuousOn_of_forall_continuousAt fun x hx => by exact ContinuousAt.sub ( ContinuousAt.add ( ContinuousAt.sub ( continuousAt_id.mul ( Real.continuousAt_log ( by linarith [ hx.1 ] ) ) ) continuousAt_id ) continuousAt_const ) ( ContinuousAt.div ( continuousAt_const.mul ( ContinuousAt.pow ( continuousAt_id.sub continuousAt_const ) 2 ) ) ( continuousAt_id.add continuousAt_const ) ( by linarith [ hx.1 ] ) ) ;
      · exact fun x hx => DifferentiableAt.differentiableWithinAt ( by exact DifferentiableAt.sub ( DifferentiableAt.add ( DifferentiableAt.sub ( differentiableAt_id.mul ( Real.differentiableAt_log ( by linarith [ hx.1 ] ) ) ) differentiableAt_id ) ( differentiableAt_const _ ) ) ( DifferentiableAt.div ( by norm_num ) ( by norm_num ) ( by linarith [ hx.1 ] ) ) );
    have := h_deriv_neg c ⟨ by linarith [ hc.1.1 ], by linarith [ hc.1.2 ] ⟩ ; rw [ hc.2, div_lt_iff₀ ] at this <;> norm_num at * <;> nlinarith;

/-
Lemma B: (3/2) ∑ₓ (Pₓ - Qₓ)²/(Pₓ + 2Qₓ) ≤ KL(P‖Q).
-/
lemma T4_6_lemmaB_pinsker_sum_inequality {α : Type} [Fintype α] (P Q : Distribution α) (hP : is_distribution P) (hQ : is_distribution Q) (hQ_pos : ∀ x, 0 < Q x) :
  (3/2) * ∑ x, (P x - Q x)^2 / (P x + 2 * Q x) ≤ kl_divergence P Q := by
  -- Applying the scalar inequality to each term in the sum, we get:
  have h_scalar_inequality (x : α) (hx : 0 < Q x) :
    (3 / 2 : ℝ) * ((P x - Q x) ^ 2) / (P x + 2 * Q x) ≤ P x * Real.log (P x / Q x) - P x + Q x := by
      by_cases hP_x : P x > 0 <;> by_cases hQ_x : Q x > 0 <;> simp_all +decide [ ne_of_gt, le_of_lt ];
      · have := T4_6_lemmaA_pinsker_scalar_inequality ( P x / Q x ) ( div_pos hP_x ( hQ_pos x ) );
        convert mul_le_mul_of_nonneg_right this ( le_of_lt ( hQ_pos x ) ) using 1 <;> ring_nf <;> norm_num [ ne_of_gt ( hQ_pos x ) ] ; ring_nf;
        grind;
      · norm_num [ show P x = 0 by linarith [ hP.1 x ] ] at *;
        rw [ div_le_iff₀ ] <;> nlinarith only [ hQ_pos x ];
  simp_all +decide [ Finset.mul_sum _ _ _, mul_div_assoc ];
  convert Finset.sum_le_sum fun i _ => h_scalar_inequality i using 1 ; norm_num [ Finset.sum_add_distrib, Finset.mul_sum _ _ _, Finset.sum_mul, hP.2, hQ.2 ] ; ring!;

/-
Lemma C: (∑ₓ |Pₓ - Qₓ|)² ≤ 3 · ∑ₓ (Pₓ-Qₓ)²/(Pₓ+2Qₓ).
-/
lemma T4_6_lemmaC_pinsker_cauchy_schwarz {α : Type} [Fintype α] (P Q : Distribution α) (hP : is_distribution P) (hQ : is_distribution Q) (hQ_pos : ∀ x, 0 < Q x) :
  (∑ x, |P x - Q x|)^2 ≤ 3 * ∑ x, (P x - Q x)^2 / (P x + 2 * Q x) := by
  have := hP.1;
  -- By Cauchy-Schwarz inequality, we have that for any vectors $v$ and $w$ of equal length, $(∑ i, v i * w i)^2 ≤ (∑ i, v i^2) * (∑ i, w i^2)$.
  have h_cauchy_schwarz : ∀ (v w : α → ℝ), (∑ i, v i * w i)^2 ≤ (∑ i, v i^2) * (∑ i, w i^2) := by
    exact?;
  convert h_cauchy_schwarz ( fun i => |P i - Q i| / Real.sqrt ( P i + 2 * Q i ) ) ( fun i => Real.sqrt ( P i + 2 * Q i ) ) using 1 <;> norm_num [ Real.sq_sqrt ( add_nonneg ( this _ ) ( mul_nonneg zero_le_two ( le_of_lt ( hQ_pos _ ) ) ) ) ];
  · exact congr_arg ( · ^ 2 ) ( Finset.sum_congr rfl fun _ _ => by rw [ div_mul_cancel₀ _ ( ne_of_gt ( Real.sqrt_pos.mpr ( add_pos_of_nonneg_of_pos ( this _ ) ( mul_pos zero_lt_two ( hQ_pos _ ) ) ) ) ) ] );
  · norm_num [ div_pow, Real.sq_sqrt ( add_nonneg ( this _ ) ( mul_nonneg zero_le_two ( le_of_lt ( hQ_pos _ ) ) ) ) ];
    norm_num [ mul_comm, Finset.sum_add_distrib, ← Finset.mul_sum _ _ _, ← Finset.sum_mul, hP.2, hQ.2 ]

/-
Lemma D: ∑ₓ |Pₓ - Qₓ| ≤ √(2·KL(P‖Q)).
-/
lemma T4_6_lemmaD_pinsker_inequality {α : Type} [Fintype α] (P Q : Distribution α) (hP : is_distribution P) (hQ : is_distribution Q) (hQ_pos : ∀ x, 0 < Q x) :
  ∑ x, |P x - Q x| ≤ Real.sqrt (2 * kl_divergence P Q) := by
  exact Real.le_sqrt_of_sq_le ( by nlinarith [ Real.mul_self_sqrt ( show 0 ≤ 2 by norm_num ), T4_6_lemmaB_pinsker_sum_inequality P Q hP hQ hQ_pos, T4_6_lemmaC_pinsker_cauchy_schwarz P Q hP hQ hQ_pos ] )

/-
Lemma E: |P(E) - Q(E)| ≤ (1/2)·∑|P-Q|.
-/
lemma T4_6_lemmaE_prob_diff_le_half_l1 {α : Type} [Fintype α] (P Q : Distribution α) (hP : is_distribution P) (hQ : is_distribution Q) (E : Finset α) :
  |∑ x ∈ E, P x - ∑ x ∈ E, Q x| ≤ (1/2) * ∑ x, |P x - Q x| := by
  -- By the triangle inequality, we have:
  have h_triangle : |∑ x ∈ E, P x - ∑ x ∈ E, Q x| + |∑ x ∈ Eᶜ, P x - ∑ x ∈ Eᶜ, Q x| ≤ ∑ x, |P x - Q x| := by
    rw [ ← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib ];
    exact le_trans ( add_le_add ( Finset.abs_sum_le_sum_abs _ _ ) ( Finset.abs_sum_le_sum_abs _ _ ) ) ( by rw [ ← Finset.sum_union ( Finset.disjoint_right.mpr fun x => by aesop ) ] ; exact Finset.sum_le_sum_of_subset_of_nonneg ( Finset.subset_univ _ ) fun _ _ _ => abs_nonneg _ );
  -- Since $\sum_{x \in E} P(x) + \sum_{x \in E^c} P(x) = 1$ and $\sum_{x \in E} Q(x) + \sum_{x \in E^c} Q(x) = 1$, we have:
  have h_sum : ∑ x ∈ E, P x + ∑ x ∈ Eᶜ, P x = 1 ∧ ∑ x ∈ E, Q x + ∑ x ∈ Eᶜ, Q x = 1 := by
    exact ⟨ by rw [ Finset.sum_add_sum_compl, hP.2 ], by rw [ Finset.sum_add_sum_compl, hQ.2 ] ⟩;
  cases abs_cases ( ∑ x ∈ E, P x - ∑ x ∈ E, Q x ) <;> cases abs_cases ( ∑ x ∈ Eᶜ, P x - ∑ x ∈ Eᶜ, Q x ) <;> linarith

def marginal {n : ℕ} (P : Distribution (Fin n → Bool)) (i : Fin n) : Distribution Bool :=
  fun b => ∑ x ∈ Finset.univ.filter (fun x => x i = b), P x

def product_of_marginals {n : ℕ} (P : Distribution (Fin n → Bool)) : Distribution (Fin n → Bool) :=
  fun x => ∏ i, marginal P i (x i)

def combined_detection {n : ℕ} (P : Distribution (Fin n → Bool)) : ℝ :=
  1 - P (fun _ => false)

def independent_detection {n : ℕ} (P : Distribution (Fin n → Bool)) : ℝ :=
  1 - ∏ i, marginal P i false

def mutual_information {n : ℕ} (P : Distribution (Fin n → Bool)) : ℝ :=
  kl_divergence P (product_of_marginals P)

/-
Cross-Channel Independence: combined_detection ≥ independent_detection - √(2 * mutual_information).
-/
theorem T4_6_cross_channel_independence {n : ℕ} (P : Distribution (Fin n → Bool))
    (hP : is_distribution P) (hP_pos : ∀ x, 0 < P x) :
    combined_detection P ≥ independent_detection P - Real.sqrt (2 * mutual_information P) := by
  have h_combined : |∑ x ∈ Finset.univ.filter (fun x => x = fun _ => false), P x - ∑ x ∈ Finset.univ.filter (fun x => x = fun _ => false), ∏ i, marginal P i (x i)| ≤ (1 / 2) * ∑ x, |P x - ∏ i, marginal P i (x i)| := by
    convert T4_6_lemmaE_prob_diff_le_half_l1 P ( product_of_marginals P ) hP ?_ ?_ using 1;
    refine' ⟨ _, _ ⟩;
    · exact fun x => Finset.prod_nonneg fun i _ => Finset.sum_nonneg fun _ _ => le_of_lt ( hP_pos _ );
    · -- By definition of product_of_marginals, we can expand the sum.
      have h_expand : ∑ x : Fin n → Bool, ∏ i : Fin n, marginal P i (x i) = ∏ i : Fin n, ∑ x : Bool, marginal P i x := by
        exact?;
      convert h_expand using 1;
      rw [ Finset.prod_eq_one ] ; intros ; simp +decide [ marginal ] ; ring;
      rw [ ← hP.2, ← Finset.sum_union ] ; congr ; ext ; by_cases h : ( ‹Fin n› : Fin n → Bool ) ‹_› = Bool.true <;> aesop;
      exact Finset.disjoint_filter.mpr ( by aesop );
  have h_combined : ∑ x, |P x - ∏ i, marginal P i (x i)| ≤ Real.sqrt (2 * kl_divergence P (fun x => ∏ i, marginal P i (x i))) := by
    apply_rules [ T4_6_lemmaD_pinsker_inequality ];
    · constructor <;> norm_num [ Finset.prod_eq_zero_iff, hP_pos ];
      · exact fun x => Finset.prod_nonneg fun i _ => Finset.sum_nonneg fun _ _ => le_of_lt ( hP_pos _ );
      · -- By definition of marginal, we know that $\sum_{x} \prod_{i} \text{marginal}(P_i)(x_i) = 1$.
        have h_marginal_sum : ∀ i, ∑ x : Bool, marginal P i x = 1 := by
          intro i
          have h_marginal_sum : ∑ x : Bool, marginal P i x = ∑ x : Fin n → Bool, P x := by
            unfold marginal; simp +decide [ Finset.sum_filter ] ;
            simpa only [ ← Finset.sum_add_distrib ] using Finset.sum_congr rfl fun x _ => by cases x i <;> simp +decide [ * ] ;
          rw [h_marginal_sum]
          exact hP.2;
        have h_prod_sum : ∑ x : Fin n → Bool, ∏ i, marginal P i (x i) = ∏ i, ∑ x : Bool, marginal P i x := by
          exact?;
        aesop;
    · intro x; exact Finset.prod_pos fun i _ => lt_of_lt_of_le ( hP_pos ( fun j => if j = i then x i else if x j then Bool.true else Bool.false ) ) ( Finset.single_le_sum ( fun a _ => le_of_lt ( hP_pos a ) ) ( by aesop ) ) ;
  unfold combined_detection independent_detection mutual_information;
  unfold product_of_marginals; norm_num [ Finset.sum_filter ] at *; linarith! [ abs_le.mp ‹_› ] ;

variable {D R : Type}

def distinctKillSets (sem : Program D R → D → R) (oracle : Test D R → R → Bool) (MS : MutationSystem D R) (P : Program D R) (T : TestSuite D R) : Finset (Finset (Program D R)) :=
  (T.image (fun t => killedSet sem oracle MS P {t})).filter (fun s => s.Nonempty)

def IsGreedySequence (sem : Program D R → D → R) (oracle : Test D R → R → Bool) (MS : MutationSystem D R) (P : Program D R) (T_univ : TestSuite D R) (seq : ℕ → Test D R) : Prop :=
  ∀ k, seq k ∈ T_univ ∧
  ∀ t ∈ T_univ, (killedSet sem oracle MS P {t} \ (Finset.range k).biUnion (fun i => killedSet sem oracle MS P {seq i})).card ≤
                (killedSet sem oracle MS P {seq k} \ (Finset.range k).biUnion (fun i => killedSet sem oracle MS P {seq i})).card

def covered (sem : Program D R → D → R) (oracle : Test D R → R → Bool) (MS : MutationSystem D R) (P : Program D R) (seq : ℕ → Test D R) (k : ℕ) : Finset (Program D R) :=
  (Finset.range k).biUnion (fun i => killedSet sem oracle MS P {seq i})

def total_killable (sem : Program D R → D → R) (oracle : Test D R → R → Bool) (MS : MutationSystem D R) (P : Program D R) (T_univ : TestSuite D R) : Finset (Program D R) :=
  killedSet sem oracle MS P T_univ

def SC (sem : Program D R → D → R) (oracle : Test D R → R → Bool) (MS : MutationSystem D R) (P : Program D R) (T_univ : TestSuite D R) (seq : ℕ → Test D R) (k : ℕ) : ℚ :=
  (covered sem oracle MS P seq k).card / (total_killable sem oracle MS P T_univ).card

/-
Lemma F: At step k, the greedy choice kills at least as many uncovered mutants as any other test in T_univ.
-/
lemma T4_7_lemmaF_greedy_max_gain
    (sem : Program D R → D → R) (oracle : Test D R → R → Bool) (MS : MutationSystem D R) (P : Program D R) (T_univ : TestSuite D R) (seq : ℕ → Test D R)
    (h_greedy : IsGreedySequence sem oracle MS P T_univ seq) (k : ℕ) :
    ∀ t ∈ T_univ, (killedSet sem oracle MS P {t} \ covered sem oracle MS P seq k).card ≤
                  (killedSet sem oracle MS P {seq k} \ covered sem oracle MS P seq k).card := by
  have := h_greedy k; aesop;

/-
Lemma G: At step k, the greedy gain is at least |uncovered_k|/n.
-/
lemma T4_7_lemmaG_pigeonhole_gain
    (sem : Program D R → D → R) (oracle : Test D R → R → Bool) (MS : MutationSystem D R) (P : Program D R) (T_univ : TestSuite D R) (seq : ℕ → Test D R)
    (h_greedy : IsGreedySequence sem oracle MS P T_univ seq) (k : ℕ)
    (n : ℕ) (h_n : n = (distinctKillSets sem oracle MS P T_univ).card) (h_n_pos : 0 < n) :
    ((killedSet sem oracle MS P {seq k} \ covered sem oracle MS P seq k).card : ℚ) ≥
    ((total_killable sem oracle MS P T_univ \ covered sem oracle MS P seq k).card : ℚ) / n := by
  -- By the pigeonhole principle, there exists a test $t$ in $T_univ$ such that the number of new mutants killed by $t$ is at least the average number of new mutants killed by any test in $T_univ$.
  obtain ⟨t, ht⟩ : ∃ t ∈ T_univ, (killedSet sem oracle MS P {t} \ covered sem oracle MS P seq k).card ≥ (total_killable sem oracle MS P T_univ \ covered sem oracle MS P seq k).card / (n : ℚ) := by
    -- By the pigeonhole principle, there exists a test $t$ in $T_univ$ such that the number of new mutants killed by $t$ is at least the average number of new mutants killed by any test in $T_univ$. We can formalize this using the fact that the average of a set of numbers is less than or equal to the maximum of those numbers.
    have h_pigeonhole : ∃ t ∈ distinctKillSets sem oracle MS P T_univ, (t \ covered sem oracle MS P seq k).card ≥ (total_killable sem oracle MS P T_univ \ covered sem oracle MS P seq k).card / (n : ℚ) := by
      have h_pigeonhole : (Finset.sum (distinctKillSets sem oracle MS P T_univ) (fun s => (s \ covered sem oracle MS P seq k).card)) ≥ (total_killable sem oracle MS P T_univ \ covered sem oracle MS P seq k).card := by
        have h_pigeonhole : (total_killable sem oracle MS P T_univ \ covered sem oracle MS P seq k) ⊆ Finset.biUnion (distinctKillSets sem oracle MS P T_univ) (fun s => s \ covered sem oracle MS P seq k) := by
          intro m hm; simp_all +decide [ total_killable, covered ] ;
          simp_all +decide [ killedSet, distinctKillSets ];
          exact ⟨ _, ⟨ ⟨ hm.1.2.choose, hm.1.2.choose_spec.1, rfl ⟩, ⟨ m, by simpa using hm.1.2.choose_spec.2 |> fun h => by aesop ⟩ ⟩, by simpa using hm.1.2.choose_spec.2 |> fun h => by aesop ⟩;
        exact le_trans ( Finset.card_le_card h_pigeonhole ) ( Finset.card_biUnion_le );
      contrapose! h_pigeonhole; simp_all +decide [ Finset.sum_div _ _ _ ] ;
      rw [ ← @Nat.cast_lt ℚ ] ; simp_all +decide [ Finset.sum_div _ _ _ ] ; exact lt_of_lt_of_le ( Finset.sum_lt_sum_of_nonempty h_n_pos fun x hx => h_pigeonhole x hx ) ( by norm_num [ mul_div_cancel₀, h_n_pos.ne_empty ] ) ;
    obtain ⟨ t, ht₁, ht₂ ⟩ := h_pigeonhole; unfold distinctKillSets at ht₁; aesop;
  exact ht.2.trans ( mod_cast h_greedy k |>.2 t ht.1 )

/-
Lemma H: |uncovered_{k+1}| ≤ |uncovered_k| × (1 - 1/n).
-/
lemma T4_7_lemmaH_geometric_decay
    (sem : Program D R → D → R) (oracle : Test D R → R → Bool) (MS : MutationSystem D R) (P : Program D R) (T_univ : TestSuite D R) (seq : ℕ → Test D R)
    (h_greedy : IsGreedySequence sem oracle MS P T_univ seq) (k : ℕ)
    (n : ℕ) (h_n : n = (distinctKillSets sem oracle MS P T_univ).card) (h_n_pos : 0 < n) :
    ((total_killable sem oracle MS P T_univ \ covered sem oracle MS P seq (k + 1)).card : ℚ) ≤
    ((total_killable sem oracle MS P T_univ \ covered sem oracle MS P seq k).card : ℚ) * (1 - 1 / n) := by
  -- By definition of $covered$, we have $covered sem oracle MS P seq (k + 1) = covered sem oracle MS P seq k ∪ killedSet sem oracle MS P {seq k}$.
  have h_covered : covered sem oracle MS P seq (k + 1) = covered sem oracle MS P seq k ∪ killedSet sem oracle MS P {seq k} := by
    unfold covered; ext; simp +decide [ Finset.range_add_one ] ;
    grind +ring;
  -- By definition of $SC$, we have $SC k = \frac{|covered_k|}{|total_killable|}$.
  have h_SC : (total_killable sem oracle MS P T_univ \ covered sem oracle MS P seq (k + 1)) = (total_killable sem oracle MS P T_univ \ covered sem oracle MS P seq k) \ (killedSet sem oracle MS P {seq k} \ covered sem oracle MS P seq k) := by
    grind;
  -- By Lemma G, the gain at step k is ≥ |uncovered_k|/n.
  have h_gain : ((killedSet sem oracle MS P {seq k} \ covered sem oracle MS P seq k).card : ℚ) ≥ ((total_killable sem oracle MS P T_univ \ covered sem oracle MS P seq k).card : ℚ) / n := by
    exact?;
  rw [ h_SC, Finset.card_sdiff ];
  rw [ mul_sub, mul_one, Nat.cast_sub ];
  · gcongr;
    convert h_gain.le using 1 <;> norm_num [ mul_div ];
    · exact?;
    · congr! 1;
      ext; simp [killedSet, covered, total_killable];
      exact fun h₁ h₂ h₃ => ⟨ ⟨ h₁, seq k, h_greedy k |>.1, h₂ ⟩, h₃ ⟩;
  · exact Finset.card_le_card fun x hx => by aesop;

/-
The images of killed sets under inj1 and inj2 are disjoint.
-/
lemma T4_3_lemma_disjoint_images
    (sem : Program (D₁ × D₂) (R₁ × R₂) → (D₁ × D₂) → (R₁ × R₂))
    (sem₁ : Program D₁ R₁ → D₁ → R₁)
    (sem₂ : Program D₂ R₂ → D₂ → R₂)
    (oracle₁ : Test D₁ R₁ → R₁ → Bool)
    (oracle₂ : Test D₂ R₂ → R₂ → Bool)
    (MS₁ : MutationSystem D₁ R₁)
    (MS₂ : MutationSystem D₂ R₂)
    (P₁ : Program D₁ R₁)
    (P₂ : Program D₂ R₂)
    (T₁ : TestSuite D₁ R₁)
    (T₂ : TestSuite D₂ R₂)
    (h_sem_inj1 : ∀ m₁ x y, sem (inj1 m₁) (x, y) = (sem₁ m₁ x, sem₂ P₂ y))
    (h_sem_inj2 : ∀ m₂ x y, sem (inj2 m₂) (x, y) = (sem₁ P₁ x, sem₂ m₂ y)) :
    Disjoint (Finset.image inj1 (killedSet sem₁ oracle₁ MS₁ P₁ T₁)) (Finset.image inj2 (killedSet sem₂ oracle₂ MS₂ P₂ T₂)) := by
  simp +contextual [ Finset.disjoint_right, * ];
  intro m hm n hn hmn; simp_all +decide [ inj1, inj2 ] ;
  unfold killedSet at *; simp_all +decide [ Finset.ext_iff ] ;
  obtain ⟨ t₁, ht₁, ht₁' ⟩ := hn.2; obtain ⟨ t₂, ht₂, ht₂' ⟩ := hm.2; simp_all +decide [ passes ] ;
  have := h_sem_inj1 n t₁.input t₂.input; have := h_sem_inj2 m t₁.input t₂.input; simp_all +decide [ Prod.ext_iff ] ;

/-
Greedy Synthesis Convergence Rate: covered_k.card ≥ total_killable.card × (1 - (1 - 1/n)^k).
-/
theorem T4_7_greedy_synthesis_convergence
    (sem : Program D R → D → R) (oracle : Test D R → R → Bool) (MS : MutationSystem D R) (P : Program D R) (T_univ : TestSuite D R) (seq : ℕ → Test D R)
    (h_greedy : IsGreedySequence sem oracle MS P T_univ seq)
    (n : ℕ) (h_n : n = (distinctKillSets sem oracle MS P T_univ).card) (h_n_pos : 0 < n) :
    ∀ k, ((covered sem oracle MS P seq k).card : ℝ) ≥ (total_killable sem oracle MS P T_univ).card * (1 - (1 - 1 / n) ^ k) := by
  -- Apply Lemma H: |uncovered_{k+1}| ≤ |uncovered_k| * (1-1/n).
  have h_uncovered : ∀ k, (total_killable sem oracle MS P T_univ \ covered sem oracle MS P seq (k + 1)).card ≤ (total_killable sem oracle MS P T_univ \ covered sem oracle MS P seq k).card * (1 - 1 / n : ℝ) := by
    intro k
    have h_uncovered : (total_killable sem oracle MS P T_univ \ covered sem oracle MS P seq (k + 1)).card ≤ (total_killable sem oracle MS P T_univ \ covered sem oracle MS P seq k).card * (1 - 1 / n : ℝ) := by
      have := T4_7_lemmaH_geometric_decay sem oracle MS P T_univ seq h_greedy k n h_n h_n_pos
      convert this using 1 ; norm_num [ Rat.divInt_eq_div ] ; ring;
      field_simp;
      norm_cast
    exact h_uncovered;
  have h_uncovered_induction : ∀ k, (total_killable sem oracle MS P T_univ \ covered sem oracle MS P seq k).card ≤ (total_killable sem oracle MS P T_univ).card * (1 - 1 / (n : ℝ)) ^ k := by
    intro k
    induction' k with k ih;
    · norm_num [ covered ];
    · simpa only [ pow_succ, mul_assoc ] using le_trans ( h_uncovered k ) ( mul_le_mul_of_nonneg_right ih ( sub_nonneg.2 <| div_le_self zero_le_one <| mod_cast h_n_pos ) );
  intro k; specialize h_uncovered_induction k; simp_all +decide [ mul_sub, sub_mul ] ;
  refine le_trans ?_ ( add_le_add_left h_uncovered_induction _ );
  norm_cast; rw [ ← Finset.card_union_of_disjoint ( Finset.disjoint_sdiff ) ] ; exact Finset.card_le_card fun x hx => by by_cases hx' : x ∈ covered sem oracle MS P seq k <;> aesop;

/-
Capstone Theorem: End-to-End Optimization Certification.
-/
theorem T4_capstone_certification
    (D R : Type)
    (sem : Program D R → D → R) (oracle : Test D R → R → Bool)
    (MS : MutationSystem D R) (P : Program D R) (T_univ : TestSuite D R)
    (seq : ℕ → Test D R)
    (h_greedy : IsGreedySequence sem oracle MS P T_univ seq)
    (n k : ℕ)
    (h_n : n = (distinctKillSets sem oracle MS P T_univ).card)
    (h_n_pos : 0 < n)
    (α : AlgebraResult) (μ : MutationState)
    (h_conf : 0 ≤ α.confidence ∧ α.confidence ≤ 1)
    (h_survival_low : μ.survival < 30/100)
    (achievedLevel : OracleLevel)
    (O : OptimizationType)
    (h_level : O.requiredLevel ≤ achievedLevel)
    (s : SynthState D R) :
    -- (a) Gate returns VERIFIED
    (crossChannelGate α μ).status = GateStatus.VERIFIED ∧
    -- (b) Gate is conservative
    (crossChannelGate α μ).confidence ≤ α.confidence ∧
    -- (c) Optimization is safe
    O.requiredLevel ≤ achievedLevel ∧
    -- (d) Survivors partition
    (KilledMutants sem oracle MS P s ∪
     EquivalentMutants sem MS P s ∪
     DistinguishableSurvivors sem MS P s =
     {m | m ∈ MS.mutants P}) ∧
    -- (e) Convergence rate
    ∀ j, SC sem oracle MS P T_univ seq j ≥ 1 - (1 - 1/(n:ℚ))^j := by
  refine' ⟨ _, _, h_level, _, _ ⟩;
  · unfold crossChannelGate; aesop;
  · unfold crossChannelGate; aesop;
  · exact T4_2_fixed_point_partition sem oracle MS P s |>.1;
  · intro j;
    convert T4_7_greedy_synthesis_convergence sem oracle MS P T_univ seq h_greedy n h_n h_n_pos j using 1;
    unfold SC; norm_num [ mul_comm ] ;
    by_cases h : ( total_killable sem oracle MS P T_univ |> Finset.card : ℚ ) = 0 <;> simp_all +decide [ sub_eq_iff_eq_add ];
    · simp_all +decide [ Finset.ext_iff, total_killable ];
      simp_all +decide [ Finset.Nonempty, distinctKillSets ];
      obtain ⟨ a, ha, x, hx ⟩ := h_n_pos; specialize h x; simp_all +decide [ killedSet ] ;
    · field_simp;
      rw [ div_add', le_div_iff₀ ] <;> norm_cast <;> norm_num [ h ];
      · constructor <;> intro <;> linarith;
      · exact Finset.nonempty_of_ne_empty h

/-
Decidability for Finite Domains: When D is finite and R has decidable equality, trueEquiv is decidable.
-/
instance T2_10_decidability_finite_domains {D R : Type} [Fintype D] [DecidableEq R] (sem : Program D R → D → R) (P m : Program D R) :
  Decidable (trueEquiv sem P m) := by
  unfold trueEquiv
  infer_instance