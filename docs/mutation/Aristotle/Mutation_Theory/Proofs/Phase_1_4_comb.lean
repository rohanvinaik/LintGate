inductive GateStatus
| VERIFIED | PENALIZED | GATED
deriving Repr, DecidableEq

structure MutationState where
  survival : ℚ

structure AlgebraResult where
  confidence : ℚ

structure GateResult where
  status : GateStatus
  confidence : ℚ

def crossChannelGate (α : AlgebraResult) (μ : MutationState) : GateResult :=
  if μ.survival < 30/100 then
    { status := .VERIFIED, confidence := min α.confidence (90/100) }
  else if μ.survival < 60/100 then
    { status := .PENALIZED, confidence := α.confidence * (50/100) }
  else
    { status := .GATED, confidence := α.confidence * (10/100) }

/-
Gate VERIFIED Implies Low Survival: If crossChannelGate α μ has status VERIFIED, then μ.survival < 0.30.
-/
theorem T1_10_gate_verified_implies_low_survival (α : AlgebraResult) (μ : MutationState) :
  (crossChannelGate α μ).status = GateStatus.VERIFIED → μ.survival < 30/100 := by
  unfold crossChannelGate; aesop;

/-
Gate Conservatism: (crossChannelGate α μ).confidence ≤ α.confidence, assuming 0 ≤ α.confidence ≤ 1.
-/
theorem T1_11_gate_conservatism (α : AlgebraResult) (μ : MutationState) (h_conf_nonneg : 0 ≤ α.confidence) (h_conf_le_one : α.confidence ≤ 1) :
  (crossChannelGate α μ).confidence ≤ α.confidence := by
  unfold crossChannelGate;
  split_ifs <;> norm_num [ h_conf_nonneg, h_conf_le_one ];
  · linarith;
  · linarith

/-
Gate Antitonicity in Survival: If μ₁.survival ≤ μ₂.survival then (crossChannelGate α μ₂).confidence ≤ (crossChannelGate α μ₁).confidence.
-/
theorem T1_12_gate_antitonicity (α : AlgebraResult) (μ₁ μ₂ : MutationState) (h_le : μ₁.survival ≤ μ₂.survival) (h_conf_nonneg : 0 ≤ α.confidence) (h_conf_le_one : α.confidence ≤ 1) :
  (crossChannelGate α μ₂).confidence ≤ (crossChannelGate α μ₁).confidence := by
  unfold crossChannelGate;
  split_ifs <;> norm_num at * <;> try linarith;
  · constructor <;> linarith;
  · constructor <;> linarith

