#!/usr/bin/env bash
set -euo pipefail

if [ -d "$HOME/.qlty/bin" ]; then
  export PATH="$HOME/.qlty/bin:$PATH"
fi

if [ "${LINTGATE_SKIP_PRE_PUSH:-0}" = "1" ]; then
  echo "[lintgate] skipping pre-push checks (LINTGATE_SKIP_PRE_PUSH=1)"
  exit 0
fi

GATE_ID="${LINTGATE_GATE_ID:-}"
while [ $# -gt 0 ]; do
  case "$1" in
    --gate-id)
      GATE_ID="$2"
      shift 2
      ;;
    --gate-id=*)
      GATE_ID="${1#--gate-id=}"
      shift
      ;;
    *)
      shift
      ;;
  esac
done

if [ "$GATE_ID" = "secrets" ]; then
  GATE_ID="security_lite"
fi

_should_run() {
  [ -z "$GATE_ID" ] || [ "$GATE_ID" = "$1" ]
}

_gate_note() {
  printf '[lintgate][gate:%s] %s\n' "$1" "$2"
}

_gate_start() {
  _gate_note "$1" "START"
}

_gate_pass() {
  _gate_note "$1" "PASS"
}

_gate_fail() {
  _gate_note "$1" "FAIL: $2"
}

_run_gate() {
  local gate_id="$1"
  shift
  _gate_start "$gate_id"
  if "$@"; then
    _gate_pass "$gate_id"
  else
    _gate_fail "$gate_id" "$* failed"
    exit 1
  fi
}

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT"

if [ -z "$GATE_ID" ]; then
  echo "[lintgate] running local quality checks before push"
else
  echo "[lintgate] running gate: $GATE_ID"
fi

if [ -z "$GATE_ID" ] && command -v python >/dev/null 2>&1; then
  MISSING_TOOLS="$(python -m lintgate.tool_manifest --check-required --project-root "$REPO_ROOT" 2>/dev/null || true)"
  if [ -n "$MISSING_TOOLS" ]; then
    echo "[lintgate] WARNING: missing required tools from toolchain manifest:"
    echo "$MISSING_TOOLS"
    echo "[lintgate] Run: python -m lintgate.tool_manifest --install --project-root $REPO_ROOT"
    echo "[lintgate] Or:  toolchain_health_check(path='$REPO_ROOT', install_missing=True)"
  fi
fi

if _should_run quality_infra; then
  _run_gate quality_infra env \
    LINTGATE_BRANCH_PROTECTION_FAIL_CLOSED=1 \
    bash scripts/ci/run_quality_infra_gate.sh
fi

if _should_run qlty; then
  _run_gate qlty bash scripts/ci/run_qlty_gate.sh
fi

if _should_run security_lite; then
  _run_gate security_lite bash scripts/ci/run_security_lite_gate.sh
fi

if _should_run tests_311; then
  _run_gate tests_311 env \
    LINTGATE_VERSIONED_ARTIFACTS=1 \
    bash scripts/ci/run_tests_gate.sh --python-version 3.11
fi

if _should_run tests_312; then
  _run_gate tests_312 env \
    LINTGATE_VERSIONED_ARTIFACTS=1 \
    bash scripts/ci/run_tests_gate.sh --python-version 3.12
fi

if _should_run sonar; then
  _run_gate sonar env \
    LINTGATE_REQUIRE_SONAR_TOKEN=1 \
    bash scripts/ci/run_sonar_gate.sh
fi

echo "[lintgate] pre-push checks passed"
