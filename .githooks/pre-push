#!/usr/bin/env bash
set -euo pipefail

# Ensure qlty is discoverable (installed to ~/.qlty/bin by default)
if [ -d "$HOME/.qlty/bin" ]; then
  export PATH="$HOME/.qlty/bin:$PATH"
fi

if [ "${LINTGATE_SKIP_PRE_PUSH:-0}" = "1" ]; then
  echo "[lintgate] skipping pre-push checks (LINTGATE_SKIP_PRE_PUSH=1)"
  exit 0
fi

# Gate selection: LINTGATE_GATE_ID env var OR --gate-id flag
# Valid gate IDs: quality_infra, qlty, secrets, tests, pip_audit, sonar
# Empty = run all gates (default).
GATE_ID="${LINTGATE_GATE_ID:-}"
while [ $# -gt 0 ]; do
  case "$1" in
    --gate-id) GATE_ID="$2"; shift 2 ;;
    --gate-id=*) GATE_ID="${1#--gate-id=}"; shift ;;
    *) shift ;;
  esac
done

_should_run() {
  # Run gate if no filter specified, or if gate matches the filter
  [ -z "$GATE_ID" ] || [ "$GATE_ID" = "$1" ]
}

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT"

# Source local secrets (.env is gitignored)
if [ -f "$REPO_ROOT/.env" ]; then
  # shellcheck disable=SC1091
  . "$REPO_ROOT/.env"
fi

if [ -z "$GATE_ID" ]; then
  echo "[lintgate] running local quality checks before push"
else
  echo "[lintgate] running gate: $GATE_ID"
fi

# Toolchain verification: check required tools before running gates.
# Reads from gate_contract.yaml manifest — self-managing source of truth.
if [ -z "$GATE_ID" ] && command -v python >/dev/null 2>&1; then
  MISSING_TOOLS="$(python -m lintgate.tool_manifest --check-required --project-root "$REPO_ROOT" 2>/dev/null || true)"
  if [ -n "$MISSING_TOOLS" ]; then
    echo "[lintgate] WARNING: missing required tools from toolchain manifest:"
    echo "$MISSING_TOOLS"
    echo "[lintgate] Run: python -m lintgate.tool_manifest --install --project-root $REPO_ROOT"
    echo "[lintgate] Or:  toolchain_health_check(path='$REPO_ROOT', install_missing=True)"
    # Non-blocking warning — tools may still work via alternate paths
  fi
fi

# Quality infrastructure gate (hard fail)
if _should_run quality_infra; then
  echo "[lintgate] checking quality infrastructure completeness"
  if LINTGATE_BRANCH_PROTECTION_FAIL_CLOSED=1 python -m lintgate.quality_infra --enforce "$REPO_ROOT" 2>/dev/null; then
    echo "[lintgate] quality infrastructure: complete"
  else
    echo "[lintgate] quality infrastructure: INCOMPLETE — run setup_github_quality to fix"
    exit 1
  fi
fi

# qlty analysis (mirrors CI qlty.yml — init parity + shellcheckrc safety)
if _should_run qlty; then
  # Handle .shellcheckrc symlink collision (qlty init may create .shellcheckrc symlink).
  if [ -f "$REPO_ROOT/.shellcheckrc" ] && [ ! -L "$REPO_ROOT/.shellcheckrc" ]; then
    cp "$REPO_ROOT/.shellcheckrc" "$REPO_ROOT/.shellcheckrc.bak"
  fi

  # Mirror CI init step: dry-run probe first, init fallback if needed.
  if ! qlty check --all --dry-run >/dev/null 2>&1; then
    qlty init --skip-plugins 2>/dev/null || true
  fi

  # Restore original .shellcheckrc when qlty init replaced it with a symlink.
  if [ -f "$REPO_ROOT/.shellcheckrc.bak" ] && [ -L "$REPO_ROOT/.shellcheckrc" ]; then
    rm "$REPO_ROOT/.shellcheckrc"
    mv "$REPO_ROOT/.shellcheckrc.bak" "$REPO_ROOT/.shellcheckrc"
  elif [ -f "$REPO_ROOT/.shellcheckrc.bak" ]; then
    rm "$REPO_ROOT/.shellcheckrc.bak"
  fi

  qlty check --all
fi

# Secrets scan (mirrors CI gitleaks check)
if _should_run secrets; then
  echo "[lintgate] scanning for secrets (gitleaks)"
  if ! gitleaks detect --source . --no-banner --redact; then
    echo "[lintgate] BLOCKED: secrets detected — fix before pushing."
    exit 1
  fi
fi

# Tests + coverage + symbol gate
if _should_run tests && { [ -d tests ] || [ -d test ]; }; then
  if [ -d tests ]; then TEST_DIR=tests; else TEST_DIR=test; fi
  echo "[lintgate] running tests with coverage + symbol gate"
  # Use free CPU capacity for parallel tests — never saturate the machine.
  # Reads 1-minute load average vs core count; claims half the idle headroom.
  NCPU=$(python -c "
import os
cores = os.cpu_count() or 1
try:
    load = os.getloadavg()[0]          # 1-min avg
except OSError:
    load = cores * 0.5                 # conservative fallback
idle = max(0, cores - load)
workers = max(1, int(idle * 0.5))      # claim half the free headroom
print(workers)
" 2>/dev/null || echo "1")
  XDIST_FLAG=""
  if python -c "import xdist" 2>/dev/null; then
    XDIST_FLAG="-n $NCPU --dist worksteal"
  fi
  # shellcheck disable=SC2086
  python -m pytest "$TEST_DIR" $XDIST_FLAG --cov --cov-config=.coveragerc \
    --cov-report=xml:coverage.xml --cov-report=json:coverage.json --cov-report=term:skip-covered \
    --tb=short -q

  BRANCH_NAME="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"

  # Base selection: use merge-base for ship branches (avoids HEAD~1 scope inflation
  # on repair/revert commits), HEAD~1 for normal branches.
  SHIP_BASE_STRATEGY="head~1"
  if [ -f "$REPO_ROOT/gate_contract.yaml" ] && command -v python >/dev/null 2>&1; then
    SHIP_BASE_STRATEGY="$(python -c "
import yaml
try:
    c = yaml.safe_load(open('$REPO_ROOT/gate_contract.yaml'))
    print(c.get('symbol_gate', {}).get('ship_base_strategy', 'head~1'))
except Exception:
    print('head~1')
" 2>/dev/null || echo 'head~1')"
  fi

  BASE='HEAD~1'
  if [[ "$BRANCH_NAME" == codex/ship-* ]] && [ "$SHIP_BASE_STRATEGY" = "merge-base" ]; then
    MERGE_BASE="$(git merge-base origin/main HEAD 2>/dev/null || echo '')"
    if [ -n "$MERGE_BASE" ]; then
      BASE="$MERGE_BASE"
      echo "[lintgate] using merge-base for ship branch (strategy: $SHIP_BASE_STRATEGY)"
    fi
  fi

  if ! git rev-parse --verify "$BASE" >/dev/null 2>&1; then
    BASE=''
  fi
  SYMBOL_GATE_STATUS=0
  set +e
  if [ -n "$BASE" ]; then
    python -m lintgate.symbol_gate_runner \
      --project-root "$REPO_ROOT" \
      --coverage-json coverage.json \
      --base "$BASE" --head HEAD --surface ci
  else
    python -m lintgate.symbol_gate_runner \
      --project-root "$REPO_ROOT" \
      --coverage-json coverage.json \
      --head HEAD --surface ci
  fi
  SYMBOL_GATE_STATUS=$?
  set -e

  if [ "$SYMBOL_GATE_STATUS" -ne 0 ]; then
    # Read advisory policy from gate_contract.yaml (single source of truth).
    # Falls back to hardcoded defaults if contract is missing or unreadable.
    ADVISORY=0
    if [ -f "$REPO_ROOT/gate_contract.yaml" ] && command -v python >/dev/null 2>&1; then
      ADVISORY="$(python -c "
import yaml, fnmatch
try:
    c = yaml.safe_load(open('$REPO_ROOT/gate_contract.yaml'))
    patterns = c.get('symbol_gate', {}).get('advisory_policy', {}).get('advisory_branches', ['main'])
    branch = '$BRANCH_NAME'
    print(1 if any(fnmatch.fnmatch(branch, p) for p in patterns) else 0)
except Exception:
    print(0)
" 2>/dev/null || echo 0)"
    fi

    if [ "$ADVISORY" = "1" ]; then
      echo "[lintgate] symbol gate advisory for branch '$BRANCH_NAME' (non-blocking per gate_contract.yaml)"
    else
      exit "$SYMBOL_GATE_STATUS"
    fi
  fi
fi

# pip-audit (mirrors CI security-lite.yml)
if _should_run pip_audit && command -v pip-audit >/dev/null 2>&1; then
  if [ -f requirements.txt ] || [ -f requirements-dev.txt ] || [ -f pyproject.toml ]; then
    echo "[lintgate] running pip-audit (supply-chain scan)"
    pip-audit
  fi
fi

# Sonar local mode from contract (default: ci_only).
# ci_only prevents stale-read split-brain; CI check-runs are authoritative.
if _should_run sonar; then
  SONAR_LOCAL_MODE="${SONAR_LOCAL_MODE:-ci_only}"
  if [ -f "$REPO_ROOT/gate_contract.yaml" ] && command -v python >/dev/null 2>&1; then
    _CONTRACT_MODE="$(python -c "
import yaml
try:
    c = yaml.safe_load(open('$REPO_ROOT/gate_contract.yaml'))
    print(c.get('tools', {}).get('sonar', {}).get('local_mode', 'ci_only'))
except Exception:
    print('ci_only')
" 2>/dev/null || echo 'ci_only')"
    SONAR_LOCAL_MODE="${_CONTRACT_MODE}"
  fi

  if [ "$SONAR_LOCAL_MODE" = "ci_only" ]; then
    echo "[lintgate] Sonar local mode: ci_only (CI SonarCloud check-run is authoritative)"
  else
    if [ -z "${SONAR_TOKEN:-}" ] || [ -z "${SONAR_PROJECT_KEY:-}" ]; then
      echo "[lintgate] BLOCKED: SONAR_TOKEN or SONAR_PROJECT_KEY is not set."
      exit 1
    fi

    echo "[lintgate] checking Sonar quality gate for ${SONAR_PROJECT_KEY} (mode: api_read)"
    SONAR_HOST="${SONAR_HOST_URL:-https://sonarcloud.io}"
    if command -v curl >/dev/null 2>&1; then
      if SONAR_RESPONSE="$(curl -fsS -u "${SONAR_TOKEN}:" "${SONAR_HOST%/}/api/qualitygates/project_status?projectKey=${SONAR_PROJECT_KEY}" 2>/dev/null)"; then  # gitleaks:allow
        SONAR_STATUS="$(printf %s "$SONAR_RESPONSE" | python -c 'import json,sys; print(json.load(sys.stdin).get(\"projectStatus\",{}).get(\"status\",\"\"))' 2>/dev/null || true)"
        if [ -n "$SONAR_STATUS" ] && [ "$SONAR_STATUS" != "OK" ]; then
          echo "[lintgate] BLOCKED: Sonar quality gate is ${SONAR_STATUS} (cached remote state)."
          exit 1
        fi
      else
        echo "[lintgate] BLOCKED: could not query Sonar quality gate."
        exit 1
      fi
    else
      echo "[lintgate] BLOCKED: curl is not installed - required for Sonar gate."
      exit 1
    fi
  fi
fi

echo "[lintgate] pre-push checks passed"
